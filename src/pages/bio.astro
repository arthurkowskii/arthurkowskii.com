---
import { getEntryBySlug } from 'astro:content';
import BioBento from '../components/BioBento.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import atomConfig from '../atom.config.js';
import { getCurrentLocale, getMeta, getPageTitle } from '../utils/i18n.js';

// Get current locale (server-side detection from URL)
const url = Astro.url;
const urlLang = url.searchParams.get('lang');
const currentLocale = urlLang && ['fr', 'en'].includes(urlLang) ? urlLang : 'fr';

const entry = await getEntryBySlug('bio', 'about');
const data = entry?.data || {};

// Localized meta tag setup using i18n
const siteUrl = import.meta.env.SITE || atomConfig.socialMeta.siteUrl;
const currentUrl = `${siteUrl}/bio`;
const ogImage = `${siteUrl}${atomConfig.socialMeta.bio.image}`;

// Get localized meta data
const localizedMeta = atomConfig.i18n?.meta?.[currentLocale] || atomConfig.i18n?.meta?.fr || {};
const bioTitle = localizedMeta.bio?.title || data.title || atomConfig.socialMeta.bio.title;
const bioDescription = localizedMeta.bio?.description || (data.bio ? (data.bio.length > 160 ? data.bio.slice(0, 160) + '...' : data.bio) : atomConfig.socialMeta.bio.description);
const siteName = localizedMeta.siteName || atomConfig.socialMeta.siteName;
---

<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    
    <!-- Enhanced Content Security Policy with YouTube and SoundCloud support -->
    <meta http-equiv="Content-Security-Policy" content="
      default-src 'self';
      script-src 'self' 'unsafe-inline' https://*.youtube.com https://*.soundcloud.com;
      style-src 'self' 'unsafe-inline' https://*.youtube.com https://*.soundcloud.com;
      img-src 'self' data: https: blob: https://*.arthurkowskii.com https://*.youtube.com https://*.ytimg.com https://*.googlevideo.com https://*.soundcloud.com https://*.sndcdn.com;
      media-src 'self' data: blob: https://*.arthurkowskii.com https://*.youtube.com https://*.googlevideo.com https://*.soundcloud.com https://*.sndcdn.com;
      font-src 'self' data: https://fonts.gstatic.com;
      connect-src 'self' https://*.youtube.com https://*.googlevideo.com https://*.soundcloud.com;
      child-src 'none';
      frame-src 'self' https://www.youtube.com/embed https://www.youtube-nocookie.com/embed https://player.vimeo.com https://open.spotify.com https://w.soundcloud.com;
      object-src 'none';
      base-uri 'self';
      form-action 'none';
      upgrade-insecure-requests;
    ">
    
    <title>{bioTitle}</title>
    <meta name="description" content={bioDescription} />
    <meta name="author" content={socialConfig.author} />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={bioTitle} />
    <meta property="og:description" content={bioDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={socialConfig.bio.imageAlt} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={currentLocale === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="profile:first_name" content="Arthur" />
    <meta property="profile:last_name" content="Kowskii" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content={socialConfig.twitter.cardType} />
    <meta name="twitter:site" content={socialConfig.twitter.handle} />
    <meta name="twitter:creator" content={socialConfig.twitter.handle} />
    <meta name="twitter:title" content={bioTitle} />
    <meta name="twitter:description" content={bioDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={socialConfig.bio.imageAlt} />
    
    <!-- Additional SEO Meta Tags -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <link rel="canonical" href={currentUrl} />
    
    <!-- Enhanced SEO Meta Tags -->
    <meta name="theme-color" content="#3b82f6" />
    <meta name="msapplication-navbutton-color" content="#3b82f6" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    
    <!-- Structured Data for Person Profile -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": data.title || socialConfig.author,
      "jobTitle": data.subtitle || 'Composer / Sound Designer / Audio Programmer',
      "description": bioDescription,
      "url": currentUrl,
      "image": ogImage,
      "sameAs": (data.social || [])
        .filter(s => s.url && (s.platform.toLowerCase().includes('soundcloud') || 
                             s.platform.toLowerCase().includes('github') || 
                             s.platform.toLowerCase().includes('linkedin')))
        .map(s => s.url),
      "knowsAbout": (data.skills || []).map(skill => skill.category).join(', ') || 'Music Production, Sound Design, Audio Programming',
      "email": data.email || ''
    })}>
    </script>
    
    <style>
      :root { --bg:#fff; --fg:#000; }
      * { box-sizing: border-box; }
      body { margin:0; background:#fff; color:#000; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, system-ui, sans-serif; }
      a { color: inherit; text-decoration: none; }

      /* Professional dark theme base for bio page */
      html[data-theme="dark"] body { 
        background: #0f0f0f; 
        color: #e4e4e7; 
      }
    </style>
    <!-- Theme init (before paint) -->
    <script>
      (function(){
        try {
          const saved = localStorage.getItem('theme');
          const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch {}
      })();
    </script>
  </head>
  <body>
    <LanguageSwitcher />
    <BioBento data={data} currentLocale={currentLocale} />
    
    <script>
      // Initialize i18n system
      import { initI18n } from '../utils/i18n.js';
      initI18n();
    </script>
  </body>
  </html>
