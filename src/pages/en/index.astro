				--card-start-scale: ${userTweaks.prePage?.animations?.cardStartScale || 0.3};
				--card-start-rotation: ${userTweaks.prePage?.animations?.cardStartRotation || -5}deg;
				--card-start-y: ${userTweaks.prePage?.animations?.cardStartY || 100}px;
			`}>
			<div class="welcome-container">
				<div class="welcome-card" tabindex="-1">
					<!-- Language Selection -->
					<div class="language-selection" id="welcome-language-selection">
						<span class="language-label" id="language-label">Choisir la langue</span>
						<div class="language-buttons">
							<button class="lang-btn active" data-lang="fr" aria-pressed="true" aria-label="Français">
								<img src="/images/france.png" alt="France" class="flag-icon">
								<span class="lang-text">FR</span>
