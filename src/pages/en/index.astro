                  scale: multiStage.preExpandScale || 0.8,
                  opacity: multiStage.preExpandOpacity || 0.9,
                  x: 0, // Final position (no offset)
                  y: 0,
                  duration: cfg.electronPreview.animationDuration * (multiStage.stage2Duration || 0.4),
                  ease: 'power2.inOut'
