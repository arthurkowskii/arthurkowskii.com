		<script>
import { gsap, Draggable } from 'gsap/all';
import { OrbitSystem } from '../../atom/core/OrbitSystem.js';
import atomConfig from '../../atom.config.js';
			
			// Initialize orbit system when DOM is ready
			document.addEventListener('DOMContentLoaded', () => {
				// console.log('Initializing Atom Portfolio...');
				// console.log('GSAP version:', gsap.version);
				
				// Minimum distance system is working correctly!
				
				// Read dynamic config generated server-side (fallback to atomConfig)
				const cfgDataNode = document.getElementById('cfg-data');
				let cfg = null;
				try { cfg = cfgDataNode ? JSON.parse(cfgDataNode.textContent) : null; } catch {}
				if (!cfg) cfg = atomConfig;

				// Set CSS custom properties for electron preview on page load
				if (cfg.electronPreview) {
					const root = document.documentElement;
					root.style.setProperty('--preview-width', cfg.electronPreview.width + 'px');
					root.style.setProperty('--preview-height', cfg.electronPreview.height + 'px');
					root.style.setProperty('--preview-border-radius', cfg.electronPreview.borderRadius + 'px');
					root.style.setProperty('--preview-content-padding', cfg.electronPreview.contentPadding + 'px');
					root.style.setProperty('--preview-hero-size', cfg.electronPreview.heroSize + 'px');
					root.style.setProperty('--preview-hero-radius', cfg.electronPreview.heroRadius + 'px');
					root.style.setProperty('--preview-hero-margin', cfg.electronPreview.heroMargin + 'px');
					root.style.setProperty('--preview-title-size', cfg.electronPreview.titleSize + 'px');
					root.style.setProperty('--preview-subtitle-size', cfg.electronPreview.subtitleSize + 'px');
					
					// Calculate available width for text content
					const actualHeroSize = Math.min(cfg.electronPreview.heroSize, cfg.electronPreview.height - 2 * cfg.electronPreview.heroMargin);
					const textMaxWidth = cfg.electronPreview.width - actualHeroSize - 2 * cfg.electronPreview.heroMargin - 2 * cfg.electronPreview.contentPadding;
					root.style.setProperty('--preview-content-max-width', Math.max(textMaxWidth, 100) + 'px'); // Minimum 100px
				}

                // Create orbit system but don't initialize immediately - wait for welcome overlay logic
                const orbitSystem = new OrbitSystem(cfg);
				
                // Store reference globally immediately for event handlers
                window.orbitSystem = orbitSystem;

                  // Welcome overlay gating (same-document) - handles orbit initialization
                  (function setupWelcomeOverlay(){
                    try {
                      const preEnabled = (cfg?.prePage?.enabled ?? true) !== false;
                      const key = (cfg?.prePage?.storageKey) || 'entered';
                      const overlay = document.getElementById('welcome-overlay');
                      const btn = document.getElementById('enter-btn-inline');
                      const entered = (() => { try { return sessionStorage.getItem(key); } catch { return null; } })();
                      const debugMode = cfg?.prePage?.animations?.debugMode ?? false;
                      const forceAnimations = cfg?.prePage?.animations?.forceAnimations ?? false;
                      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                      
                      
                      if (debugMode) {
                        console.log('🎬 [Welcome Debug] Animation setup:', {
                          preEnabled, 
                          entered, 
                          hasOverlay: !!overlay,
                          forceAnimations,
                          prefersReduced,
                          overlayClasses: overlay?.className,
                          cssVars: {
                            overlayDuration: overlay?.style.getPropertyValue('--overlay-duration'),
                            cardDuration: overlay?.style.getPropertyValue('--card-duration'),
                            cardStartScale: overlay?.style.getPropertyValue('--card-start-scale')
                          }
                        });
                      }

                      function prewarmAudio() {
                        try {
                          const Ctx = window.AudioContext || window.webkitAudioContext;
                          if (!Ctx) return;
                          const ctx = new Ctx();
                          const resume = ctx.resume?.bind(ctx);
                          if (ctx.state === 'suspended' && resume) resume();
                          const buffer = ctx.createBuffer(1, 1, 22050);
                          const src = ctx.createBufferSource();
                          src.buffer = buffer; src.connect(ctx.destination); src.start(0);
                          try { ctx.close?.(); } catch {}
                        } catch {}
                      }

                      if (preEnabled && overlay && !entered) {
                        if (debugMode) {
                          console.log('🎬 [Welcome Debug] Starting fade-in animation sequence...');
                        }
                        
                        // DO NOT initialize orbit system yet - wait until Enter is clicked
                        
                        // Show overlay with smooth fade-in animation
                        // Use requestAnimationFrame to ensure CSS transition triggers properly
                        requestAnimationFrame(() => {
                          overlay.classList.add('visible');
                          
                          if (debugMode) {
                            console.log('🎬 [Welcome Debug] Added "visible" class to overlay');
                            console.log('🎬 [Welcome Debug] Overlay computed styles:', {
                              opacity: getComputedStyle(overlay).opacity,
                              visibility: getComputedStyle(overlay).visibility,
                              transition: getComputedStyle(overlay).transition
                            });
                          }
                          
                          // Focus management for accessibility (after animation starts)
                          const focusDelay = (cfg?.prePage?.animations?.focusDelay || 2) * 1000;
                          if (debugMode) {
                            console.log(`🎬 [Welcome Debug] Focus will trigger in ${focusDelay}ms`);
                          }
                          
                          setTimeout(() => {
                            const welcomeCard = overlay.querySelector('.welcome-card');
                            if (welcomeCard) {
                              welcomeCard.focus();
                              if (debugMode) {
                                console.log('🎬 [Welcome Debug] Focus applied to welcome card');
                              }
                            }
                          }, focusDelay);
                        });
                        
                        btn?.addEventListener('click', async () => {
                          try { sessionStorage.setItem(key, '1'); } catch {}
                          
                          if (debugMode) {
                            console.log('🎬 [Welcome Debug] Starting fade-out animation sequence...');
                          }
                          
                          // Start fade-out animation immediately
                          overlay.classList.remove('visible');
                          
                          // Trigger atom scale-up animation
                          document.body.classList.add('entering');
                          
                          // Initialize and start orbits immediately so electrons spin during atom appearance
                          try { 
                            orbitSystem.init();
                            if (!window.orbitSystem?.isRunning) {
                              window.orbitSystem?.start();
                            }
                            // Update visited indicators after orbit system is ready
                            window.updateVisitedIndicators();
                            if (debugMode) {
                              console.log('🎬 [Welcome Debug] Orbit system initialized and started immediately with atom appearance');
                            }
                          } catch {}
                          
                          if (debugMode) {
                            console.log('🎬 [Welcome Debug] Removed "visible" class from overlay, started atom scale-up and orbital motion');
                          }
                          
                          // Prewarm audio during fade-out (non-blocking)
                          prewarmAudio();
                          
                          // Clean up DOM and finalize state after fade-out completes
                          const fadeOutDuration = (cfg?.prePage?.animations?.overlayFadeDuration || 2) * 1000;
                          if (debugMode) {
                            console.log(`🎬 [Welcome Debug] DOM cleanup will occur in ${fadeOutDuration}ms`);
                          }
                          
                          setTimeout(() => {
                            try { 
                              // Replace entering class with permanent show-atom class
                              document.body.classList.remove('entering');
                              document.body.classList.add('show-atom');
                              
                              // Remove welcome overlay from DOM completely to prevent interference with preview positioning
                              if (overlay && overlay.parentNode) {
                                overlay.parentNode.removeChild(overlay);
                                if (debugMode) {
                                  console.log('🎬 [Welcome Debug] Welcome overlay removed from DOM, final state applied');
                                }
                              }
                            } catch {}
                          }, fadeOutDuration);
                          
                        }, { once: true });
                        
                        // Enhanced keyboard support
                        document.addEventListener('keydown', function handleEnterKey(e) {
                          if (overlay.classList.contains('visible')) {
                            if (e.key === 'Enter' || e.key === ' ') {
                              e.preventDefault();
                              btn?.click();
                              document.removeEventListener('keydown', handleEnterKey);
                            }
                            // Trap focus within modal
                            if (e.key === 'Tab') {
                              e.preventDefault();
                              btn?.focus();
                            }
                            // Close on Escape (though not typical for welcome screens)
                            if (e.key === 'Escape') {
                              // For now, just move focus back to button
                              btn?.focus();
                            }
                          }
                        });
                      } else {
                        // No overlay → initialize and start orbits immediately
                        try { 
                          orbitSystem.init();
                          if (!window.orbitSystem?.isRunning) window.orbitSystem?.start();
                          // Update visited indicators after orbit system is ready
                          updateVisitedIndicators();
                        } catch {}
                      }
                    } catch {}
                  })();

				// Atom sound system disabled (stubbed out for future reimplementation)

            // Labels rotation setup
				const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				let labelTweens = [];
				const labelTweenByShell = new Map();
				(function initLabelRotation(){
            				  try {
            				    if (!atomConfig.labels?.enabled) return;
            				    // Respect reduced motion only if labels.rotate.respectReducedMotion is true
            				    if (prefersReduced && (atomConfig.labels?.rotate?.respectReducedMotion === true)) return;
				    if (!atomConfig.labels?.rotate?.enabled) return;
                const mode = atomConfig.labels?.mode || 'ring';
                const rotors = document.querySelectorAll('.shell-label-rotor');
                let created = 0;
                rotors.forEach((rotor) => {
                  const shellIndex = parseInt(rotor.getAttribute('data-shell-index') || '0');
                  const dir = cfg.shells[shellIndex]?.direction ?? 1;
                  const speed = atomConfig.labels.rotate.speedsByShell?.[shellIndex] ?? 100; // seconds per revolution
                  let tween = null;
                  if (mode === 'ring') {
                    tween = gsap.to(rotor, {
                      rotation: `+=${360 * dir}`,
                      duration: speed,
                      ease: 'none',
                      repeat: -1,
                      svgOrigin: `${cfg.viewport.centerX} ${cfg.viewport.centerY}`
                    });
                  } else if (mode === 'orbiting') {
                    // orbiting mode: animate startOffset of the textPath along full circle
                    const tp = rotor.querySelector('textPath');
                    if (!tp) return;
                    const start = 0;
                    const end = dir >= 0 ? 100 : -100;
                    const state = { p: start };
                    tween = gsap.to(state, {
                      p: end,
                      duration: speed,
                      ease: 'none',
                      repeat: -1,
                      onUpdate: () => {
                        const v = ((state.p % 100) + 100) % 100;
                        tp.setAttribute('startOffset', v + '%');
                      }
                    });
                  } else if (mode === 'ringPattern') {
                    // Static pattern: no tween
                    tween = null;
                  }
                  if (tween) {
                    labelTweens.push(tween);
                    labelTweenByShell.set(shellIndex, tween);
                    created++;
                  }
