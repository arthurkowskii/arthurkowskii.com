		<!-- Mobile Development Message -->
		<div id="mobile-dev-message" class="mobile-dev-overlay" role="dialog" aria-modal="true" aria-labelledby="mobile-title">
			<div class="mobile-dev-container">
				<div class="mobile-dev-card">
					<h2 id="mobile-title" class="mobile-dev-title">Version mobile en développement !</h2>
					<p class="mobile-dev-description">Ce même lien est parfaitement fonctionnel sur ordinateur.</p>
				</div>
			</div>
		</div>

        <!-- Welcome Language Selection Script -->
        <script type="module">
          // Welcome Language Selection Logic
          (function setupWelcomeLanguageSelection() {
            const overlay = document.getElementById('welcome-overlay');
            const langBtns = overlay?.querySelectorAll('.lang-btn');
            const langLabel = document.getElementById('language-label');
            const welcomeTitle = document.getElementById('enter-title');
            const welcomeDesc = document.getElementById('enter-desc');
            const welcomeButton = document.getElementById('enter-btn-inline');
            
            if (!langBtns || langBtns.length === 0 || !overlay) return;
            
            // Get browser preferred language
            const getBrowserLang = () => {
              const browserLang = navigator.language || navigator.languages?.[0];
              if (!browserLang) return 'fr';
              const langCode = browserLang.split('-')[0].toLowerCase();
              return ['fr', 'en'].includes(langCode) ? langCode : 'fr';
            };
            
            // Get content for language from global config
            const getContent = (lang) => {
              try {
                const cfg = JSON.parse(document.getElementById('cfg-data')?.textContent || '{}');
                const content = cfg?.prePage?.content?.[lang];
                if (content) return content;
              } catch (e) {
                console.warn('Could not load config data:', e);
              }
              
              // Fallback content
              return lang === 'en' ? {
                title: 'Welcome!',
                description: 'You are on Arthur Kowskii\'s portfolio. This site is still under construction, and new features are coming very soon!',
                buttonLabel: 'Enter Portfolio',
                languageLabel: 'Choose Language'
              } : {
                title: 'Bienvenue !',
                description: 'Vous êtes sur le portfolio d\'Arthur Kowskii. Ce site est encore en construction, et de nouvelles fonctionnalités sont prévues très bientôt !',
                buttonLabel: 'Entrer dans le Portfolio',
                languageLabel: 'Choisir la langue'
              };
            };
            
            // Update content for selected language with smooth transition
            const updateContent = (lang) => {
              const content = getContent(lang);
              
              // Add transition class for smooth content changes
              const card = overlay.querySelector('.welcome-card');
              if (card) card.style.transition = 'all 0.3s ease';
              
              if (langLabel) {
                langLabel.style.opacity = '0.5';
                setTimeout(() => {
                  langLabel.textContent = content.languageLabel;
                  langLabel.style.opacity = '1';
                }, 150);
              }
              
              if (welcomeTitle) {
                welcomeTitle.style.opacity = '0.5';
                setTimeout(() => {
                  welcomeTitle.textContent = content.title;
                  welcomeTitle.style.opacity = '1';
                }, 150);
              }
              
              if (welcomeDesc) {
                welcomeDesc.style.opacity = '0.5';
                setTimeout(() => {
                  welcomeDesc.textContent = content.description;
                  welcomeDesc.style.opacity = '1';
                }, 150);
              }
              
              if (welcomeButton) {
                welcomeButton.style.opacity = '0.5';
                setTimeout(() => {
                  welcomeButton.textContent = content.buttonLabel;
                  welcomeButton.style.opacity = '1';
                }, 150);
              }
              
              // Update document language
              document.documentElement.lang = lang;
              
              // Store selection for portfolio
              try {
                localStorage.setItem('portfolio-locale', lang);
              } catch (e) {
                console.warn('Could not save language preference:', e);
              }
            };
            
            // Initialize with browser language or saved preference
            let currentLang = 'fr';
            try {
              const savedLang = localStorage.getItem('portfolio-locale');
              currentLang = savedLang && ['fr', 'en'].includes(savedLang) ? savedLang : 'fr';
            } catch (e) {
              currentLang = 'fr';
            }
            
            // Set initial state
            updateContent(currentLang);
            
            // Update button states
            const updateButtonStates = (activeLang) => {
              langBtns.forEach(btn => {
                const isActive = btn.dataset.lang === activeLang;
                btn.classList.toggle('active', isActive);
                btn.setAttribute('aria-pressed', isActive.toString());
              });
            };
            
            updateButtonStates(currentLang);
            
            // Add click listeners with smooth animations
            langBtns.forEach(btn => {
              btn.addEventListener('click', (e) => {
                const targetLang = btn.dataset.lang;
                if (targetLang && targetLang !== currentLang) {
                  // Add click animation
                  btn.style.transform = 'scale(0.95)';
                  setTimeout(() => {
                    btn.style.transform = '';
                  }, 100);
                  
                  // For non-default language (English), reload page with URL parameter
                  // French is default, so no reload needed
                  if (targetLang === 'en') {
                    // Store selection and reload with URL parameter for server-side localization
                    try {
                      localStorage.setItem('portfolio-locale', targetLang);
                    } catch (e) {
                      console.warn('Could not save language preference:', e);
                    }
                    const url = new URL(window.location);
                    url.searchParams.set('lang', 'en');
                    window.location.href = url.toString();
                    return; // Don't continue with client-side updates
                  } else if (targetLang === 'fr') {
                    // For French (default), remove URL parameter if present and reload if needed
                    try {
                      localStorage.setItem('portfolio-locale', targetLang);
                    } catch (e) {
                      console.warn('Could not save language preference:', e);
                    }
                    const url = new URL(window.location);
                    if (url.searchParams.has('lang')) {
                      url.searchParams.delete('lang');
                      window.location.href = url.toString();
                      return;
                    }
                  }
                  
                  // For same-page updates (when no reload is needed)
                  currentLang = targetLang;
                  updateContent(currentLang);
                  updateButtonStates(currentLang);
                }
              });
            });
            
            // Add keyboard navigation
            langBtns.forEach((btn, index) => {
              btn.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
                  e.preventDefault();
                  const nextIndex = e.key === 'ArrowRight' 
                    ? (index + 1) % langBtns.length 
                    : (index - 1 + langBtns.length) % langBtns.length;
                  langBtns[nextIndex].focus();
                }
              });
            });
            
            console.log('🌐 Welcome language selection initialized with locale:', currentLang);
          })();
        </script>

        <!-- Client data payload for overlay -->
        <script type="application/json" id="project-data" set:html={JSON.stringify(projectSummaries)}></script>
        <script type="application/json" id="bio-data" set:html={JSON.stringify(bioPayload)}></script>
        <script type="application/json" id="logos-map" set:html={JSON.stringify(logosMap)}></script>
        <script type="application/json" id="cfg-data" set:html={JSON.stringify(cfg)}></script>

        <!-- Header functionality: theme toggle and project filters -->
        <script>
          (function(){
            // Visited projects tracking - make functions globally accessible
            // Store visited projects in memory only (resets on page refresh)
            window.visitedProjectsMemory = [];
            window.currentProjectSlug = null; // Track currently opened project
            
            window.getVisitedProjects = function() {
              try {
                return window.visitedProjectsMemory || [];
              } catch {
                return [];
              }
            }
            
            window.markProjectAsVisited = function(slug, withAnimation = true) {
              try {
                const visited = window.getVisitedProjects();
                const isNew = !visited.includes(slug);
                
                if (isNew) {
                  visited.push(slug);
                  window.visitedProjectsMemory = visited;
                }
                
                window.updateVisitedIndicators(isNew && withAnimation ? slug : null);
              } catch {}
            }
            
            window.updateVisitedIndicators = function(newIndicatorSlug = null) {
              const visited = window.getVisitedProjects();
              
              // Update all electrons and their indicators
              document.querySelectorAll('.electron:not(.nucleus)').forEach(electron => {
                const slug = electron.dataset.project;
                const indicator = document.querySelector(`.visited-indicator[data-project="${slug}"]`);
                
                if (visited.includes(slug)) {
                  electron.classList.add('visited');
                  if (indicator) {
                    // Show the indicator with sophisticated animation for new ones
                    if (slug === newIndicatorSlug && window.gsap) {
                      // Emergence animation for new indicators
                      indicator.style.display = 'block';
                      window.gsap.fromTo(indicator, 
                        {
                          scale: 0.3,
                          opacity: 0
                        },
                        {
                          scale: 1,
                          opacity: 1,
                          duration: 0.4,
                          ease: "back.out(1.7)",
                          delay: 0.1
                        }
                      );
                    } else {
                      indicator.style.display = 'block';
                    }
                    
                    // Apply filtering state if needed
                    window.updateIndicatorFiltering(indicator);
                  }
                } else {
                  electron.classList.remove('visited');
                  if (indicator) indicator.style.display = 'none';
                }
              });
            }
            
            // Update indicator filtering based on current filter state
            window.updateIndicatorFiltering = function(indicator) {
              if (!indicator || !window.currentFilter) return;
              
              const projectSlug = indicator.dataset.project;
              const project = window.projectBySlug?.get(projectSlug);
              
              if (window.currentFilter !== 'all' && project) {
                const projectDomain = project.domain || 'unknown';
                const selectedDomain = window.currentFilter.toLowerCase().replace(' ', '-');
                const isFiltered = projectDomain !== selectedDomain;
                
                if (isFiltered) {
                  indicator.classList.add('filtered');
                } else {
                  indicator.classList.remove('filtered');
                }
              } else {
                indicator.classList.remove('filtered');
              }
            }
            
            // Global function to update all indicator filtering states
            window.updateAllIndicatorFiltering = function() {
              document.querySelectorAll('.visited-indicator').forEach(indicator => {
                if (indicator.style.display !== 'none') {
                  window.updateIndicatorFiltering(indicator);
                }
              });
            }
            
            // Initialize visited indicators on page load
            window.updateVisitedIndicators();
            
            // Theme toggle functionality
            const themeSwitch = document.getElementById('theme-switch');
            const header = document.getElementById('main-header');
            
            function applyTheme(theme) {
              document.documentElement.setAttribute('data-theme', theme);
              if (themeSwitch) {
                themeSwitch.checked = (theme === 'dark');
              }
              try { localStorage.setItem('theme', theme); } catch {}
            }
            
            // Load saved theme or default to light
            const savedTheme = (() => {
              try { return localStorage.getItem('theme'); } catch { return null; }
            })();
            applyTheme(savedTheme || 'dark');
            
            // Theme toggle event listener
            themeSwitch?.addEventListener('change', () => {
              const newTheme = themeSwitch.checked ? 'dark' : 'light';
              applyTheme(newTheme);
            });
            
            // Project filter functionality (wait for DOM and config to be ready)
            function initializeFilters() {
              const filterBtns = document.querySelectorAll('.filter-btn');
              const electrons = document.querySelectorAll('.electron:not(.nucleus)');
              const shells = document.querySelectorAll('.shell');
              const shellLabels = document.querySelectorAll('.shell-label-rotor');
              
              // Get config data
              const cfg = (() => {
                try {
                  const cfgScript = document.getElementById('cfg-data');
                  return cfgScript ? JSON.parse(cfgScript.textContent) : null;
                } catch {
                  return null;
                }
              })();
              
              if (!cfg) {
                console.warn('Config not available, retrying in 100ms...');
                setTimeout(initializeFilters, 100);
                return;
              }
              
              function applyFilter(domain) {
                console.log('applyFilter called with:', domain); // Debug
                
                // Update global filter state
                currentFilter = domain;
                window.currentFilter = domain; // Make available globally
                
                // Update active button
                filterBtns.forEach(btn => btn.classList.remove('active'));
                const activeBtn = document.querySelector(`[data-filter="${domain}"]`);
                activeBtn?.classList.add('active');
                
                // Make active filter button bolder
                filterBtns.forEach(btn => {
                  if (btn === activeBtn) {
                    btn.style.fontWeight = '700'; // Bold
                  } else {
                    btn.style.fontWeight = '500'; // Normal
                  }
                });
                
                // Get domain index for shell filtering
                const domainIndex = domain === 'all' ? -1 : cfg.domains.indexOf(domain);
                console.log('Domain index:', domainIndex, 'Available domains:', cfg.domains); // Debug
                
                // Filter electrons with smooth transitions
                electrons.forEach(electron => {
                  const electronDomain = electron.dataset.domain;
                  if (domain === 'all' || electronDomain === domain) {
                    // Show electron (full opacity + enable hover)
                    if (typeof gsap !== 'undefined') {
                      gsap.to(electron, {
                        opacity: 1,
                        duration: 0.3,
                        ease: 'power2.out',
                        overwrite: 'auto'
                      });
                    } else {
                      electron.style.opacity = '1';
                    }
                    electron.style.pointerEvents = 'auto';
                  } else {
                    // Dim electron (low opacity + disable hover)
                    if (typeof gsap !== 'undefined') {
                      gsap.to(electron, {
                        opacity: 0.3,
                        duration: 0.3,
                        ease: 'power2.out',
                        overwrite: 'auto'
                      });
                    } else {
                      electron.style.opacity = '0.3';
                    }
                    electron.style.pointerEvents = 'none';
                  }
                });
                
                // Filter shells with smooth transitions
                shells.forEach((shell, index) => {
                  const shellConfig = cfg.shells[index];
                  if (domain === 'all') {
                    // All shells: reset to normal appearance
                    if (typeof gsap !== 'undefined') {
                      gsap.to(shell, {
                        opacity: shellConfig?.defaultOpacity || 0.3,
                        attr: { 'stroke-width': shellConfig?.strokeWidth || '4' },
                        duration: 0.3,
                        ease: 'power2.out',
                        overwrite: 'auto'
                      });
                    } else {
                      shell.style.opacity = shellConfig?.defaultOpacity || '0.3';
                      shell.setAttribute('stroke-width', shellConfig?.strokeWidth || '4');
                    }
                  } else if (index === domainIndex) {
                    // Selected shell: full opacity and bold stroke
                    if (typeof gsap !== 'undefined') {
                      gsap.to(shell, {
                        opacity: 1,
                        attr: { 'stroke-width': shellConfig?.hoverStrokeWidth || '5' },
                        duration: 0.3,
                        ease: 'power2.out',
                        overwrite: 'auto'
                      });
                    } else {
                      shell.style.opacity = '1';
                      shell.setAttribute('stroke-width', shellConfig?.hoverStrokeWidth || '5');
                    }
                  } else {
                    // Non-selected shells: very dim like labels (match label opacity)
                    if (typeof gsap !== 'undefined') {
                      gsap.to(shell, {
                        opacity: 0.15,
                        attr: { 'stroke-width': shellConfig?.strokeWidth || '4' },
                        duration: 0.3,
                        ease: 'power2.out',
                        overwrite: 'auto'
                      });
                    } else {
                      shell.style.opacity = '0.15';
                      shell.setAttribute('stroke-width', shellConfig?.strokeWidth || '4');
                    }
                  }
                });
                
                // Filter shell labels with smooth transitions
                shellLabels.forEach((labelRotor, index) => {
                  const labels = labelRotor.querySelectorAll('text');
                  if (domain === 'all') {
                    // All labels: reset to normal idle opacity
                    if (typeof gsap !== 'undefined') {
                      gsap.to(labels, {
                        opacity: 0.35,
                        duration: 0.3,
                        ease: 'power2.out',
                        overwrite: 'auto'
                      });
                    } else {
                      labels.forEach(label => label.style.opacity = '0.35');
                    }
                  } else if (index === domainIndex) {
                    // Selected labels: bright like hover state
                    if (typeof gsap !== 'undefined') {
                      gsap.to(labels, {
                        opacity: 0.7,
                        duration: 0.3,
                        ease: 'power2.out',
                        overwrite: 'auto'
                      });
                    } else {
                      labels.forEach(label => label.style.opacity = '0.7');
                    }
                  } else {
                    // Dim labels (very low opacity)
                    if (typeof gsap !== 'undefined') {
                      gsap.to(labels, {
                        opacity: 0.15,
                        duration: 0.3,
                        ease: 'power2.out',
                        overwrite: 'auto'
                      });
                    } else {
                      labels.forEach(label => label.style.opacity = '0.15');
                    }
                  }
                });
                
                // Update hover interactions based on filter
                updateHoverInteractions(domain);
                
                // Update visited indicator filtering states
                window.updateAllIndicatorFiltering && window.updateAllIndicatorFiltering();
              }
              
              function updateHoverInteractions(domain) {
                // Get all interactive elements
                const allElectrons = document.querySelectorAll('.electron:not(.nucleus)');
                const allShells = document.querySelectorAll('.shell');
                
                allElectrons.forEach(electron => {
                  const electronDomain = electron.dataset.domain;
                  const isVisible = (domain === 'all' || electronDomain === domain);
                  
                  electron.setAttribute('data-hover-enabled', isVisible ? 'true' : 'false');
                  
                  // Force reset any ongoing hover state for filtered electrons
                  if (!isVisible && hoverStateManager.currentElectron === electron) {
                    hoverStateManager.setState('none');
                  }
                });
                
                allShells.forEach((shell, shellIndex) => {
                  const shellDomain = cfg.domains[shellIndex];
                  const isVisible = (domain === 'all' || shellDomain === domain);
                  
                  shell.setAttribute('data-hover-enabled', isVisible ? 'true' : 'false');
                  
                  // Force reset shell hover state if it's filtered out
                  if (!isVisible && hoverStateManager.currentState === `shell-${shellIndex}`) {
                    hoverStateManager.setState('none');
                  }
                });
              }
              
              // Initialize all elements with hover enabled
              document.querySelectorAll('.electron:not(.nucleus)').forEach(el => {
                el.setAttribute('data-hover-enabled', 'true');
              });
              document.querySelectorAll('.shell').forEach(el => {
                el.setAttribute('data-hover-enabled', 'true');
              });
              
              // Filter button event listeners
              filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                  const domain = btn.dataset.filter;
                  
                  // Toggle functionality: if clicking the active button, go back to 'all'
                  if (btn.classList.contains('active') && domain !== 'all') {
                    applyFilter('all');
                  } else {
                    applyFilter(domain);
                  }
                });
              });
            }
            
            // Initialize filters after GSAP is loaded (moved to main script section)
            
            // Header auto-hide during overlay - DISABLED to keep theme toggle always visible
            // let overlayOpen = false;
            
            // // Watch for overlay state changes
            // const overlayObserver = new MutationObserver((mutations) => {
            //   mutations.forEach((mutation) => {
            //     if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
            //       const overlay = mutation.target;
            //       const isOpen = overlay.classList.contains('open');
            //       
            //       if (isOpen !== overlayOpen) {
            //         overlayOpen = isOpen;
            //         if (header) {
            //           header.classList.toggle('hidden', isOpen);
            //         }
            //       }
            //     }
            //   });
            // });
            
            // const projectOverlay = document.getElementById('project-overlay');
            // if (projectOverlay) {
            //   overlayObserver.observe(projectOverlay, { attributes: true });
            // }
          })();
        </script>

        <script>
          // Standalone theme toggle functionality
          (() => {
            document.addEventListener('DOMContentLoaded', function() {
              const standaloneToggle = document.getElementById('standalone-theme-switch');
              const standaloneLabel = document.getElementById('standalone-theme-label');
              
              if (!standaloneToggle || !standaloneLabel) return;
              
              // Check for saved theme preference or default to light mode
              const savedTheme = (() => {
                try { return localStorage.getItem('theme'); } catch { return null; }
              })();
              const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
              const initialTheme = savedTheme || 'dark';
              
              // Apply initial theme
              document.documentElement.setAttribute('data-theme', initialTheme);
              standaloneToggle.checked = initialTheme === 'dark';
              standaloneLabel.textContent = initialTheme === 'dark' ? 'Dark' : 'Light';
              
              // Handle theme toggle
              standaloneToggle.addEventListener('change', function() {
                const newTheme = this.checked ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', newTheme);
                try {
                  localStorage.setItem('theme', newTheme);
                } catch {}
                standaloneLabel.textContent = newTheme === 'dark' ? 'Dark' : 'Light';
                
                // Sync with header theme toggle if it exists
                const headerToggle = document.getElementById('theme-switch');
                const headerLabel = document.getElementById('theme-label');
                if (headerToggle) headerToggle.checked = this.checked;
                if (headerLabel) headerLabel.textContent = standaloneLabel.textContent;
                
                // Remove focus ring after click/tap to avoid persistent highlight
                try { this.blur(); } catch {}
              });
              
              // Sync with header toggle changes if they occur
              const headerToggle = document.getElementById('theme-switch');
              if (headerToggle) {
                headerToggle.addEventListener('change', function() {
                  standaloneToggle.checked = this.checked;
                  standaloneLabel.textContent = this.checked ? 'Dark' : 'Light';
                });
              }
            });
          })();
        </script>

