					<!-- Welcome Content -->
					<h2 id="enter-title" class="welcome-title">{userTweaks.prePage?.content?.fr?.title || userTweaks.prePage?.title || 'Bienvenue !'}</h2>
					<p id="enter-desc" class="welcome-description">{userTweaks.prePage?.content?.fr?.description || userTweaks.prePage?.description || 'Vous êtes sur le portfolio d\'Arthur Kowskii.'}</p>
					<button id="enter-btn-inline" class="welcome-button" aria-label="Enter Portfolio and enable audio">{userTweaks.prePage?.content?.fr?.buttonLabel || userTweaks.prePage?.buttonLabel || 'Entrer dans le Portfolio'}</button>
				</div>
			</div>
