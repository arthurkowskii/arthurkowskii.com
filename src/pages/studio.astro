---
const title = 'Studio V2';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --studio-ink: #171512;
        --studio-paper: rgba(246, 240, 230, 0.96);
        --studio-paper-strong: rgba(252, 248, 241, 0.99);
        --studio-line: rgba(23, 21, 18, 0.12);
        --studio-line-strong: rgba(255, 107, 0, 0.3);
        --studio-muted: #6d665d;
        --studio-accent: #ff6b00;
        --studio-accent-soft: rgba(255, 107, 0, 0.12);
        --studio-success: #1e8a52;
        --studio-danger: #b23f3f;
        --studio-shadow: 0 24px 70px rgba(28, 21, 14, 0.18);
      }

      * { box-sizing: border-box; }

      html,
      body {
        margin: 0;
        min-height: 100vh;
        overflow: hidden;
      }

      body {
        font-family: Georgia, "Times New Roman", serif;
        color: var(--studio-ink);
        background:
          radial-gradient(circle at top left, rgba(255, 107, 0, 0.12), transparent 24%),
          linear-gradient(180deg, #e8e1d5, #e2d8cb 46%, #ddd4c7);
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      button {
        cursor: pointer;
      }

      .studio-shell {
        position: relative;
        min-height: 100vh;
      }

      .workspace-stage {
        position: relative;
        min-height: 100vh;
      }

      .canvas-stage,
      .preview-stage {
        display: none;
        min-height: 100vh;
      }

      .canvas-stage.is-active,
      .preview-stage.is-active {
        display: block;
      }

      .preview-viewport {
        width: 100%;
        height: 100vh;
        min-height: 100vh;
        transition: width 180ms ease, margin 180ms ease, box-shadow 180ms ease, border-radius 180ms ease;
      }

      .preview-viewport[data-size="desktop"] {
        width: 100%;
        margin: 0;
        border-radius: 0;
        box-shadow: none;
      }

      .preview-viewport[data-size="tablet"] {
        width: min(920px, calc(100vw - 48px));
        height: calc(100vh - 48px);
        margin: 24px auto;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 28px 90px rgba(18, 15, 11, 0.18);
      }

      .preview-viewport[data-size="mobile"] {
        width: min(420px, calc(100vw - 28px));
        height: calc(100vh - 28px);
        margin: 14px auto;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 28px 90px rgba(18, 15, 11, 0.22);
      }

      .preview-frame {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
        background: #ffffff;
      }

      .status-toast {
        position: fixed;
        left: 20px;
        bottom: 20px;
        z-index: 120;
        max-width: min(420px, calc(100vw - 40px));
        padding: 12px 16px;
        border: 1px solid var(--studio-line);
        border-radius: 999px;
        background: rgba(14, 14, 16, 0.88);
        color: #f4efe6;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.24);
        backdrop-filter: blur(18px);
        font-size: 13px;
      }

      .status-toast.ok {
        border-color: rgba(30, 138, 82, 0.28);
        background: rgba(18, 46, 31, 0.88);
      }

      .status-toast.error {
        border-color: rgba(178, 63, 63, 0.32);
        background: rgba(65, 23, 23, 0.92);
      }

      .studio-corner {
        position: fixed;
        top: 18px;
        right: 18px;
        z-index: 140;
        display: grid;
        justify-items: end;
        gap: 10px;
      }

      .corner-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(14, 14, 16, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: rgba(244, 239, 230, 0.92);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
        backdrop-filter: blur(18px);
        font-size: 12px;
      }

      .corner-status::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: rgba(255, 107, 0, 0.95);
      }

      .corner-status[data-layout-active="true"]::before {
        background: rgba(30, 138, 82, 0.95);
      }

      .corner-toggle {
        width: 52px;
        height: 52px;
        border: 0;
        border-radius: 999px;
        background: rgba(14, 14, 16, 0.86);
        color: #f4efe6;
        box-shadow: 0 22px 60px rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(18px);
        font-size: 22px;
        line-height: 1;
      }

      .corner-toggle:hover,
      .corner-toggle[aria-expanded="true"] {
        background: rgba(20, 20, 24, 0.96);
      }

      .corner-panel {
        display: none;
        width: min(340px, calc(100vw - 28px));
        max-height: min(80vh, 760px);
        overflow: auto;
        padding: 16px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        background: rgba(14, 14, 16, 0.92);
        color: #f4efe6;
        box-shadow: 0 28px 90px rgba(0, 0, 0, 0.32);
        backdrop-filter: blur(24px);
      }

      .corner-panel.is-open {
        display: grid;
        gap: 16px;
      }

      .corner-panel h1,
      .corner-panel h2,
      .corner-panel h3,
      .corner-panel p {
        margin: 0;
      }

      .corner-panel h1 {
        font-size: 24px;
        line-height: 1;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(244, 239, 230, 0.64);
      }

      .eyebrow::before {
        content: "";
        width: 18px;
        height: 1px;
        background: linear-gradient(90deg, rgba(255, 107, 0, 0.9), transparent);
      }

      .doc-chip {
        display: inline-flex;
        max-width: 100%;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: rgba(244, 239, 230, 0.72);
        font-family: Consolas, "SFMono-Regular", monospace;
        font-size: 11px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .corner-panel__header {
        display: grid;
        gap: 8px;
      }

      .corner-panel__section {
        display: grid;
        gap: 10px;
        padding-top: 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }

      .corner-panel__section:first-of-type {
        padding-top: 0;
        border-top: 0;
      }

      .field {
        display: grid;
        gap: 8px;
        font-size: 12px;
        color: rgba(244, 239, 230, 0.72);
      }

      .field input,
      .field select,
      .field textarea {
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 12px 14px;
        background: rgba(255, 255, 255, 0.05);
        color: #f4efe6;
      }

      .field textarea {
        min-height: 120px;
        resize: vertical;
      }

      .field-grid {
        display: grid;
        gap: 12px;
      }

      .field-grid.two {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .stack {
        display: grid;
        gap: 14px;
      }

      .toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 10px 14px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.06);
        color: #f4efe6;
      }

      .button.primary {
        border-color: transparent;
        background: linear-gradient(180deg, #ff7a1a, #d85b00);
        color: #1b0d03;
        font-weight: 700;
      }

      .button.ghost {
        background: transparent;
      }

      .button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }

      .button-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }

      .segmented {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .segmented button {
        min-height: 38px;
        padding: 8px 14px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        color: #f4efe6;
      }

      .segmented button.is-active {
        border-color: rgba(255, 107, 0, 0.22);
        background: rgba(255, 107, 0, 0.16);
      }

      .sheet {
        position: fixed;
        inset: 0;
        z-index: 160;
        display: none;
      }

      .sheet.is-open {
        display: block;
      }

      .sheet__backdrop {
        position: absolute;
        inset: 0;
        background: rgba(17, 12, 8, 0.28);
        backdrop-filter: blur(8px);
      }

      .sheet__panel {
        position: absolute;
        top: 22px;
        right: 22px;
        bottom: 22px;
        width: min(520px, calc(100vw - 32px));
        overflow: auto;
        padding: 18px;
        border: 1px solid var(--studio-line);
        border-radius: 26px;
        background: var(--studio-paper);
        box-shadow: var(--studio-shadow);
      }

      .sheet__header {
        position: sticky;
        top: -18px;
        z-index: 2;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        padding: 18px 18px 14px;
        margin: -18px -18px 18px;
        border-bottom: 1px solid var(--studio-line);
        background: linear-gradient(180deg, rgba(252, 248, 241, 0.98), rgba(246, 240, 230, 0.94));
        backdrop-filter: blur(18px);
      }

      .sheet__header h2,
      .sheet__header p {
        margin: 0;
      }

      .sheet__header h2 {
        font-size: 24px;
        line-height: 1.05;
      }

      .sheet__header p {
        color: var(--studio-muted);
        font-size: 13px;
      }

      .sheet__close {
        width: 40px;
        height: 40px;
        border-radius: 999px;
        border: 1px solid var(--studio-line);
        background: rgba(23, 21, 18, 0.04);
        color: var(--studio-ink);
      }

      .card {
        display: grid;
        gap: 14px;
        padding: 16px;
        border: 1px solid var(--studio-line);
        border-radius: 20px;
        background: var(--studio-paper-strong);
      }

      .soft-note {
        padding: 14px 16px;
        border-radius: 18px;
        border: 1px solid var(--studio-line);
        background: rgba(255, 255, 255, 0.54);
        color: var(--studio-muted);
        line-height: 1.5;
      }

      .mono {
        font-family: Consolas, "SFMono-Regular", monospace;
        font-size: 11px;
        color: var(--studio-muted);
      }

      #project-inspector,
      #block-inspector {
        display: grid;
        gap: 16px;
      }

      .sheet .button {
        color: var(--studio-ink);
        border-color: var(--studio-line);
        background: rgba(23, 21, 18, 0.04);
      }

      .sheet .button.primary {
        border-color: transparent;
        color: #1b0d03;
        background: linear-gradient(180deg, #ff7a1a, #d85b00);
      }

      .sheet .field {
        color: var(--studio-muted);
      }

      .sheet .field input,
      .sheet .field select,
      .sheet .field textarea {
        border-color: var(--studio-line);
        background: rgba(255, 255, 255, 0.8);
        color: var(--studio-ink);
      }

      @media (max-width: 860px) {
        .status-toast {
          left: 12px;
          right: 12px;
          bottom: 12px;
          max-width: none;
        }

        .studio-corner {
          top: 12px;
          right: 12px;
        }

        .corner-panel {
          width: min(340px, calc(100vw - 20px));
        }

        .preview-viewport[data-size="tablet"] {
          width: calc(100vw - 24px);
          height: calc(100vh - 24px);
          margin: 12px auto;
        }

        .preview-viewport[data-size="mobile"] {
          width: calc(100vw - 18px);
          height: calc(100vh - 18px);
          margin: 9px auto;
        }

        .sheet__panel {
          top: 12px;
          right: 12px;
          left: 12px;
          bottom: 12px;
          width: auto;
        }

        .field-grid.two,
        .button-row {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="studio-shell">
      <main class="workspace-stage">
        <div id="canvas-stage" class="canvas-stage is-active">
          <div id="design-viewport" class="preview-viewport" data-size="desktop">
            <iframe id="design-frame" class="preview-frame" title="Studio Design Surface"></iframe>
          </div>
        </div>

        <div id="preview-stage" class="preview-stage">
          <div id="preview-viewport" class="preview-viewport" data-size="desktop">
            <iframe id="preview-frame" class="preview-frame" title="Studio Published Preview"></iframe>
          </div>
        </div>
      </main>

      <div class="studio-corner">
        <div class="corner-status" id="corner-status" data-layout-active="false">Canvas mode</div>
        <button type="button" class="corner-toggle" id="studio-menu-toggle" aria-expanded="false" aria-controls="studio-menu-panel">+</button>
        <aside class="corner-panel" id="studio-menu-panel">
          <div class="corner-panel__header">
            <span class="eyebrow">Studio V2</span>
            <h1 id="studio-project-label">Loading project</h1>
            <div class="doc-chip" id="studio-doc-id">No project selected</div>
          </div>

          <section class="corner-panel__section">
            <label class="field">
              <span>Project</span>
              <select id="project-list"></select>
            </label>
            <label class="field">
              <span>Preset</span>
              <select id="preset-select"></select>
            </label>
            <div class="button-row">
              <button class="button primary" id="create-project-btn" type="button">New</button>
              <button class="button" id="duplicate-project-btn" type="button">Duplicate</button>
            </div>
          </section>

          <section class="corner-panel__section">
            <div class="field">
              <span>Locale</span>
              <div class="segmented" id="locale-toggle">
                <button type="button" data-locale="fr" class="is-active">FR</button>
                <button type="button" data-locale="en">EN</button>
              </div>
            </div>
            <div class="field">
              <span>View</span>
              <div class="segmented" id="preview-mode-toggle">
                <button type="button" data-mode="canvas" class="is-active">Canvas</button>
                <button type="button" data-mode="preview">Published Preview</button>
              </div>
            </div>
            <div class="field">
              <span>Device</span>
              <div class="segmented" id="preview-size-toggle">
                <button type="button" data-preview-size="desktop" class="is-active">Desktop</button>
                <button type="button" data-preview-size="tablet">Tablet</button>
                <button type="button" data-preview-size="mobile">Mobile</button>
              </div>
            </div>
          </section>

          <section class="corner-panel__section">
            <div class="button-row">
              <button class="button primary" id="save-project-btn" type="button">Save</button>
              <button class="button" id="reload-project-btn" type="button">Reload</button>
              <button class="button" id="open-project-settings-btn" type="button">Project Settings</button>
              <button class="button" id="open-block-settings-btn" type="button">Block Settings</button>
              <button class="button" id="toggle-layout-mode-btn" type="button">Enter Layout Mode</button>
              <button class="button ghost" id="open-project-btn" type="button">Open Route</button>
            </div>
          </section>
        </aside>
      </div>

      <div class="status-toast" id="studio-status">Loading Studio V2...</div>

      <section class="sheet" id="project-sheet">
        <div class="sheet__backdrop" data-close-sheet="project"></div>
        <div class="sheet__panel">
          <header class="sheet__header">
            <div>
              <h2>Project Settings</h2>
              <p id="active-locale-label">Locale FR</p>
            </div>
            <button type="button" class="sheet__close" data-close-sheet="project" aria-label="Close project settings">x</button>
          </header>
          <div id="project-inspector"></div>
        </div>
      </section>

      <section class="sheet" id="block-sheet">
        <div class="sheet__backdrop" data-close-sheet="block"></div>
        <div class="sheet__panel">
          <header class="sheet__header">
            <div>
              <h2>Block Settings</h2>
              <p id="selected-block-label">No selection</p>
            </div>
            <button type="button" class="sheet__close" data-close-sheet="block" aria-label="Close block settings">x</button>
          </header>
          <div id="block-inspector"></div>
        </div>
      </section>
    </div>

    <script type="module" src="/src/studio/studio-app.js"></script>
  </body>
</html>
