---
const title = 'Studio V2';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #090a0f;
        --panel: rgba(12, 15, 22, 0.82);
        --panel-strong: #11141d;
        --panel-soft: rgba(255, 255, 255, 0.04);
        --line: rgba(255, 255, 255, 0.08);
        --line-strong: rgba(255, 115, 0, 0.28);
        --text: #f8f5ee;
        --muted: #a8a195;
        --accent: #ff6b00;
        --accent-soft: rgba(255, 107, 0, 0.12);
        --success: #49d17d;
        --danger: #ff7272;
        --shadow: 0 24px 80px rgba(0, 0, 0, 0.4);
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Georgia, "Times New Roman", serif;
        color: var(--text);
        background:
          radial-gradient(circle at 0% 0%, rgba(255, 107, 0, 0.16), transparent 24%),
          radial-gradient(circle at 100% 0%, rgba(73, 209, 125, 0.08), transparent 18%),
          linear-gradient(180deg, #07080b, #0a0d13 46%, #090b11);
      }

      button, input, select, textarea {
        font: inherit;
      }

      button {
        cursor: pointer;
      }

      h1, h2, h3, h4, p {
        margin: 0;
      }

      .studio-shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 430px;
        min-height: 100vh;
      }

      .studio-workspace,
      .studio-sidebar {
        min-width: 0;
        background: var(--panel);
        backdrop-filter: blur(18px);
      }

      .studio-sidebar {
        border-left: 1px solid var(--line);
      }

      .studio-workspace {
        display: grid;
        grid-template-rows: auto auto minmax(0, 1fr);
        min-height: 100vh;
      }

      .sidebar-scroll {
        height: 100vh;
        overflow: auto;
        padding: 16px 16px 22px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .eyebrow::before {
        content: "";
        width: 28px;
        height: 1px;
        background: linear-gradient(90deg, var(--accent), transparent);
      }

      h1 {
        font-size: 38px;
        line-height: 0.95;
      }

      h2 {
        font-size: 18px;
      }

      h3 {
        font-size: 13px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .muted {
        color: var(--muted);
      }

      .card {
        display: grid;
        gap: 12px;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 22px;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01)),
          rgba(11, 14, 20, 0.92);
        box-shadow: var(--shadow);
      }

      .stack {
        display: grid;
        gap: 16px;
      }

      .toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .button,
      .segmented button,
      .project-item,
      .palette-item,
      .inactive-item {
        border: 1px solid var(--line);
        border-radius: 16px;
        background: var(--panel-soft);
        color: var(--text);
      }

      .button {
        padding: 9px 12px;
      }

      .button.primary {
        background: linear-gradient(180deg, #ff7a1a, #d95b00);
        border-color: transparent;
        color: #140901;
        font-weight: 700;
      }

      .button.ghost {
        background: transparent;
      }

      .button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }

      .field {
        display: grid;
        gap: 6px;
        font-size: 11px;
        color: var(--muted);
      }

      .field input,
      .field select,
      .field textarea {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        color: var(--text);
        padding: 10px 12px;
      }

      .field textarea {
        min-height: 96px;
        resize: vertical;
      }

      .field-grid {
        display: grid;
        gap: 10px;
      }

      .field-grid.two {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .mono {
        font-family: Consolas, "SFMono-Regular", monospace;
        font-size: 11px;
        color: var(--muted);
      }

      .workspace-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 18px;
        padding: 24px 28px 0;
      }

      .workspace-heading {
        display: grid;
        gap: 8px;
      }

      .workspace-tools {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
        align-items: flex-start;
      }

      .segmented {
        display: inline-flex;
        padding: 4px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.04);
      }

      .segmented button {
        border: 0;
        background: transparent;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 12px;
      }

      .segmented button.is-active {
        background: linear-gradient(180deg, rgba(255, 107, 0, 0.24), rgba(255, 107, 0, 0.12));
        color: #fff2e7;
      }

      .workspace-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        padding: 16px 28px 0;
      }

      .status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.04);
        color: var(--muted);
      }

      .status.ok {
        color: var(--success);
      }

      .status.error {
        color: var(--danger);
      }

      .doc-chip {
        padding: 10px 14px;
        border: 1px dashed rgba(255, 255, 255, 0.12);
        border-radius: 999px;
        font-size: 12px;
        color: var(--muted);
      }

      .workspace-stage {
        min-height: 0;
        padding: 22px 28px 28px;
      }

      .stage-surface {
        position: relative;
        display: grid;
        height: 100%;
        min-height: calc(100vh - 188px);
        border-radius: 30px;
        border: 1px solid var(--line);
        background:
          linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
          linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
        background-size: 96px 96px, 96px 96px, auto;
        overflow: hidden;
      }

      .canvas-stage,
      .preview-stage {
        position: absolute;
        inset: 0;
        display: none;
      }

      .canvas-stage {
        padding: 20px;
        overflow: auto;
      }

      .preview-stage {
        padding: 20px;
      }

      .preview-stage.is-active,
      .canvas-stage.is-active {
        display: block;
      }

      .studio-canvas {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        grid-auto-rows: 74px;
        gap: 14px;
        min-height: 100%;
      }

      .canvas-card {
        position: relative;
        display: grid;
        grid-column: var(--grid-column) / span var(--grid-width);
        grid-row: var(--grid-row) / span var(--grid-height);
        grid-template-rows: auto minmax(0, 1fr);
        gap: 12px;
        min-width: 0;
        padding: 16px;
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)),
          linear-gradient(180deg, rgba(255, 107, 0, 0.12), rgba(255, 107, 0, 0.02));
        box-shadow: 0 20px 42px rgba(0, 0, 0, 0.28);
        overflow: hidden;
      }

      .canvas-card.is-selected {
        border-color: rgba(255, 107, 0, 0.72);
        box-shadow: 0 0 0 1px rgba(255, 107, 0, 0.32), 0 24px 54px rgba(0, 0, 0, 0.34);
      }

      .canvas-card.is-disabled {
        opacity: 0.5;
      }

      .canvas-card.is-legacy {
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01)),
          linear-gradient(180deg, rgba(77, 155, 230, 0.14), rgba(77, 155, 230, 0.03));
      }

      .canvas-card__chrome {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
        min-height: 38px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 160ms ease;
      }

      .canvas-card:hover .canvas-card__chrome,
      .canvas-card.is-selected .canvas-card__chrome {
        opacity: 1;
        pointer-events: auto;
      }

      .canvas-card__tools {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
        pointer-events: none;
      }

      .canvas-card:hover .canvas-card__tools,
      .canvas-card.is-selected .canvas-card__tools {
        pointer-events: auto;
      }

      .canvas-card__body {
        min-height: 0;
        display: grid;
        gap: 10px;
        align-content: start;
      }

      .canvas-card.is-compact .canvas-card__body {
        gap: 8px;
      }

      .canvas-chip {
        display: inline-flex;
        align-items: center;
        max-width: 100%;
        min-height: 32px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 999px;
        padding: 6px 10px;
        background: rgba(255, 255, 255, 0.04);
        color: var(--text);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .canvas-chip__label {
        display: block;
        max-width: 112px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .canvas-chip--move {
        cursor: grab;
      }

      .canvas-chip--danger {
        color: #ffd0d0;
      }

      .canvas-resize {
        position: absolute;
        width: 14px;
        height: 14px;
        border-radius: 999px;
        background: white;
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.26);
        opacity: 0;
        pointer-events: none;
        transition: opacity 160ms ease;
      }

      .canvas-card:hover .canvas-resize,
      .canvas-card.is-selected .canvas-resize {
        opacity: 1;
        pointer-events: auto;
      }

      .canvas-resize--e { right: 10px; top: calc(50% - 7px); cursor: ew-resize; }
      .canvas-resize--s { left: calc(50% - 7px); bottom: 10px; cursor: ns-resize; }
      .canvas-resize--se { right: 10px; bottom: 10px; cursor: nwse-resize; }

      .inline-value,
      .canvas-static,
      .inline-editor {
        width: 100%;
        min-width: 0;
        border: 0;
        background: transparent;
        color: var(--text);
        padding: 0;
        text-align: left;
      }

      .inline-value {
        cursor: text;
      }

      .inline-editor {
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.06);
        outline: 1px solid rgba(255, 107, 0, 0.36);
        padding: 8px 10px;
        resize: none;
      }

      .canvas-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 2fr;
        gap: 14px;
        min-height: 100%;
      }

      .canvas-hero__art {
        border-radius: 18px;
        background:
          radial-gradient(circle at 30% 30%, rgba(255, 214, 170, 0.85), transparent 22%),
          radial-gradient(circle at 70% 40%, rgba(255, 107, 0, 0.35), transparent 28%),
          linear-gradient(135deg, rgba(255, 107, 0, 0.4), rgba(9, 10, 15, 0.2));
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .canvas-hero__copy {
        display: grid;
        gap: 10px;
        align-content: end;
        min-width: 0;
      }

      .canvas-title {
        font-size: clamp(26px, 2vw, 42px);
        font-weight: 700;
        line-height: 0.98;
      }

      .canvas-kicker {
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #ffd8bb;
      }

      .canvas-body {
        font-size: 15px;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.82);
      }

      .canvas-card__heading {
        font-size: 16px;
        font-weight: 700;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .canvas-subtle {
        font-size: 12px;
        color: var(--muted);
      }

      .canvas-empty-copy {
        font-size: 12px;
        color: var(--muted);
      }

      .canvas-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }

      .canvas-card.is-compact .canvas-stats {
        grid-template-columns: 1fr;
      }

      .canvas-stat {
        display: grid;
        gap: 4px;
        padding: 12px;
        min-width: 0;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .canvas-stat__value {
        font-size: 26px;
        font-weight: 700;
      }

      .canvas-stat__label {
        font-size: 11px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .canvas-actions {
        display: grid;
        gap: 10px;
      }

      .canvas-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 14px;
        border-radius: 16px;
        line-height: 1.2;
      }

      .canvas-action--primary {
        background: linear-gradient(180deg, #ff7a1a, #d95b00);
        color: #140901;
      }

      .canvas-action--secondary {
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.03);
      }

      .canvas-pill-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .canvas-pill {
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.04);
        font-size: 12px;
      }

      .canvas-list {
        display: grid;
        gap: 10px;
      }

      .canvas-list__row,
      .canvas-result {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 12px;
        align-items: start;
      }

      .canvas-index,
      .canvas-result__icon {
        display: inline-grid;
        place-items: center;
        min-width: 26px;
        min-height: 26px;
        padding: 0 8px;
        border-radius: 999px;
        background: rgba(255, 107, 0, 0.18);
        color: #ffe2cf;
        font-size: 12px;
        letter-spacing: 0.08em;
      }

      .canvas-copy-pair {
        display: grid;
        gap: 6px;
        padding: 10px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
      }

      .canvas-copy-pair:first-child {
        border-top: 0;
        padding-top: 0;
      }

      .canvas-copy-pair__title {
        font-size: 14px;
        font-weight: 700;
      }

      .canvas-copy-pair__body,
      .canvas-list__value,
      .canvas-result__body {
        font-size: 13px;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.82);
      }

      .canvas-card.is-compact .canvas-copy-pair__body,
      .canvas-card.is-compact .canvas-list__value,
      .canvas-card.is-compact .canvas-result__body,
      .canvas-card.is-compact .canvas-body {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
      }

      .canvas-gallery {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
      }

      .canvas-gallery__hero {
        grid-column: 1 / -1;
        min-height: 110px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(255, 107, 0, 0.34), rgba(255, 255, 255, 0.04));
        border: 1px solid rgba(255, 255, 255, 0.08);
        display: grid;
        place-items: center;
        color: #ffe8d6;
      }

      .canvas-gallery__tile {
        min-height: 54px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        display: grid;
        place-items: center;
        color: var(--muted);
        font-size: 12px;
      }

      .legacy-pill {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(77, 155, 230, 0.16);
        color: #d3e9ff;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .palette-ghost {
        position: fixed;
        z-index: 9999;
        pointer-events: none;
        padding: 10px 14px;
        border-radius: 14px;
        background: rgba(255, 107, 0, 0.92);
        color: #1b0b00;
        box-shadow: 0 18px 34px rgba(0, 0, 0, 0.26);
      }

      .canvas-empty {
        display: none;
        height: 100%;
        place-items: center;
      }

      .canvas-empty.is-visible {
        display: grid;
      }

      .empty-card {
        max-width: 420px;
        text-align: center;
        padding: 26px;
        border-radius: 24px;
        border: 1px dashed rgba(255, 255, 255, 0.14);
        background: rgba(255, 255, 255, 0.03);
      }

      .preview-viewport {
        width: 100%;
        height: 100%;
        margin: 0 auto;
        transition: width 180ms ease;
      }

      .preview-viewport[data-size="desktop"] { max-width: 1440px; }
      .preview-viewport[data-size="tablet"] { width: 920px; max-width: 100%; }
      .preview-viewport[data-size="mobile"] { width: 430px; max-width: 100%; }

      .preview-frame {
        width: 100%;
        height: 100%;
        border: 1px solid var(--line);
        border-radius: 22px;
        background: #fff;
      }

      .soft-note,
      .sidebar-note {
        padding: 10px 12px;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.03);
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
      }

      .sidebar-stack {
        display: grid;
        gap: 12px;
      }

      .sidebar-summary {
        position: sticky;
        top: 0;
        z-index: 3;
        border-color: rgba(255, 255, 255, 0.1);
        background:
          linear-gradient(180deg, rgba(17, 20, 29, 0.96), rgba(10, 13, 19, 0.94)),
          rgba(11, 14, 20, 0.94);
        backdrop-filter: blur(18px);
      }

      .sidebar-summary__header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
      }

      .sidebar-summary__path {
        display: block;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding: 10px 12px;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.07);
        background: rgba(255, 255, 255, 0.03);
      }

      .sidebar-summary__stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
      }

      .summary-cell {
        display: grid;
        gap: 4px;
        min-width: 0;
        padding: 10px 12px;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.07);
        background: rgba(255, 255, 255, 0.03);
      }

      .summary-cell strong {
        font-size: 13px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .summary-label {
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .sidebar-section {
        border: 1px solid var(--line);
        border-radius: 18px;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01)),
          rgba(11, 14, 20, 0.92);
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .sidebar-section summary {
        list-style: none;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        padding: 14px 14px 12px;
        cursor: pointer;
      }

      .sidebar-section summary::-webkit-details-marker {
        display: none;
      }

      .sidebar-section[open] summary {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      }

      .section-heading {
        display: grid;
        gap: 4px;
      }

      .section-meta {
        font-size: 10px;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-align: right;
      }

      .section-body {
        display: grid;
        gap: 12px;
        padding: 12px 14px 14px;
      }

      .subsection {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.02);
        overflow: hidden;
      }

      .subsection summary {
        list-style: none;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        padding: 12px 14px;
        cursor: pointer;
      }

      .subsection summary::-webkit-details-marker {
        display: none;
      }

      .subsection[open] summary {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      }

      .subsection-body {
        display: grid;
        gap: 12px;
        padding: 12px 14px 14px;
      }

      .create-grid {
        display: grid;
        gap: 10px;
      }

      .project-list,
      .palette-list,
      .inactive-list {
        display: grid;
        gap: 8px;
      }

      .project-item,
      .palette-item,
      .inactive-item {
        width: 100%;
        padding: 11px 12px;
        text-align: left;
      }

      .project-item.active,
      .inactive-item.active {
        border-color: var(--line-strong);
        background: linear-gradient(180deg, rgba(255, 107, 0, 0.16), rgba(255, 107, 0, 0.04));
      }

      .row-head {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
        min-width: 0;
      }

      .item-pill {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.04);
        color: var(--muted);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .item-pill--accent {
        border-color: rgba(255, 107, 0, 0.24);
        background: rgba(255, 107, 0, 0.12);
        color: #ffd8bb;
      }

      .project-item-title,
      .palette-item-title,
      .inactive-item-title {
        display: block;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 13px;
      }

      .inactive-item {
        display: grid;
        gap: 5px;
      }

      .inactive-item-reason {
        font-size: 11px;
        color: var(--muted);
        line-height: 1.45;
      }

      .palette-item {
        display: grid;
        gap: 6px;
        position: relative;
      }

      .palette-item::after {
        content: none;
      }

      .palette-item.disabled {
        opacity: 0.35;
        cursor: not-allowed;
      }

      .project-item .mono,
      .palette-item .mono,
      .inactive-item .mono {
        display: block;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .sidebar-projects {
        max-height: 320px;
        overflow: auto;
        display: grid;
        gap: 8px;
      }

      .mobile-note {
        display: none;
        margin-top: 14px;
        padding: 12px 14px;
        border-radius: 16px;
        border: 1px solid rgba(255, 107, 0, 0.16);
        background: rgba(255, 107, 0, 0.08);
        color: #ffd7bc;
      }

      @media (max-width: 1440px) {
        .studio-shell {
          grid-template-columns: minmax(0, 1fr) 390px;
        }
      }

      @media (max-width: 1260px) {
        .studio-shell {
          grid-template-columns: 1fr;
        }

        .studio-sidebar {
          border-left: 0;
          border-top: 1px solid var(--line);
        }

        .sidebar-scroll {
          height: auto;
        }

        .workspace-stage {
          min-height: 60vh;
        }
      }

      @media (max-width: 860px) {
        .field-grid.two {
          grid-template-columns: 1fr;
        }

        .sidebar-summary__stats {
          grid-template-columns: 1fr;
        }

        .mobile-note {
          display: block;
        }
      }
    </style>
  </head>
  <body>
    <div class="studio-shell">
      <main class="studio-workspace">
        <div class="workspace-header">
          <div class="workspace-heading">
            <span class="eyebrow">Workspace</span>
            <h2 id="studio-project-label">Loading document</h2>
          </div>
          <div class="workspace-tools">
            <div class="segmented" id="locale-toggle">
              <button type="button" data-locale="fr" class="is-active">FR</button>
              <button type="button" data-locale="en">EN</button>
            </div>
            <div class="segmented" id="preview-mode-toggle">
              <button type="button" data-mode="canvas" class="is-active">Canvas</button>
              <button type="button" data-mode="preview">Published Preview</button>
            </div>
            <button class="button primary" id="save-project-btn">Save Project</button>
            <button class="button" id="reload-project-btn">Reload</button>
            <button class="button ghost" id="open-project-btn">Open Route</button>
          </div>
        </div>

        <div class="workspace-meta">
          <div class="status" id="studio-status">Loading Studio V2...</div>
          <div class="doc-chip" id="studio-doc-id">No project selected</div>
          <div class="segmented" id="preview-size-toggle">
            <button type="button" data-preview-size="desktop" class="is-active">Desktop</button>
            <button type="button" data-preview-size="tablet">Tablet</button>
            <button type="button" data-preview-size="mobile">Mobile</button>
          </div>
        </div>

        <div class="workspace-stage">
          <div class="stage-surface">
            <div id="canvas-stage" class="canvas-stage is-active">
              <div id="studio-canvas" class="studio-canvas"></div>
              <div id="canvas-empty" class="canvas-empty">
                <div class="empty-card">
                  <span class="eyebrow">Canvas</span>
                  <h2 style="margin-top: 10px;">No visible blocks on this page</h2>
                  <p class="muted" style="margin-top: 10px;">Enable a block or drag a core block from the sidebar palette to start the composition.</p>
                </div>
              </div>
            </div>

            <div id="preview-stage" class="preview-stage">
              <div id="preview-viewport" class="preview-viewport" data-size="desktop">
                <iframe id="preview-frame" class="preview-frame" title="Studio Published Preview"></iframe>
              </div>
            </div>
          </div>
          <div class="mobile-note">Studio V2 is desktop-first. The route loads on smaller screens, but grid editing is designed for desktop input.</div>
        </div>
      </main>

      <aside class="studio-sidebar">
        <div class="sidebar-scroll">
          <div id="studio-sidebar-content" data-sidebar-content="true"></div>
        </div>
      </aside>
    </div>

    <script type="module" src="/src/studio/studio-app.js"></script>
  </body>
</html>
