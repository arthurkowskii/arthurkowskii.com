---
// Language Switcher Component
// Provides toggle between French and English

// Get current locale from props or detect from URL
const { currentLocale = 'fr' } = Astro.props;
const isEnglish = currentLocale === 'en';
---

<div class="language-switcher" id="language-switcher">
  <button class={`lang-btn ${!isEnglish ? 'active' : ''}`} data-lang="fr" title="Français">
    FR
  </button>
  <button class={`lang-btn ${isEnglish ? 'active' : ''}`} data-lang="en" title="English">
    EN
  </button>
</div>

<style>
  .language-switcher {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1000;
    display: flex;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .lang-btn {
    background: transparent;
    border: none;
    padding: 8px 14px;
    border-radius: 16px;
    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #64748b;
    min-width: 36px;
  }

  .lang-btn:hover {
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
  }

  .lang-btn.active {
    background: #3b82f6;
    color: white;
    box-shadow: 0 2px 4px rgba(59, 130, 246, 0.2);
  }

  /* Dark theme support */
  html[data-theme="dark"] .language-switcher {
    background: rgba(26, 26, 26, 0.9);
    border-color: rgba(255, 255, 255, 0.1);
  }

  html[data-theme="dark"] .lang-btn {
    color: #a1a1aa;
  }

  html[data-theme="dark"] .lang-btn:hover {
    background: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
  }

  html[data-theme="dark"] .lang-btn.active {
    background: #3b82f6;
    color: white;
  }

  /* Mobile responsiveness */
  @media (max-width: 640px) {
    .language-switcher {
      top: 15px;
      right: 15px;
      padding: 3px;
    }

    .lang-btn {
      padding: 6px 12px;
      font-size: 12px;
      min-width: 32px;
    }
  }

  /* Accessibility */
  .lang-btn:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
  }

  /* Animation for language change */
  .language-switcher.changing {
    transform: scale(0.95);
  }
</style>

<script>
  import { getCurrentLocale, setLocale, getLocales, t } from '../utils/i18n.js';

  class LanguageSwitcher {
    constructor() {
      // Clear any stored language preferences to ensure consistent behavior
      if (typeof localStorage !== 'undefined') {
        localStorage.removeItem('portfolio-locale');
      }
      
      this.currentLocale = getCurrentLocale();
      this.switcher = document.getElementById('language-switcher');
      this.buttons = this.switcher?.querySelectorAll('.lang-btn');
      
      this.init();
    }

    init() {
      if (!this.switcher) return;

      // Don't update button state on init - trust the server-side rendering
      // The HTML already has the correct active state set

      // Add click listeners
      this.buttons?.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const targetLang = e.target.dataset.lang;
          if (targetLang && targetLang !== this.currentLocale) {
            this.switchLanguage(targetLang);
          }
        });
      });

      // Listen for external locale changes
      window.addEventListener('locale-changed', (e) => {
        this.currentLocale = e.detail.locale;
        this.updateActiveButton();
      });

      console.log('🌐 Language switcher initialized');
    }

    updateActiveButton() {
      this.buttons?.forEach(btn => {
        const isActive = btn.dataset.lang === this.currentLocale;
        btn.classList.toggle('active', isActive);
        
        // Update accessibility attributes
        btn.setAttribute('aria-pressed', isActive.toString());
      });
    }

    async switchLanguage(locale) {
      if (!locale || locale === this.currentLocale) return;

      try {
        // Add switching animation
        this.switcher?.classList.add('changing');

        // Update button states
        this.updateActiveButton();

        // Set new locale and navigate to appropriate path
        // setLocale will handle the navigation
        setTimeout(() => {
          setLocale(locale);
        }, 200);

      } catch (error) {
        console.error('Language switch error:', error);
        this.switcher?.classList.remove('changing');
      }
    }

    // Method to get current language for other components
    getCurrentLanguage() {
      return this.currentLocale;
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      window.languageSwitcher = new LanguageSwitcher();
    });
  } else {
    window.languageSwitcher = new LanguageSwitcher();
  }

  // Export for global access
  window.LanguageSwitcher = LanguageSwitcher;
</script>