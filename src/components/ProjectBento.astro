  .tracklist-title {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(15, 23, 42, 0.55);
    margin: 0 0 1rem 0;
    font-weight: 600;
  }

  .tracklist-scroll {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: 0.5rem;
    scrollbar-color: rgba(15, 23, 42, 0.2) rgba(15, 23, 42, 0.06);
  }

  /* Custom scrollbar for tracklist */
  .tracklist-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .tracklist-scroll::-webkit-scrollbar-track {
    background: rgba(15, 23, 42, 0.06);
    border-radius: 3px;
  }
  .tracklist-scroll::-webkit-scrollbar-thumb {
    background: rgba(15, 23, 42, 0.2);
    border-radius: 3px;
  }
  .tracklist-scroll::-webkit-scrollbar-thumb:hover {
    background: rgba(15, 23, 42, 0.3);
  }

  .audio-track-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.48);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 12px;
    color: rgba(15, 23, 42, 0.86);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
    text-align: left;
    outline: none;
    font-size: 0.95rem;
  }

  .audio-track-item:hover {
    background: rgba(var(--accent-color-rgb), 0.12);
    border-color: rgba(var(--accent-color-rgb), 0.22);
    transform: translateX(4px);
    color: #0f172a;
    box-shadow: 0 12px 30px rgba(var(--accent-color-rgb), 0.12);
  }

  .audio-track-item.active {
    background: rgba(var(--accent-color-rgb), 0.16);
    border-color: rgba(var(--accent-color-rgb), 0.28);
    color: #0f172a;
    box-shadow: 0 16px 36px rgba(var(--accent-color-rgb), 0.14);
  }

  .audio-track-item:focus-visible,
  .audio-skip-btn:focus-visible,
  .audio-play-btn:focus-visible,
  .audio-progress-bar:focus-visible {
    outline: 2px solid rgba(var(--accent-color-rgb), 0.55);
    outline-offset: 3px;
  }

  .audio-track-item:focus-visible {
    background: rgba(var(--accent-color-rgb), 0.12);
    border-color: rgba(var(--accent-color-rgb), 0.24);
  }

  .track-item-number {
    font-family: inherit;
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    opacity: 0.5;
  }

  .track-item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .track-item-title {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-item-duration {
    font-size: 0.8rem;
    opacity: 0.6;
  }

  .track-item-icon {
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.2s ease, transform 0.2s ease;
    color: inherit;
    display: flex;
    align-items: center;
  }

  .audio-track-item:hover .track-item-icon,
  .audio-track-item.active .track-item-icon {
    opacity: 1;
    transform: scale(1);
  }

  .track-item-icon svg {
    display: block;
  }

  .audio-track-item.active .track-item-icon svg {
    /* Make icon match the playing icon style provided via JS if needed, 
       but simple display is fine. */
  }

  html[data-theme="dark"] .audio-card-wide .audio-player-column {
    border-right-color: rgba(255, 255, 255, 0.1);
  }

  html[data-theme="dark"] .tracklist-title {
    color: rgba(255, 255, 255, 0.5);
  }

  html[data-theme="dark"] .tracklist-scroll {
    scrollbar-color: rgba(255, 255, 255, 0.2) rgba(255, 255, 255, 0.05);
  }

  html[data-theme="dark"] .tracklist-scroll::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
  }

  html[data-theme="dark"] .tracklist-scroll::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
  }

  html[data-theme="dark"] .tracklist-scroll::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  html[data-theme="dark"] .audio-track-item {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.7);
  }

  html[data-theme="dark"] .audio-track-item:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    box-shadow: none;
  }

  html[data-theme="dark"] .audio-track-item.active {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    box-shadow: none;
  }

  html[data-theme="dark"] .audio-track-item:focus-visible,
  html[data-theme="dark"] .audio-skip-btn:focus-visible,
  html[data-theme="dark"] .audio-play-btn:focus-visible,
  html[data-theme="dark"] .audio-progress-bar:focus-visible {
    outline-color: rgba(var(--accent-color-rgb), 0.72);
  }

  /* Responsive Adjustments for Tracklist */
  @media (max-width: 899px) {
    .audio-card-wide {
      flex-direction: column;
      height: auto;
      max-height: none;
      padding-right: 2.25rem; /* Reset padding */
    }

    .audio-card-wide .audio-player-column {
      flex: 0 0 auto;
      width: 100%;
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-right: 0;
      padding-bottom: 2rem;
      margin-bottom: 2rem;
    }

    .audio-card-wide .audio-tracklist-column {
      max-height: 300px; /* Limit height on mobile so it doesn't take forever to scroll */
    }
  }

  .sampler-card-wide .sampler-content {
    grid-template-columns: 1fr auto;
    width: 100%;
    justify-content: space-between;
  }

  .sampler-card-wide .sampler-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
  }

  .sampler-card-wide .sampler-pad-row {
    gap: 1.25rem;
  }

  .sampler-card::after {
    content: "";
    position: absolute;
    inset: auto -25% -20% auto;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(var(--accent-color-rgb), 0.2),
      transparent 70%
    );
    filter: blur(30px);
    opacity: 0.35;
    z-index: 0;
  }

  html[data-theme="light"] .sampler-card {
    background:
      radial-gradient(
        circle at 15% 15%,
        rgba(var(--accent-color-rgb), 0.15),
        transparent 65%
      ),
      rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.04);
    box-shadow:
      0 18px 50px rgba(15, 23, 42, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .sampler-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .sampler-title {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(244, 244, 245, 0.8);
  }

  html[data-theme="light"] .sampler-title {
    color: rgba(15, 23, 42, 0.7);
  }

  .sampler-content {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.25rem;
    align-items: center;
  }

  .sampler-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }

  .sampler-pad-row {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  /* FMOD Interactive Card */
  .fmod-card {
    grid-column: 1 / 13; /* Matching audio card default width */
    grid-row: 7; /* Adjust properly relative to other cards */
    padding: 2.25rem;
    border-radius: 24px;
    background: linear-gradient(
      135deg,
      rgba(var(--accent-color-rgb), 0.05),
      rgba(255, 255, 255, 0.95)
    );
    border: 1px solid rgba(15, 23, 42, 0.08);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  html[data-theme="dark"] .fmod-card {
    background: linear-gradient(
      160deg,
      rgba(15, 15, 19, 0.8),
      rgba(20, 20, 25, 0.9)
    );
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .fmod-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .fmod-status {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border-radius: 99px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  .badge-initializing {
    background: rgba(234, 179, 8, 0.2);
    color: #eab308;
    border: 1px solid rgba(234, 179, 8, 0.4);
  }

  .badge-ready {
    background: rgba(34, 197, 94, 0.2);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.4);
  }

  .badge-error {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.4);
  }

  .fmod-events {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.1);
  }

  html[data-theme="dark"] .fmod-events {
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .fmod-event-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.5);
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid rgba(15, 23, 42, 0.05);
  }

  html[data-theme="dark"] .fmod-event-row {
    background: rgba(0, 0, 0, 0.2);
    border-color: rgba(255, 255, 255, 0.05);
  }

  .fmod-event-name {
    font-weight: 600;
    font-size: 1.1rem;
  }

  .fmod-controls {
    display: flex;
    gap: 0.5rem;
  }

  .fmod-btn {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
    border: none;
  }

  .fmod-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .play-btn {
    background: var(--accent-color);
    color: white;
  }

  .play-btn:not(:disabled):hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(var(--accent-color-rgb), 0.3);
  }

  .stop-btn {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
  }

  .stop-btn:not(:disabled):hover {
    background: rgba(239, 68, 68, 0.2);
  }

  .fmod-parameters {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .fmod-section-title {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(15, 23, 42, 0.6);
    margin: 0 0 0.5rem 0;
  }

  html[data-theme="dark"] .fmod-section-title {
    color: rgba(255, 255, 255, 0.6);
  }

  .fmod-param-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .fmod-param-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .fmod-param-value {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--accent-color);
  }

  .fmod-slider {
    width: 100%;
    accent-color: var(--accent-color);
    cursor: pointer;
  }

  .fmod-slider:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* FMOD Game Mode Styles */
  .fmod-game-mode {
    min-height: 740px;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    background:
      radial-gradient(circle at 50% 0%, rgba(var(--accent-color-rgb), 0.18), transparent 35%),
      linear-gradient(180deg, #17161b 0%, #0a0a0e 100%);
    border: 1px solid rgba(var(--accent-color-rgb), 0.58);
    border-radius: 28px;
    box-shadow:
      0 28px 70px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }

  .fmod-game-header {
    position: relative;
    z-index: 2;
    margin-bottom: 0;
  }

  .fmod-phase-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    padding: 1rem 1.15rem 1.05rem;
    border-radius: 20px;
    border: 1px solid rgba(var(--accent-color-rgb), 0.24);
    background:
      linear-gradient(180deg, rgba(35, 20, 23, 0.92), rgba(14, 12, 18, 0.96)),
      radial-gradient(circle at 50% 0%, rgba(var(--accent-color-rgb), 0.12), transparent 70%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
    text-align: center;
  }

  .fmod-phase-status {
    padding-top: 0.7rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(248, 250, 252, 0.92);
  }

  .fmod-phase-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.48);
  }

  .fmod-phase-copy[data-phase="intro"] {
    border-color: rgba(234, 179, 8, 0.34);
    background:
      linear-gradient(180deg, rgba(52, 37, 13, 0.92), rgba(14, 12, 18, 0.96)),
      radial-gradient(circle at 50% 0%, rgba(234, 179, 8, 0.15), transparent 72%);
  }

  .fmod-phase-copy[data-phase="bossphase"] {
    border-color: rgba(var(--accent-color-rgb), 0.34);
    background:
      linear-gradient(180deg, rgba(56, 22, 22, 0.92), rgba(14, 12, 18, 0.96)),
      radial-gradient(circle at 50% 0%, rgba(var(--accent-color-rgb), 0.16), transparent 72%);
  }

  .fmod-phase-copy[data-phase="flashmob"] {
    border-color: rgba(168, 85, 247, 0.38);
    background:
      linear-gradient(180deg, rgba(43, 22, 61, 0.92), rgba(14, 12, 18, 0.96)),
      radial-gradient(circle at 50% 0%, rgba(168, 85, 247, 0.18), transparent 72%);
    animation: flashmob-pulse 1.2s ease-in-out infinite;
  }

  .fmod-phase-copy[data-phase="special"] {
    border-color: rgba(251, 191, 36, 0.42);
    background:
      linear-gradient(180deg, rgba(56, 41, 12, 0.92), rgba(14, 12, 18, 0.96)),
      radial-gradient(circle at 50% 0%, rgba(251, 191, 36, 0.18), transparent 72%);
    box-shadow: 0 0 22px rgba(251, 191, 36, 0.12);
  }

  .fmod-phase-copy[data-phase="win"] {
    border-color: rgba(16, 185, 129, 0.4);
    background:
      linear-gradient(180deg, rgba(18, 54, 43, 0.92), rgba(14, 12, 18, 0.96)),
      radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.16), transparent 72%);
  }

  @keyframes flashmob-pulse {
    0%,
    100% {
      transform: translateY(0);
      box-shadow: 0 0 0 rgba(168, 85, 247, 0);
    }
    50% {
      transform: translateY(-2px);
      box-shadow: 0 0 26px rgba(168, 85, 247, 0.16);
    }
  }

  .phase-label {
    font-size: clamp(1.55rem, 2.9vw, 2.35rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #f8fafc;
    text-shadow: 0 0 22px rgba(255, 255, 255, 0.12);
  }

  .phase-desc {
    font-size: 0.92rem;
    line-height: 1.58;
    color: rgba(226, 232, 240, 0.82);
    max-width: 56ch;
  }

  .fmod-scene {
    margin: 0;
    margin-top: 0.1rem;
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
    backdrop-filter: none;
  }

  .fmod-stage {
    position: relative;
    min-height: clamp(390px, 46vw, 540px);
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(circle at 50% 18%, rgba(var(--accent-color-rgb), 0.24), transparent 28%),
      linear-gradient(180deg, rgba(48, 16, 20, 0.88) 0%, rgba(17, 13, 18, 0.96) 58%, rgba(8, 8, 12, 0.98) 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 22px 44px rgba(0, 0, 0, 0.4);
    isolation: isolate;
  }

  .fmod-stage::before,
  .fmod-stage::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .fmod-stage::before {
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.26;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.9));
  }

  .fmod-stage::after {
    background:
      radial-gradient(circle at 50% 28%, rgba(255, 255, 255, 0.07), transparent 24%),
      linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.24));
  }

  .fmod-scene.special-active .fmod-stage {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 0 0 1px rgba(251, 191, 36, 0.28),
      0 22px 52px rgba(251, 191, 36, 0.12);
  }

  .fmod-stage-boss-hud {
    position: absolute;
    top: clamp(0.75rem, 1.6vw, 1rem);
    left: 50%;
    width: min(96%, 1280px);
    display: grid;
    grid-template-columns: clamp(6.5rem, 10vw, 8rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    padding: 0.45rem 0.65rem;
    transform: translateX(-50%);
    z-index: 2;
  }

  .fmod-stage-boss-hud[data-reveal="pending"] {
    opacity: 0.88;
  }

  .fmod-stage-boss-hud[data-reveal="filling"] {
    opacity: 1;
  }

  .fmod-stage-boss-hud[data-reveal="live"] {
    opacity: 1;
  }

  .fmod-stage-player-meta,
  .fmod-stage-player-readout {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .fmod-stage-player-meta {
    justify-content: flex-start;
  }

  .fmod-stage-player-readout {
    justify-content: space-between;
  }

  .fmod-stage-boss-label {
    min-width: 0;
    font-size: 0.94rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    color: #f8fafc;
  }

  .fmod-stage-player-title {
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f8fafc;
  }

  .fmod-stage-player-status {
    font-size: 0.72rem;
    font-weight: 700;
    color: rgba(226, 232, 240, 0.72);
    text-align: right;
  }

  .fmod-stage-boss-hud .health-value-display,
  .fmod-stage-player-hud .health-value-display {
    font-variant-numeric: tabular-nums;
    color: #f8fafc;
  }

  .fmod-stage-boss-hud .health-value-display {
    min-width: 2.8ch;
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1;
    text-align: right;
    text-shadow: 0 0 18px rgba(255, 177, 79, 0.22);
  }

  .fmod-stage-player,
  .fmod-boss-container {
    position: absolute;
    bottom: 1.1rem;
    will-change: transform, opacity;
  }

  .fmod-stage-player {
    left: clamp(0.9rem, 3vw, 1.8rem);
    width: min(29%, 220px);
    z-index: 3;
    opacity: 0.9;
    transform: translate3d(-10px, 18px, 0) scale(0.96);
    transition: transform 0.45s ease, opacity 0.45s ease;
  }

  .fmod-boss-container {
    right: clamp(1rem, 4vw, 2.25rem);
    width: min(29%, 270px);
    transform: scale(0.94);
    transform-origin: 50% 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.45rem;
    z-index: 4;
  }

  .fmod-scene.is-playing .fmod-stage-player {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .fmod-stage-player-hud {
    position: absolute;
    left: clamp(7rem, 16vw, 13rem);
    bottom: clamp(1rem, 2vw, 1.5rem);
    width: min(28%, 260px);
    display: flex;
    flex-direction: column;
    gap: 0.48rem;
    padding: 0;
    z-index: 6;
  }

  .fmod-boss-figure {
    width: 100%;
    max-width: 290px;
    transform-origin: 50% 94%;
    filter: drop-shadow(0 22px 34px rgba(0, 0, 0, 0.42));
  }

  .fmod-actor-image,
  .mob-sprite,
  .fmod-portrait-image {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  .fmod-player-sprite {
    transform-origin: 50% 90%;
  }

  .fmod-boss-sprite {
    opacity: 0;
    transform: translateY(-12px) scale(0.9);
    transition: opacity 0.5s ease, transform 0.7s cubic-bezier(0.2, 0.85, 0.25, 1);
  }

  .fmod-scene.is-playing .fmod-boss-sprite {
    opacity: 1;
    transform: translateY(0) scale(0.9);
    animation: boss-idle 4.8s ease-in-out infinite 0.9s;
  }

  @keyframes boss-idle {
    0%,
    100% {
      transform: translateY(0) scale(0.9);
    }
    50% {
      transform: translateY(-4px) scale(0.915);
    }
  }

  @keyframes damage-flash {
    0% {
      filter: brightness(1) saturate(1);
      transform: translateY(0) scale(1);
    }
    50% {
      filter: brightness(1.24) saturate(1.28);
      transform: translateY(3px) scale(0.975);
    }
    100% {
      filter: brightness(1) saturate(1);
      transform: translateY(0) scale(1);
    }
  }

  .fmod-boss-container.damage-flash .fmod-boss-sprite {
    animation: damage-flash 0.24s ease;
  }

  .fmod-mobs-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }

  .mob-sprite-wrapper {
    position: absolute;
    top: var(--mob-y);
    left: var(--mob-x);
    width: clamp(52px, 8vw, 92px);
    opacity: 0;
    transform: translate(-50%, -50%) translateY(26px) scale(calc(var(--mob-scale) * 0.62)) rotate(var(--mob-rotation));
    transition:
      opacity 0.32s ease,
      transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.32s ease;
    transition-delay: calc(var(--mob-index) * 40ms);
    filter: drop-shadow(0 14px 16px rgba(0, 0, 0, 0.26));
  }

  .fmod-scene.swarm-active .mob-sprite-wrapper {
    opacity: 1;
    transform: translate(-50%, -50%) scale(var(--mob-scale)) rotate(var(--mob-rotation));
    filter: drop-shadow(0 18px 18px rgba(0, 0, 0, 0.34));
  }

  .mob-sprite {
    animation: mob-bob 2.8s ease-in-out infinite;
    animation-delay: calc(var(--mob-index) * 0.16s);
  }

  @keyframes mob-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }

  .fmod-stage-floor {
    position: absolute;
    left: 50%;
    bottom: -60px;
    width: min(78%, 620px);
    height: 180px;
    transform: translateX(-50%);
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(var(--accent-color-rgb), 0.28) 0%, rgba(var(--accent-color-rgb), 0.08) 28%, transparent 72%),
      radial-gradient(circle, rgba(0, 0, 0, 0.72) 0%, transparent 74%);
    z-index: 1;
  }

  .health-bar.modern {
    width: 100%;
    height: 14px;
    position: relative;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.34);
  }

  .health-fill {
    height: 100%;
    width: 100%;
    border-radius: 999px;
    transition: none;
  }

  .health-fill.is-intro-filling {
    transition: width var(--boss-intro-duration, 900ms) cubic-bezier(0.2, 0.85, 0.25, 1);
  }

  .fmod-stage-boss-hud .health-bar.modern {
    flex: 1 1 auto;
    height: 16px;
    background:
      linear-gradient(180deg, rgba(17, 13, 18, 0.88), rgba(7, 7, 10, 0.96));
    border: 0;
    box-shadow:
      inset 0 3px 10px rgba(0, 0, 0, 0.5),
      0 0 28px rgba(243, 82, 44, 0.08);
  }

  .fmod-stage-boss-hud .health-bar.modern::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.12), transparent);
    opacity: 0;
    transform: translateX(-120%);
    pointer-events: none;
  }

  .fmod-stage-boss-hud[data-reveal="filling"] .health-bar.modern::after {
    opacity: 1;
    animation: boss-hud-scan 1.15s linear infinite;
  }

  @keyframes boss-hud-scan {
    from {
      transform: translateX(-120%);
    }
    to {
      transform: translateX(140%);
    }
  }

  .fmod-stage-boss-hud .health-fill {
    background: linear-gradient(90deg, #ffb14f, #f3522c 62%, #d9411d 100%);
    box-shadow:
      0 0 16px rgba(243, 82, 44, 0.28),
      0 0 28px rgba(243, 82, 44, 0.14);
  }

  .fmod-stage-player-hud .health-bar.modern {
    height: 12px;
    border: 0;
    background: rgba(12, 18, 28, 0.78);
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.46);
  }

  .fmod-stage-player-hud .health-fill {
    background: linear-gradient(90deg, #67e8f9, #22d3ee 60%, #0891b2 100%);
    box-shadow: 0 0 16px rgba(34, 211, 238, 0.24);
  }

  .fmod-stage-player-hud .fmod-stage-player-title {
    font-size: 0.86rem;
    letter-spacing: 0.16em;
    text-shadow: 0 0 14px rgba(34, 211, 238, 0.18);
  }

  .fmod-controls-panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 1.05rem 1.1rem;
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(18, 18, 24, 0.96), rgba(8, 8, 12, 0.98));
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  .fmod-action-bar {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .fmod-action-btn {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 122px;
    gap: 0.7rem;
    padding: 0.92rem 0.95rem 0.9rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(31, 31, 38, 0.98), rgba(13, 13, 18, 0.98));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
    cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
  }

  .fmod-action-btn:disabled {
    opacity: 0.42;
    cursor: not-allowed;
  }

  .fmod-action-btn:not(:disabled):hover {
    transform: translateY(-2px);
    border-color: rgba(var(--accent-color-rgb), 0.38);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      0 18px 24px rgba(0, 0, 0, 0.24);
  }

  .fmod-action-btn.attack-btn.pulse-damage {
    transform: scale(0.98);
  }

  .fmod-action-btn.attack-btn.purge-ready:not(:disabled) {
    border-color: rgba(168, 85, 247, 0.46);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      0 0 0 1px rgba(168, 85, 247, 0.18),
      0 16px 22px rgba(0, 0, 0, 0.22);
  }

  .fmod-action-btn.special-btn.active {
    border-color: rgba(251, 191, 36, 0.55);
    background: linear-gradient(180deg, rgba(73, 53, 16, 0.95), rgba(22, 18, 10, 0.98));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      0 0 0 1px rgba(251, 191, 36, 0.18),
      0 18px 24px rgba(0, 0, 0, 0.24);
  }

  .attack-visuals,
  .purge-visuals {
    display: flex;
    align-items: center;
    gap: 0.72rem;
    width: 100%;
    transition: opacity 0.24s ease, transform 0.24s ease, filter 0.24s ease;
  }

  .purge-visuals {
    position: absolute;
    inset: 0.92rem 0.95rem 0.9rem;
    justify-content: center;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
  }

  .fmod-action-btn.attack-btn.purge-ready .attack-visuals {
    opacity: 0;
    transform: translateY(-10px);
  }

  .fmod-action-btn.attack-btn.purge-ready .purge-visuals {
    opacity: 1;
    transform: translateY(0);
  }

  .btn-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.22rem;
    min-width: 0;
  }

  .btn-icon {
    flex-shrink: 0;
    width: 2.55rem;
    height: 2.55rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.95);
    transition: transform 0.22s ease, background-color 0.22s ease, box-shadow 0.22s ease;
  }

  .btn-icon svg {
    width: 1.32rem;
    height: 1.32rem;
  }

  .btn-kicker {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  .btn-label {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-transform: none;
    color: #f8fafc;
    line-height: 1.1;
  }

  .btn-hint {
    font-size: 0.84rem;
    line-height: 1.35;
    color: rgba(226, 232, 240, 0.72);
  }

  .btn-lock-overlay {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.44rem;
    border-radius: inherit;
    background: rgba(4, 8, 16, 0.44);
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
    color: rgba(226, 232, 240, 0.88);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
    z-index: 3;
  }

  .btn-lock-icon {
    width: 1.12rem;
    height: 1.12rem;
  }

  .btn-lock-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.44rem;
  }

  .btn-lock-label,
  .btn-lock-value {
    display: block;
  }

  .btn-lock-value {
    display: none;
  }

  .btn-lock-overlay[data-lock-state="countdown"] {
    flex-direction: column;
    gap: 0.18rem;
  }

  .btn-lock-overlay[data-lock-state="countdown"] .btn-lock-icon {
    display: none;
  }

  .btn-lock-overlay[data-lock-state="countdown"] .btn-lock-copy {
    flex-direction: column;
    gap: 0.1rem;
    text-align: center;
  }

  .btn-lock-overlay[data-lock-state="countdown"] .btn-lock-label {
    font-size: 0.58rem;
    letter-spacing: 0.2em;
  }

  .btn-lock-overlay[data-lock-state="countdown"] .btn-lock-value {
    display: block;
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    text-transform: none;
  }

  .fmod-action-btn:disabled .btn-lock-overlay {
    opacity: 1;
  }

  .fmod-action-btn:not(:disabled):hover .btn-icon {
    transform: translateY(-2px) scale(1.03);
    box-shadow:
      0 10px 18px rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .fmod-action-btn.special-btn.active .btn-icon {
    animation: special-icon-glow 1.8s ease-in-out infinite;
  }

  @keyframes special-icon-glow {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.07);
    }
  }

  .btn-glaze {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 18%, rgba(255, 255, 255, 0.08) 50%, transparent 82%);
    transform: translateX(-120%);
    transition: transform 0.55s ease;
    pointer-events: none;
  }

  .fmod-action-btn:not(:disabled):hover .btn-glaze {
    transform: translateX(120%);
  }

  .fmod-game-controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .fmod-game-controls .fmod-btn {
    min-height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1rem;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #f8fafc;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    background: rgba(255, 255, 255, 0.04);
    box-shadow: none;
  }

  .fmod-game-controls .play-btn {
    background: linear-gradient(180deg, rgba(var(--accent-color-rgb), 0.36), rgba(var(--accent-color-rgb), 0.18));
  }

  .fmod-game-controls .stop-btn {
    background: linear-gradient(180deg, rgba(153, 27, 27, 0.36), rgba(63, 14, 14, 0.24));
  }

  .fmod-game-controls .reset-btn {
    background: linear-gradient(180deg, rgba(71, 85, 105, 0.36), rgba(20, 26, 38, 0.22));
  }

  .fmod-game-controls .fmod-btn:not(:disabled):hover {
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.14);
  }

  .fmod-player-actions {
    display: flex;
    justify-content: flex-start;
    margin-top: 0.05rem;
    position: relative;
    z-index: 2;
  }

  .fmod-player-kill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.64rem 0.88rem;
    border-radius: 999px;
    border: 1px solid rgba(239, 68, 68, 0.28);
    background:
      linear-gradient(180deg, rgba(120, 23, 23, 0.46), rgba(55, 13, 13, 0.58));
    color: #fee2e2;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 10px 24px rgba(0, 0, 0, 0.22);
    cursor: pointer;
    position: relative;
    z-index: 1;
  }

  .fmod-player-kill-btn:not(:disabled):hover {
    transform: translateY(-1px);
    border-color: rgba(248, 113, 113, 0.38);
    background:
      linear-gradient(180deg, rgba(148, 26, 26, 0.56), rgba(73, 15, 15, 0.7));
  }

  .fmod-figure-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(var(--accent-color-rgb), 0.16), rgba(255, 255, 255, 0.04));
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(248, 250, 252, 0.72);
  }

  .fmod-figure-fallback-mob {
    border-radius: 999px;
  }

  @media (max-width: 1180px) {
    .fmod-stage-boss-hud {
      top: 0.8rem;
      width: calc(100% - 1.8rem);
    }

    .fmod-stage-player {
      width: min(33%, 210px);
    }

    .fmod-stage-player-hud {
      left: clamp(6.25rem, 17vw, 11rem);
      width: min(40%, 290px);
    }

    .fmod-boss-container {
      right: 1rem;
      width: min(33%, 250px);
      transform: scale(0.92);
    }
  }

  @media (max-width: 899px) {
    .fmod-action-bar,
    .fmod-game-controls {
      grid-template-columns: 1fr;
    }

    .fmod-stage {
      min-height: 420px;
    }

    .fmod-stage-boss-hud {
      top: 0.7rem;
      width: calc(100% - 1.4rem);
    }

    .fmod-stage-player {
      width: min(34%, 180px);
      left: 0.85rem;
      bottom: 0.8rem;
    }

    .fmod-stage-player-hud {
      left: calc(34% + 1rem);
      right: 0.85rem;
      bottom: 0.95rem;
      width: auto;
      max-width: 270px;
    }

    .fmod-boss-container {
      right: 0.85rem;
      width: min(40%, 220px);
      bottom: 0.95rem;
      transform: scale(0.9);
    }
  }

  @media (max-width: 640px) {
    .fmod-game-mode {
      border-radius: 22px;
      padding: 0.9rem;
    }

    .fmod-stage {
      min-height: 390px;
    }

    .fmod-stage-boss-hud {
      top: 0.58rem;
      width: calc(100% - 1rem);
      gap: 0.5rem;
      padding: 0.38rem 0.5rem;
    }

    .fmod-stage-boss-hud .health-value-display {
      min-width: 2.5ch;
      font-size: 0.96rem;
    }

    .fmod-stage-player {
      width: 36%;
      left: 0.5rem;
    }

    .fmod-boss-container {
      right: 0.35rem;
      width: 45%;
      bottom: 0.8rem;
      transform: scale(0.88);
    }

    .fmod-stage-player-hud {
      left: calc(36% + 0.7rem);
      right: 0.5rem;
      bottom: 0.8rem;
      max-width: none;
      gap: 0.45rem;
    }

    .fmod-stage-player-title {
      font-size: 0.88rem;
    }

    .fmod-stage-boss-hud {
      grid-template-columns: clamp(5rem, 22vw, 6.2rem) minmax(0, 1fr) auto;
    }

    .fmod-stage-boss-label {
      font-size: 0.78rem;
      letter-spacing: 0.05em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fmod-game-mode *,
    .fmod-game-mode *::before,
    .fmod-game-mode *::after {
      animation: none !important;
      transition-duration: 0.01ms !important;
      transition-delay: 0ms !important;
      scroll-behavior: auto !important;
    }
  }
  @media (max-width: 899px) {
    .fmod-card {
      grid-column: 1 / 9;
    }

    .fmod-card.fmod-game-mode {
      grid-row: 3;
    }

    .fmod-action-bar {
      grid-template-columns: 1fr;
    }
  }

