  .audio-main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  /* Control Container */
  .audio-controls {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1.25rem;
    position: relative;
    flex-shrink: 0;
  }

  /* Skip Buttons */
  .audio-skip-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--accent-color-rgb), 0.08);
    border: 1.5px solid rgba(var(--accent-color-rgb), 0.2);
    color: var(--accent-color);
    cursor: pointer;
    transition:
      background-color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  html[data-theme="dark"] .audio-skip-btn {
    background: rgba(var(--accent-color-rgb), 0.12);
    border-color: rgba(var(--accent-color-rgb), 0.25);
  }

  /* Skip button hover states */
  .audio-skip-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      rgba(var(--accent-color-rgb), 0.15) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .audio-skip-btn:hover::before {
    opacity: 1;
  }

  .audio-skip-btn:hover {
    background: rgba(var(--accent-color-rgb), 0.15);
    border-color: rgba(var(--accent-color-rgb), 0.4);
    transform: translateY(-2px);
  }

  .audio-skip-btn:active {
    transform: translateY(0);
  }

  /* Play Button - Hero Element */
  .audio-play-btn {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-color);
    border: none;
    color: var(--on-accent);
    cursor: pointer;
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      color 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    box-shadow:
      0 4px 16px rgba(var(--accent-color-rgb), 0.3),
      0 2px 8px rgba(var(--accent-color-rgb), 0.2);
  }

  /* Play button glow effect */
  .audio-play-btn::before {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      rgba(var(--accent-color-rgb), 0.4) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: -1;
    filter: blur(8px);
  }

  .audio-play-btn:hover::before {
    opacity: 1;
  }

  .audio-play-btn:hover {
    transform: translateY(-3px) scale(1.08);
    box-shadow:
      0 8px 24px rgba(var(--accent-color-rgb), 0.45),
      0 4px 12px rgba(var(--accent-color-rgb), 0.3);
  }

  .audio-play-btn:active {
    transform: translateY(-1px) scale(1.04);
  }

  /* Playing state animation */
  .audio-play-btn.playing::after {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid rgba(var(--accent-color-rgb), 0.4);
    animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(0.95);
      opacity: 1;
    }
    50% {
      transform: scale(1.05);
      opacity: 0.6;
    }
    100% {
      transform: scale(0.95);
      opacity: 1;
    }
  }

  .track-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
    min-width: 220px;
  }

  .track-label {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
