  .sampler-pad {
    border: none;
    border-radius: 20px;
    width: 110px;
    height: 110px;
    background: rgba(255, 255, 255, 0.05);
    color: #fafafa;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.55rem;
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 18px 35px rgba(2, 6, 23, 0.35);
  }

  .sampler-pad::before {
    content: "";
    position: absolute;
    inset: -20% -30%;
    background: radial-gradient(
      circle,
      rgba(var(--accent-color-rgb), 0.38),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .sampler-pad::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }

  .sampler-pad:hover::before,
  .sampler-pad.sampler-pad--active::before {
    opacity: 1;
  }

  .sampler-pad:hover {
    transform: translateY(-3px);
    box-shadow:
      0 30px 35px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .sampler-pad:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  html[data-theme="light"] .sampler-pad {
    background: rgba(15, 15, 20, 0.82);
    color: #f8fafc;
    box-shadow: 0 12px 25px rgba(15, 23, 42, 0.25);
  }

  .sampler-pad-name {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
  }

  .sampler-pad.is-playing .sampler-pad-name {
    color: rgba(255, 255, 255, 1);
    text-shadow: 0 0 15px rgba(var(--accent-color-rgb), 0.5);
  }

  .sampler-pad-led {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.5);
    transition: all 0.1s ease;
  }

  .sampler-pad.is-playing .sampler-pad-led {
    background: var(--accent-color);
    box-shadow:
      0 0 6px var(--accent-color),
      0 0 10px var(--accent-color);
  }

  .sampler-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .sampler-regenerate-btn {
    border: none;
    border-radius: 50%;
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.12);
    color: #f8fafc;
    transition: all 0.25s ease;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 18px 35px rgba(2, 6, 23, 0.35);
    position: relative;
  }

  .sampler-regenerate-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-3px);
  }

  .sampler-regenerate-btn svg {
    pointer-events: none;
    transform-origin: center;
  }

  .sampler-regenerate-btn.rotating svg {
    animation: sampler-regen-spin 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes sampler-regen-spin {
    0% {
      transform: rotate(0deg);
    }
    65% {
      transform: rotate(320deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  .sampler-pad--loading {
    animation: sampler-pad-loading-pulse 0.5s ease-in-out;
    pointer-events: none;
  }

  @keyframes sampler-pad-loading-pulse {
    0% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.3;
      transform: scale(0.95);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  html[data-theme="light"] .sampler-regenerate-btn {
    background: rgba(15, 15, 20, 0.85);
    color: #f8fafc;
  }

  .sampler-regenerate-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .audio-card::before,
  .audio-card::after {
    content: "";
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
    z-index: -1;
  }

  .audio-card::before {
    width: 320px;
    height: 320px;
    inset: -35% auto auto -10%;
    background: radial-gradient(
      circle,
      rgba(var(--accent-color-rgb), 0.35),
      transparent 65%
    );
    opacity: 0.4;
    filter: blur(20px);
  }

  .audio-card::after {
    width: 200px;
    height: 200px;
    inset: auto 25% -40% auto;
    background: radial-gradient(
      circle,
      rgba(var(--accent-color-rgb), 0.22),
      transparent 70%
    );
    opacity: 0.18;
    filter: blur(40px);
  }

  html[data-theme="dark"] .audio-card {
    background:
      radial-gradient(
        circle at 20% 20%,
        rgba(var(--accent-color-rgb), 0.35),
        rgba(13, 13, 17, 0.95)
      ),
      linear-gradient(160deg, rgba(7, 7, 10, 0.8), rgba(15, 15, 19, 0.9));
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow:
      0 35px 80px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  html[data-theme="dark"] .audio-card::before {
    opacity: 0.7;
    filter: blur(30px);
  }

  html[data-theme="dark"] .audio-card::after {
    opacity: 0.35;
    inset: auto 30% -35% auto;
    filter: blur(55px);
  }

  .audio-card-header {
