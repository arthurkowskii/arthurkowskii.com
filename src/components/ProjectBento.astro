          }>;
          parameters?: Array<{
            name: string;
            label?: string | { fr: string; en: string };
            min: number;
            max: number;
            step?: number;
            default: number;
          }>;
        };
        sampler?: {
          title?: string | { fr: string; en: string };
          description?: string | { fr: string; en: string };
          folder: string;
          samplePool: string[];
          volume?: number;
        };
      };
    };
  };
}

