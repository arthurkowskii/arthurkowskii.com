// Compute readable on-accent text color (white or black) based on contrast
function contrastRatio(l1, l2) {
  const lighter = Math.max(l1, l2);
  const darker = Math.min(l1, l2);
  return (lighter + 0.05) / (darker + 0.05);
}
const contrastWithWhite = contrastRatio(1, accentLum);
const contrastWithBlack = contrastRatio(0, accentLum);
const onAccentColor =
  contrastWithWhite >= contrastWithBlack ? "#ffffff" : "#000000";

// Compute readable on-accent text color for dark theme accent
const accentRgbObjDark = hexToRgb(accentColorDark);
const accentLumDark = relativeLuminance(accentRgbObjDark);
const contrastWithWhiteDark = contrastRatio(1, accentLumDark);
const contrastWithBlackDark = contrastRatio(0, accentLumDark);
const onAccentColorDark =
