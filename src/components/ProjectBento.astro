      padding: 1.75rem;
    }

    .audio-card-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .audio-controls {
      width: 100%;
      justify-content: center;
    }

    .track-meta {
      width: 100%;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .audio-skip-btn,
    .audio-play-btn,
    .audio-progress-bar,
    .audio-progress-fill {
      transition: none;
    }

    .audio-play-btn.playing::after {
      animation: none;
    }

    .audio-skip-btn:hover,
    .audio-play-btn:hover {
      transform: none;
    }
  }

  .tech-grid {
