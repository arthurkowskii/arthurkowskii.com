    align-items: stretch;
    justify-content: flex-end;
  }

  .fmod-card.fmod-game-mode .badge-initializing {
    background: rgba(234, 179, 8, 0.16);
    color: #ca8a04;
    border: 1px solid rgba(234, 179, 8, 0.3);
  }

  html[data-theme="dark"] .fmod-card.fmod-game-mode .badge-initializing {
    background: rgba(234, 179, 8, 0.2);
    color: #facc15;
  }

  .fmod-card.fmod-game-mode .badge-ready {
    background: rgba(22, 163, 74, 0.14);
    color: #15803d;
    border: 1px solid rgba(22, 163, 74, 0.28);
  }

  html[data-theme="dark"] .fmod-card.fmod-game-mode .badge-ready {
    color: #4ade80;
    background: rgba(22, 163, 74, 0.2);
  }

  .fmod-card.fmod-game-mode .badge-error {
    background: rgba(220, 38, 38, 0.12);
