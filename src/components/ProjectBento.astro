  .fmod-card.fmod-game-mode .fmod-start-btn--header {
    flex: 0 0 auto;
    width: 100%;
    min-height: 60px;
    align-items: center;
    justify-content: center;
    gap: 0.68rem;
    padding: 0.78rem 0.95rem;
    border: 1px solid rgba(var(--accent-color-rgb), 0.3);
    background:
      linear-gradient(180deg, rgba(var(--accent-color-rgb), 0.88), rgba(var(--accent-color-rgb), 0.76));
    box-shadow: var(--fmod-start-shadow);
    color: var(--on-accent);
    transition:
      transform 180ms ease,
      box-shadow 220ms ease;
  }

  .fmod-card.fmod-game-mode .fmod-start-btn--header .ctrl-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .fmod-card.fmod-game-mode .fmod-start-btn--header .ctrl-icon {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.2);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
    flex-shrink: 0;
  }

  .fmod-card.fmod-game-mode .fmod-start-btn--header .ctrl-icon svg {
    width: 1.18rem;
    height: 1.18rem;
  }

  .fmod-card.fmod-game-mode .fmod-start-btn--header .ctrl-icon-stop {
    display: none;
  }

  .fmod-card.fmod-game-mode .fmod-start-btn--header.is-running .ctrl-icon-play {
    display: none;
  }

  .fmod-card.fmod-game-mode .fmod-start-btn--header.is-running .ctrl-icon-stop {
    display: block;
  }

  .fmod-card.fmod-game-mode .fmod-start-btn--header .ctrl-label {
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .fmod-card.fmod-game-mode .fmod-start-btn--header:not(:disabled):hover {
    transform: translateY(-1px);
    box-shadow:
      0 18px 30px rgba(var(--accent-color-rgb), 0.26),
      inset 0 1px 0 rgba(255, 255, 255, 0.26);
  }

  .fmod-card.fmod-game-mode .fmod-start-btn--header[disabled] {
    opacity: 0.72;
    cursor: wait;
    filter: saturate(0.84);
    box-shadow:
      0 10px 18px rgba(var(--accent-color-rgb), 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }

  .fmod-card.fmod-game-mode .fmod-start-btn--header.is-running {
    background:
      linear-gradient(180deg, rgba(220, 38, 38, 0.92), rgba(127, 29, 29, 0.82));
    border-color: rgba(252, 165, 165, 0.38);
    cursor: pointer;
  }

  .fmod-card.fmod-game-mode .fmod-start-btn--header.is-running .ctrl-icon {
    background: rgba(255, 255, 255, 0.14);
  }

  .fmod-card.fmod-game-mode .fmod-start-btn--header.is-running:not(:disabled):hover {
