function getFmodBankVersion(folder, banks) {
  if (!folder || !Array.isArray(banks) || banks.length === 0) return "";

  try {
    const versionHash = createHash("sha256");
    banks.forEach((bankFile) => {
      const bankUrl = new URL(
        `../../public/fmod/${folder}/${bankFile}`,
        import.meta.url,
      );
      versionHash.update(bankFile);
      versionHash.update(readFileSync(bankUrl));
    });
    return versionHash.digest("hex").slice(0, 12);
  } catch {
    return "";
  }
}

