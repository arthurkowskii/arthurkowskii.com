    --fmod-action-disabled-border: rgba(148, 163, 184, 0.34);
    --fmod-action-disabled-text: rgba(71, 85, 105, 0.9);
    --fmod-action-icon-bg: rgba(15, 23, 42, 0.08);
    --fmod-action-icon-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
