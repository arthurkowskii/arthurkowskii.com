    max-width: 25ch;
  }

  .fmod-card.fmod-game-mode .fmod-header-actions {
    display: flex;
    gap: 0.65rem;
    align-items: stretch;
    justify-content: flex-end;
    justify-self: end;
    width: auto;
    min-width: 0;
  }

  .fmod-card.fmod-game-mode .fmod-header-transport-slot {
    flex: 0 0 clamp(10.25rem, 15vw, 11rem);
