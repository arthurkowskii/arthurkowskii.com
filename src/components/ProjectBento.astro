      grid-row: 4;
    }
    .spotify-card-replaces-tech {
      grid-column: 1 / 7;
      grid-row: 3;
      padding: 0;
    }
    .spotify-card-after-tech {
      grid-column: 1 / 7;
      grid-row: 4;
      padding: 0;
    }
    .soundcloud-card-small-replaces-tech {
      grid-column: 1 / 7;
      grid-row: 3;
      padding: 0;
    }
    .soundcloud-card-small-after-tech {
      grid-column: 1 / 7;
      grid-row: 4;
      padding: 0;
    }
    .soundcloud-card-large {
      grid-column: 1 / 7;
      grid-row: 4;
      padding: 0;
    }
    .audio-card {
      grid-column: 1 / 7;
      grid-row: 8;
    }
    .sampler-card {
      grid-column: 1 / 7;
      grid-row: 9;
    }
    .gallery-card {
      grid-column: 1 / 7;
      grid-row: 5;
      min-height: 200px;
    }

    /* Mobile landscape - use 2 columns for readability */
    .gallery-card .gallery-thumbnails {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      min-height: 80px;
    }
    .challenges-card {
      grid-column: 1 / 7;
      grid-row: 6;
    }
    .results-card {
      grid-column: 1 / 7;
      grid-row: 7;
    }

    .hero-title {
      font-size: 1.8rem;
    }

    .card-title {
      font-size: 1.2rem;
    }
  }

  /* Mobile Portrait (320px - 499px) */
  @media (max-width: 499px) {
    .project-bento {
      padding-top: 5rem; /* Extra space for close button on mobile */
    }

    .bento-container {
      grid-template-columns: 1fr;
      gap: 0.8rem;
      padding: 0.8rem;
    }

    .bento-card {
      grid-column: 1 !important;
      grid-row: auto !important;
      padding: 1.2rem;
    }

    .hero-card {
      min-height: 200px;
      align-items: center;
      text-align: center;
    }

    .hero-title {
      font-size: 1.6rem;
    }

    .hero-description {
      font-size: 1rem;
    }

    .card-title {
      font-size: 1.1rem;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .tech-grid {
      justify-content: center;
    }

    /* Mobile portrait - hide thumbnails, show only hero */
    .gallery-card .gallery-thumbnails {
      display: none;
    }

    .gallery-card .gallery-hero {
      min-height: 120px;
    }

    .action-buttons {
      flex-direction: column;
    }
  }
</style>

<style is:global>
  /* Gallery Lightbox (global) */
  html.glb-scroll-lock,
  html.glb-scroll-lock body {
    overflow: hidden !important;
  }
  .glb-root {
    position: fixed;
    inset: 0;
    display: none;
    z-index: 10002;
  }
  .glb-scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .glb-container {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(90vw, 1100px);
    height: min(90vh, 750px);
    background: rgba(11, 12, 15, 0.65);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.6),
      0 8px 32px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    display: grid;
    grid-template-columns: 56px 1fr 56px;
    grid-template-rows: 1fr 40px;
    z-index: 10003;
    color: #fff;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* Keep media in center column so nav buttons never overlay it */
  .glb-viewport {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 18px 18px 8px;
  }
  .glb-counter {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.9;
    font-size: 0.9rem;
  }
  .glb-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10004;
    border: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .glb-close:hover {
    background: rgba(0, 0, 0, 0.6);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .glb-nav {
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    font-size: 32px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 8px;
    transition: color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .glb-prev {
    grid-column: 1;
    grid-row: 1;
  }
  .glb-next {
    grid-column: 3;
    grid-row: 1;
  }
  .glb-nav:hover {
    color: #fff;
  }
  /* Cross-browser fallbacks for backdrop-filter */
  @supports not (backdrop-filter: blur(1px)) {
    .glb-scrim {
      background: rgba(0, 0, 0, 0.8);
    }
    .glb-container {
      background: rgba(11, 12, 15, 0.95);
    }
    .glb-close {
      background: rgba(0, 0, 0, 0.7);
    }
    .glb-nav {
      background: transparent;
    }
  }

  /* Light theme adjustments */
  html[data-theme="light"] .glb-scrim {
    background: rgba(255, 255, 255, 0.2);
  }

  html[data-theme="light"] .glb-container {
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.2),
      0 8px 32px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    color: #1a1a1a;
  }

  html[data-theme="light"] .glb-close {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(0, 0, 0, 0.1);
    color: #1a1a1a;
  }

  html[data-theme="light"] .glb-close:hover {
    background: rgba(255, 255, 255, 0.8);
    border-color: rgba(0, 0, 0, 0.2);
  }

  html[data-theme="light"] .glb-nav {
    background: transparent;
    color: rgba(0, 0, 0, 0.6);
  }

  html[data-theme="light"] .glb-nav:hover {
    color: #1a1a1a;
  }

  /* Light theme fallbacks */
  @supports not (backdrop-filter: blur(1px)) {
    html[data-theme="light"] .glb-scrim {
      background: rgba(255, 255, 255, 0.9);
    }
    html[data-theme="light"] .glb-container {
      background: rgba(255, 255, 255, 0.98);
    }
    html[data-theme="light"] .glb-close {
      background: rgba(255, 255, 255, 0.9);
    }
    html[data-theme="light"] .glb-nav {
      background: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glb-container,
    .glb-scrim,
    .glb-close,
    .glb-nav {
      transition: none !important;
    }
  }
</style>

<div
  class={`project-bento ${hasCustomDarkAccent ? "has-custom-dark-accent" : ""}`}
>
  <div class="bento-container">
    <script
      type="application/json"
      class="bento-gallery-config"
      set:html={JSON.stringify(atomConfig.bentoGallery || {})}
    />
    <!-- Hero Card - Main banner with project info -->
    {
      cards.hero && (
        <div class="bento-card hero-card" style={heroStyle}>
          <div class="hero-bg">
            {assets.heroIsVideo ? (
              <video
                class="hero-bg-video"
                src={finalHeroUrl}
                poster={assets.heroThumbnail}
                autoplay
                muted
                loop
                playsinline
                aria-hidden="true"
                style={`object-position: ${heroBackgroundPosition}; transform: scale(${heroBackgroundScale || 1});`}
              />
            ) : (
              <img
                class="hero-bg-img"
                src={finalHeroUrl}
                alt=""
                aria-hidden="true"
                style={`object-position: ${heroBackgroundPosition}; transform: scale(${heroBackgroundScale || 1});`}
              />
            )}
            <div class="hero-overlay" />
          </div>
          <div class="hero-content">
            {heroLogoUrl && (bento.hero?.showLogo ?? true) && (
              <img
                src={heroLogoUrl}
                alt={`${data.title} Logo`}
                class="hero-logo"
                loading="lazy"
              />
            )}
            <h1 class="hero-title">{data.title}</h1>
            <p class="hero-description">{data.description}</p>
          </div>
        </div>
      )
    }

    {/* No SVG distortion; keep glass simple and clean */}

    <!-- Music Links (takes first slot; hides Stats when enabled) -->
    {
      hasMusicLinks && (
        <div class="bento-card music-links-card">
          <h3 class="card-title">
            {typeof bento.musicLinks?.title === "object"
              ? bento.musicLinks.title[
                  Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                ] ||
                bento.musicLinks.title.fr ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Music Links"
                  : "Liens Musicaux")
              : bento.musicLinks?.title ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Music Links"
                  : "Liens Musicaux")}
          </h3>
          <div class="music-links-grid">
            {bento.musicLinks.items.map((link) => {
              const key = inferPlatform(link.text, link.url);
              const icon = key ? MUSIC_ICONS[key] : undefined;
              const label = link.text || key || "Open link";
              return (
                <a
                  class="music-link-btn"
                  data-platform={key || "generic"}
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={label}
                  title={label}
                >
                  {icon ? (
                    <img src={icon} alt={`${label} logo`} loading="lazy" />
                  ) : (
                    <span class="music-link-text">{label}</span>
                  )}
                </a>
              );
            })}
          </div>
        </div>
      )
    }

    <!-- Quick Stats -->
    {
      !hasMusicLinks && cards.stats && bento.stats && (
        <div class="bento-card stats-card">
          <h3 class="card-title">
            {typeof bento.stats?.title === "object"
              ? bento.stats.title[
                  Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                ] ||
                bento.stats.title.fr ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Project Stats"
                  : "Infos Projet")
              : bento.stats?.title ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Project Stats"
                  : "Infos Projet")}
          </h3>
          <div class="stats-grid">
            {bento.stats.map((stat) => (
              <div class="stat-item">
                <span class="stat-value">{stat.value}</span>
                <span class="stat-label">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <!-- Action Buttons -->
    {
      cards.actions && bento.actions && (
        <div class="bento-card actions-card">
          <h3 class="card-title">
            {typeof bento.actions?.title === "object"
              ? bento.actions.title[
                  Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                ] ||
                bento.actions.title.fr ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Experience"
                  : "Expérience")
              : bento.actions?.title ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Experience"
                  : "Expérience")}
          </h3>
          {bento.actions.primary && (
            <a
              href={bento.actions.primary.url}
              target="_blank"
              class="action-btn primary"
            >
              {typeof bento.actions.primary.text === "object"
                ? bento.actions.primary.text[
                    Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                  ] || bento.actions.primary.text.fr
                : bento.actions.primary.text}
            </a>
          )}
          {bento.actions.secondary && (
            <button
              class="action-btn secondary"
              onclick={
                bento.actions.secondary.url
                  ? `window.open('${bento.actions.secondary.url}', '_blank')`
                  : undefined
              }
            >
              {typeof bento.actions.secondary.text === "object"
                ? bento.actions.secondary.text[
                    Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                  ] || bento.actions.secondary.text.fr
                : bento.actions.secondary.text}
            </button>
          )}
        </div>
      )
    }

    <!-- Technology Stack -->
    {
      cards.tech && (
        <div
          class={`bento-card ${cards.video && bento.video && cards.process && bento.process ? "tech-card-shifted" : "tech-card"}`}
        >
          <h3 class="card-title">
            {typeof bento.tech?.title === "object"
              ? bento.tech.title[
                  Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                ] ||
                bento.tech.title.en ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Technology"
                  : "Technologie")
              : bento.tech?.title ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Technology"
                  : "Technologie")}
          </h3>
          <p class="card-subtitle">
            {Astro.url.searchParams.get("lang") === "en"
              ? "Tools and technologies used"
              : "Outils et technologies utilisés"}
          </p>
          <div class="tech-grid">
            {data.tech.map((tech) => (
              <span class="tech-pill">{tech}</span>
            ))}
          </div>
        </div>
      )
    }

    <!-- Spotify Card - Conditional positioning based on tech card -->
    {
      cards.spotify && bento.spotify && (
        <div
          class={`bento-card ${cards.tech ? "spotify-card-after-tech" : "spotify-card-replaces-tech"}`}
        >
          {getSpotifyEmbedUrl(bento.spotify.url) ? (
            <iframe
              class="spotify-embed"
              src={getSpotifyEmbedUrl(bento.spotify.url)}
              title={
                bento.spotify.title || generateSpotifyTitle(bento.spotify.url)
              }
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              referrerpolicy="strict-origin-when-cross-origin"
              sandbox="allow-scripts allow-same-origin allow-presentation allow-popups"
              loading="lazy"
            />
          ) : (
            <div
              class="spotify-embed"
              style="display: flex; align-items: center; justify-content: center; color: #666;"
            >
              <span>Unsupported Spotify URL</span>
            </div>
          )}
        </div>
      )
    }

    <!-- SoundCloud Card - Small and Large size variants -->
    {
      cards.soundcloud && bento.soundcloud && (
        <div
          class={`bento-card ${
            bento.soundcloud.large
              ? "soundcloud-card-large"
              : cards.tech
                ? "soundcloud-card-small-after-tech"
                : "soundcloud-card-small-replaces-tech"
          }`}
        >
          {getSoundCloudEmbedUrl(bento.soundcloud.url) ? (
            <iframe
              class="soundcloud-embed"
              src={getSoundCloudEmbedUrl(bento.soundcloud.url)}
              title={
                bento.soundcloud.title ||
                generateSoundCloudTitle(bento.soundcloud.url)
              }
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              referrerpolicy="strict-origin-when-cross-origin"
              sandbox="allow-scripts allow-same-origin allow-presentation allow-popups"
              loading="lazy"
            />
          ) : (
            <div
              class="soundcloud-embed"
              style="display: flex; align-items: center; justify-content: center; color: #666;"
            >
              <span>Unsupported SoundCloud URL</span>
            </div>
          )}
        </div>
      )
    }

    <!-- Development Process -->
    {
      cards.process && bento.process && (
        <div class="bento-card process-card">
          <h3 class="card-title">
            {typeof bento.process?.title === "object"
              ? bento.process.title[
                  Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                ] ||
                bento.process.title.fr ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Process"
                  : "Processus")
              : bento.process?.title ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Process"
                  : "Processus")}
          </h3>
          {bento.process.subtitle && (
            <p class="card-subtitle">
              {typeof bento.process.subtitle === "object"
                ? bento.process.subtitle[
                    Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                  ] || bento.process.subtitle.fr
                : bento.process.subtitle}
            </p>
          )}
          <ul class="process-list">
            {bento.process.steps.map((step, index) => (
              <li class="process-item">
                <span class="process-number">{index + 1}</span>
                <span class="process-text">
                  {typeof step === "object"
                    ? step[
                        Astro.url.searchParams.get("lang") === "en"
                          ? "en"
                          : "fr"
                      ] || step.fr
                    : step}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- Video Card - Conditional positioning based on process card -->
    {
      cards.video && bento.video && (
        <div
          class={`bento-card ${cards.process && bento.process ? "video-card-after-process" : "video-card-replaces-process"}`}
        >
          {getVideoEmbedUrl(bento.video.url) ? (
            <iframe
              class="video-embed"
              src={getVideoEmbedUrl(bento.video.url)}
              title={
                bento.video.title ||
                generateVideoTitle(
                  bento.video.url,
                  Astro.url.searchParams.get("lang") === "en" ? "en" : "fr",
                )
              }
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              sandbox="allow-scripts allow-same-origin allow-presentation allow-popups"
              loading="lazy"
              allowfullscreen
            />
          ) : (
            <div
              class="video-embed"
              style="display: flex; align-items: center; justify-content: center; color: #666;"
            >
              <span>Unsupported video URL</span>
            </div>
          )}
          <h3 class="card-title">
            {typeof bento.video?.title === "object"
              ? bento.video.title[
                  Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                ] ||
                bento.video.title.fr ||
                generateVideoTitle(
                  bento.video.url,
                  Astro.url.searchParams.get("lang") === "en" ? "en" : "fr",
                )
              : bento.video?.title ||
                generateVideoTitle(
                  bento.video.url,
                  Astro.url.searchParams.get("lang") === "en" ? "en" : "fr",
                )}
          </h3>
          {bento.video.description && (
            <p class="video-description">{bento.video.description}</p>
          )}
        </div>
      )
    }

    <!-- Gallery -->
    {
      cards.gallery && galleryImages && galleryImages.length > 0 && (
        <div class="bento-card gallery-card">
          <h3 class="card-title">
            {typeof bento.gallery?.title === "object"
              ? bento.gallery.title[
                  Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                ] ||
                bento.gallery.title.en ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Gallery"
                  : "Galerie")
              : bento.gallery?.title ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Gallery"
                  : "Galerie")}
          </h3>
          <div class="gallery-grid">
            {galleryImages[0] && (
              <div
                class="gallery-hero"
                data-gallery-index="0"
                tabindex="0"
                role="button"
                aria-label="Open image"
                data-full-src={galleryImages[0].fullSrc || galleryImages[0].src}
              >
                {galleryImages[0].isVideo ? (
                  <video
                    src={galleryImages[0].src}
                    muted
                    loop
                    autoplay
                    playsinline
                    loading="lazy"
                    style="width: 100%; height: 100%; object-fit: cover;"
                  />
                ) : (
                  <img
                    src={galleryImages[0].src}
                    alt={galleryImages[0].alt || "Gallery image"}
                    loading="lazy"
                  />
                )}
                <div class="gallery-counter">
                  {galleryImages.length}{" "}
                  {galleryImages.length === 1
                    ? galleryImages[0].isVideo
                      ? "video"
                      : "image"
                    : "items"}
                </div>
              </div>
            )}
            {galleryImages.length > 1 && (
              <div class="gallery-thumbnails">
                {galleryImages.slice(1).map((image, i) => (
                  <div
                    class="gallery-thumb"
                    data-gallery-index={String(i + 1)}
                    tabindex="0"
                    role="button"
                    aria-label="Open image"
                    data-full-src={image.fullSrc || image.src}
                  >
                    {image.isVideo ? (
                      <video
                        src={image.src}
                        muted
                        loop
                        autoplay
                        playsinline
                        loading="lazy"
                        style="width: 100%; height: 100%; object-fit: cover;"
                      />
                    ) : (
                      <img
                        src={image.src}
                        alt={image.alt || "Gallery image"}
                        loading="lazy"
                      />
                    )}
                  </div>
                ))}
              </div>
            )}
            <script
              type="application/json"
              class="gallery-data"
              set:html={JSON.stringify(galleryImages)}
            />
          </div>
        </div>
      )
    }

    <!-- Technical Challenges -->
    {
      cards.challenges && bento.challenges && (
        <div class="bento-card challenges-card">
          <h3 class="card-title">
            {typeof bento.challenges?.title === "object"
              ? bento.challenges.title[
                  Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                ] ||
                bento.challenges.title.fr ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Key Challenges"
                  : "Défis Clés")
              : bento.challenges?.title ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Key Challenges"
                  : "Défis Clés")}
          </h3>
          {bento.challenges.subtitle && (
            <p class="card-subtitle">
              {typeof bento.challenges.subtitle === "object"
                ? bento.challenges.subtitle[
                    Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                  ] || bento.challenges.subtitle.fr
                : bento.challenges.subtitle}
            </p>
          )}

          <ul class="challenges-list">
            {bento.challenges.items.map((challenge) => (
              <li class="challenge-item">
                <div class="challenge-title">
                  {typeof challenge.title === "object"
                    ? challenge.title[
                        Astro.url.searchParams.get("lang") === "en"
                          ? "en"
                          : "fr"
                      ] || challenge.title.fr
                    : challenge.title}
                </div>
                <div class="challenge-text">
                  {typeof challenge.description === "object"
                    ? challenge.description[
                        Astro.url.searchParams.get("lang") === "en"
                          ? "en"
                          : "fr"
                      ] || challenge.description.fr
                    : challenge.description}
                </div>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- Results & Impact -->
    {
      cards.results && bento.results && (
        <div class="bento-card results-card">
          <h3 class="card-title">
            {typeof bento.results?.title === "object"
              ? bento.results.title[
                  Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                ] ||
                bento.results.title.fr ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Results"
                  : "Résultats")
              : bento.results?.title ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Results"
                  : "Résultats")}
          </h3>
          {bento.results.subtitle && (
            <p class="card-subtitle">{bento.results.subtitle}</p>
          )}

          <ul class="results-list">
            {bento.results.items.map((result) => (
              <li class="results-item">
                <span class="results-icon">{result.icon}</span>
                <span class="results-text">{result.text}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- Audio Player Card - New Design -->
    {
      cards.audio && bento.audio && (
        <div
          class="bento-card audio-card"
          data-project-slug={project.slug}
          data-tracks={JSON.stringify(bento.audio.tracks)}
        >
          <div class="audio-card-header">
            <span class="audio-badge">
              {Astro.url.searchParams.get("lang") === "en"
                ? "Audio Capsule"
                : "Capsule Audio"}
            </span>
            <p class="audio-heading">
              {Astro.url.searchParams.get("lang") === "en"
                ? "Play a random track from this project"
                : "Jouer une piste aléatoire de ce projet"}
            </p>
          </div>

          <div class="audio-main">
            <div class="audio-controls">
              <button
                class="audio-skip-btn prev-btn"
                aria-label="Previous track"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  fill="currentColor"
                >
                  <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
                </svg>
              </button>

              <button class="audio-play-btn" aria-label="Play">
                <svg
                  class="play-icon"
                  viewBox="0 0 24 24"
                  width="28"
                  height="28"
                  fill="currentColor"
                >
                  <path d="M8 5v14l11-7z" />
                </svg>
                <svg
                  class="pause-icon"
                  viewBox="0 0 24 24"
                  width="28"
                  height="28"
                  fill="currentColor"
                  style="display:none"
                >
                  <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z" />
                </svg>
              </button>

              <button class="audio-skip-btn next-btn" aria-label="Next track">
                <svg
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  fill="currentColor"
                >
                  <path d="M16.5 12l-8.5-6v12l8.5-6zm1 6h2V6h-2v12z" />
                </svg>
              </button>
            </div>

            <div class="track-meta">
              <span class="track-label">
                {Astro.url.searchParams.get("lang") === "en"
                  ? "Now playing"
                  : "Lecture en cours"}
              </span>
              <p class="track-name">...</p>
            </div>
          </div>

          <div class="audio-progress-group">
            <div class="audio-progress-section">
              <div class="audio-progress-bar">
                <div class="audio-progress-fill" />
              </div>
            </div>

            <div class="audio-times">
              <span class="time-current">0:00</span>
              <span class="time-total">0:00</span>
            </div>
          </div>
        </div>
      )
    }

    {/* Sample Player Card */}
    {
      cards.sampler && bento.sampler && (
        <div
          class:list={[
            "bento-card",
            "sampler-card",
            { "sampler-card-wide": isWideSampler },
          ]}
          data-folder={bento.sampler.folder}
          data-samples={JSON.stringify(bento.sampler.samplePool || [])}
        >
          <div class="sampler-header">
            <div class="sampler-title">
              {(typeof bento.sampler.title === "object"
                ? bento.sampler.title[
                    Astro.url.searchParams.get("lang") === "en" ? "en" : "fr"
                  ] || bento.sampler.title.fr
                : bento.sampler.title) ||
                (Astro.url.searchParams.get("lang") === "en"
                  ? "Sample Player"
                  : "Lecteur de Samples")}
            </div>
          </div>

          <div class="sampler-content">
            <div class="sampler-grid">
              <div class="sampler-pad-row">
                {Array.from({ length: Math.ceil(numPads / 2) }).map(
                  (_, index) => (
                    <button class="sampler-pad" data-pad-index={index} disabled>
                      <div class="sampler-pad-led" />
                      <span class="sampler-pad-name">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                    </button>
                  ),
                )}
              </div>
              <div class="sampler-pad-row">
                {Array.from({ length: Math.floor(numPads / 2) }).map(
                  (_, index) => (
                    <button
                      class="sampler-pad"
                      data-pad-index={index + Math.ceil(numPads / 2)}
                      disabled
                    >
                      <div class="sampler-pad-led" />
                      <span class="sampler-pad-name">
                        {String(index + Math.ceil(numPads / 2) + 1).padStart(
                          2,
                          "0",
                        )}
                      </span>
                    </button>
                  ),
                )}
              </div>
            </div>

            <div class="sampler-controls">
              <button
                class="sampler-regenerate-btn"
                type="button"
                aria-label={
                  Astro.url.searchParams.get("lang") === "en"
                    ? "Regenerate samples"
                    : "Régénérer les samples"
                }
              >
                <svg
                  viewBox="0 0 24 24"
                  width="22"
                  height="22"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M17.65 6.35A7.95 7.95 0 0012 4a8 8 0 100 16 8 8 0 007.45-5.07 1 1 0 00-1.88-.66A6 6 0 1112 6a5.96 5.96 0 014.24 1.76l-1.99 1.99H21V4.75l-3.35 3.35z" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      )
    }
  </div>
</div>

<script is:inline>
  // PLACEHOLDER: Tone.js is temporary - will be replaced with custom OGG audio files
  // See docs/history/PHASE_LOGS.md Phase 3C for audio architecture plan
  // Note: Using is:inline to ensure single global scope for all ProjectBento instances

  // Guard against multiple initializations
  if (typeof window.__bentoInitialized === "undefined") {
    window.__bentoInitialized = false;
  }

  // Gallery lightbox: lazy-loaded on first click for reliability across contexts
  // Use window to ensure single instance across all script executions
  if (typeof window.__GLB === "undefined") {
    window.__GLB = null;
  }

  if (typeof window.ensureLightbox === "undefined") {
    window.ensureLightbox = async function () {
      if (!window.__GLB) {
        try {
          const mod = await import("../atom/ui/GalleryLightbox.js");
          window.__GLB = mod?.default || mod;
        } catch (err) {
          console.warn("Failed to load GalleryLightbox module:", err);
        }
      }
      return window.__GLB;
    };
  }

  // Avoid redeclaration errors when multiple bento components are rendered
  if (typeof ensureLightbox === "undefined") {
    var ensureLightbox = window.ensureLightbox;
  }

  // Simple Bento Animation System with Synced Audio
  // Audio is strictly gated behind a real user gesture to avoid
  // "AudioContext was not allowed to start" errors in browsers.
  if (typeof window.__audioUnlocked === "undefined") {
    window.__audioUnlocked = true;
  }

  // Define BentoAnimationSystem class only once
  if (typeof window.BentoAnimationSystem === "undefined") {
    window.BentoAnimationSystem = class BentoAnimationSystem {
      constructor() {
        this.isInitialized = false;
        this.synth = null;
        this.chorus = null;
        this.config = null;
        this.isPlaying = false;
      }

      async init() {
        if (this.isInitialized) return;

        try {
          // Always set config with fallback
          this.config = {
            enabled: true,
            staggerDelayMs: 80,
            animationDurationMs: 400,
            easing: "cubic-bezier(0.34, 1.56, 0.64, 1)",
            cardEnabled: {
              hero: true,
              stats: true,
              actions: true,
              tech: true,
              gallery: true,
              process: true,
              challenges: true,
              results: true,
            },
            audio: {
              enabled: false,
              volume: 0.4,
              syncWithAnimation: true,
              pitches: {
                hero: "C3",
                stats: "E3",
                actions: "G3",
                tech: "C4",
                gallery: "E4",
                process: "G4",
                challenges: "B3",
                results: "D4",
              },
              synthesis: {
                attack: 0.01,
                decay: 0.3,
                sustain: 0,
                release: 0.8,
                chorus: { frequency: 4, depth: 0.3 },
              },
            },
          };

          // Override with global config if available
          if (window.atomConfig?.bentoAnimations) {
            this.config = {
              ...this.config,
              ...window.atomConfig.bentoAnimations,
            };
          }

          // Hard-disable audio placeholder until Tone.js migration completes
          if (this.config.audio) {
            this.config.audio.enabled = false;
          } else {
            this.config.audio = { enabled: false };
          }

          if (!this.config.audio?.enabled) {
            this.isInitialized = true;
            return;
          }

          // PLACEHOLDER: Audio will be replaced with custom OGG files + Web Audio API
          // Only create audio objects when actually needed (defer until user interaction)
          console.log(
            "ðŸŽµ Bento Animation System initialized (audio deferred until user interaction)",
          );
          this.isInitialized = true;
        } catch (error) {
          console.warn("Failed to initialize Bento system:", error);
        }
      }

      async initAudio() {
        return;
      }

      getCardType(card) {
        // Determine card type from classes
        if (card.classList.contains("hero-card")) return "hero";
        if (card.classList.contains("music-links-card")) return "stats";
        if (card.classList.contains("stats-card")) return "stats";
        if (card.classList.contains("actions-card")) return "actions";
        if (card.classList.contains("tech-card")) return "tech";
        if (card.classList.contains("gallery-card")) return "gallery";
        if (card.classList.contains("process-card")) return "process";
        if (card.classList.contains("challenges-card")) return "challenges";
        if (card.classList.contains("results-card")) return "results";
        return "hero"; // fallback
      }

      async ensureAudioReady() {
        return;
      }

      animateCard(card, cardType, index) {
        if (!this.config) return; // Safety check

        const isEnabled = this.config.cardEnabled?.[cardType] ?? true;
        if (!isEnabled) return;

        // Set CSS custom properties
        card.style.setProperty(
          "--duration",
          `${this.config.animationDurationMs}ms`,
        );
        card.style.setProperty("--easing", this.config.easing);

        // Reset any existing classes
        card.classList.remove("animate-in");

        const delay = index * this.config.staggerDelayMs;

        setTimeout(() => {
          card.classList.add("animate-in");
        }, delay);
      }

      async startAnimation() {
        console.log("ðŸŽµ startAnimation() called", {
          isPlaying: this.isPlaying,
        });

        if (this.isPlaying) {
          console.log("ðŸŽµ Already playing, returning early");
          return;
        }
        this.isPlaying = true;

        // Ensure config is loaded first
        if (!this.config) {
          await this.init();
        }

        // Ensure audio is ready only if unlocked; otherwise animations proceed silently
        if (this.config?.audio?.enabled) {
          await this.ensureAudioReady();
        }

        // Only select cards from the currently visible bento project
        const visibleBentoProject = document.querySelector(
          '#bento-content .bento-project[style*="display: block"]',
        );
        const cards = visibleBentoProject
          ? visibleBentoProject.querySelectorAll(".bento-card")
          : [];

        console.log(
          `ðŸŽµ Starting bento animation for ${cards.length} cards (audio: ${this.config.audio?.enabled})`,
        );
        console.log(
          `ðŸŽµ Visible project:`,
          visibleBentoProject?.dataset?.projectSlug || "none",
        );

        cards.forEach((card, index) => {
          const cardType = this.getCardType(card);
          this.animateCard(card, cardType, index);
        });

        // Reset playing flag after animation completes
        const totalTime =
          cards.length * this.config.staggerDelayMs +
          this.config.animationDurationMs +
          200;
        setTimeout(() => {
          this.isPlaying = false;
        }, totalTime);
      }

      reset() {
        console.log("ðŸŽµ reset() called");
        // Reset ALL bento cards (since we're closing/switching projects)
        const cards = document.querySelectorAll("#bento-content .bento-card");
        cards.forEach((card) => {
          card.classList.remove("animate-in");
        });
        this.isPlaying = false;
      }
    };
  } // Close the BentoAnimationSystem class definition wrapper

  // Global instance - use window to ensure single instance across all components
  if (
    typeof window !== "undefined" &&
    typeof window.bentoAnimationSystem === "undefined"
  ) {
    window.bentoAnimationSystem = null;
  }

  // ==========================
  // Minimal Lightbox (Step 1): Single-media viewer
  // ==========================

  // Wrap all remaining functions to prevent redeclaration in Firefox
  if (!window.__bentoFunctionsInitialized) {
    let __basicGlb = null;
    let __basicGlbOpen = false;
    let __basicLastFocus = null;
    let __basicItems = [];
    let __basicIndex = 0;
    const onBasicKey = (e) => {
      if (!__basicGlbOpen) return;
      if (e.key === "Escape") {
        e.stopPropagation();
        e.preventDefault();
        closeBasicLightbox();
      }
      if (e.key === "ArrowLeft") {
        e.stopPropagation();
        e.preventDefault();
        basicPrev();
      }
      if (e.key === "ArrowRight") {
        e.stopPropagation();
        e.preventDefault();
        basicNext();
      }
    };

    function ensureBasicLightbox() {
      if (__basicGlb) return __basicGlb;
      console.log("[GLB] creating basic lightbox DOM");
      const root = document.createElement("div");
      root.className = "glb-root";
      root.style.display = "none";

      const scrim = document.createElement("div");
      scrim.className = "glb-scrim";
      scrim.addEventListener("click", () => closeBasicLightbox());

      const container = document.createElement("div");
      container.className = "glb-container";
      container.style.display = "grid";

      const closeBtn = document.createElement("button");
      closeBtn.className = "glb-close";
      closeBtn.setAttribute("aria-label", "Close");
      closeBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
      <path fill="currentColor" d="M195.2 195.2a64 64 0 0190.496 0L512 421.504 738.304 195.2a64 64 0 0190.496 90.496L602.496 512 828.8 738.304a64 64 0 01-90.496 90.496L512 602.496 285.696 828.8a64 64 0 01-90.496-90.496L421.504 512 195.2 285.696a64 64 0 010-90.496z"/>
    </svg>`;
      closeBtn.addEventListener("click", () => closeBasicLightbox());

      const viewport = document.createElement("div");
      viewport.className = "glb-viewport";

      const counter = document.createElement("div");
      counter.className = "glb-counter";
      counter.textContent = "";

      const btnPrev = document.createElement("button");
      btnPrev.className = "glb-nav glb-prev";
      btnPrev.setAttribute("aria-label", "Previous");
      btnPrev.innerHTML = `<svg width="24" height="24" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
      <path fill="currentColor" d="M685.248 104.704a64 64 0 010 90.496L368.448 512l316.8 316.8a64 64 0 01-90.496 90.496L232.704 557.248a64 64 0 010-90.496l362.048-362.048a64 64 0 0190.496 0z"/>
    </svg>`;
      btnPrev.addEventListener("click", () => basicPrev());

      const btnNext = document.createElement("button");
      btnNext.className = "glb-nav glb-next";
      btnNext.setAttribute("aria-label", "Next");
      btnNext.innerHTML = `<svg width="24" height="24" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
      <path fill="currentColor" d="M338.752 104.704a64 64 0 0190.496 0l362.048 362.048a64 64 0 010 90.496L429.248 919.296a64 64 0 01-90.496-90.496L655.552 512 338.752 195.2a64 64 0 010-90.496z"/>
    </svg>`;
      btnNext.addEventListener("click", () => basicNext());

      container.appendChild(closeBtn);
      container.appendChild(btnPrev);
      container.appendChild(viewport);
      container.appendChild(btnNext);
      container.appendChild(counter);

      root.appendChild(scrim);
      root.appendChild(container);
      document.body.appendChild(root);
      console.log("[GLB] basic lightbox DOM appended to body");
      __basicGlb = {
        root,
        scrim,
        container,
        viewport,
        counter,
        closeBtn,
        btnPrev,
        btnNext,
      };
      return __basicGlb;
    }

    function renderBasicSlide() {
      const glb = __basicGlb || ensureBasicLightbox();
      if (!__basicItems.length) return;
      const item = __basicItems[__basicIndex];
      if (!item) return;
      // Pause any existing video
      try {
        glb.viewport.querySelector("video")?.pause();
      } catch {}
      glb.viewport.innerHTML = "";
      let el;
      if (item.isVideo) {
        el = document.createElement("video");
        el.src = item.src;
        el.controls = true;
        el.playsInline = true;
        el.style.maxWidth = "100%";
        el.style.maxHeight = "100%";
      } else {
        el = document.createElement("img");
        el.src = item.src;
        el.alt = item.alt || "";
        el.style.maxWidth = "100%";
        el.style.maxHeight = "100%";
        el.decoding = "async";
        el.loading = "eager";
      }
      glb.viewport.appendChild(el);
      glb.counter.textContent = `${__basicIndex + 1} / ${__basicItems.length}`;
      // Preload neighbors (images only)
      const prev =
        __basicItems[
          (__basicIndex - 1 + __basicItems.length) % __basicItems.length
        ];
      const next = __basicItems[(__basicIndex + 1) % __basicItems.length];
      [prev, next].forEach((n) => {
        if (n && !n.isVideo) {
          const img = new Image();
          img.src = n.src;
        }
      });
    }

    function basicPrev() {
      if (!__basicItems.length) return;
      __basicIndex =
        (__basicIndex - 1 + __basicItems.length) % __basicItems.length;
      renderBasicSlide();
    }
    function basicNext() {
      if (!__basicItems.length) return;
      __basicIndex = (__basicIndex + 1) % __basicItems.length;
      renderBasicSlide();
    }

    function openBasicLightboxWithItems(items, startIndex, returnEl) {
      const glb = ensureBasicLightbox();
      __basicItems = Array.isArray(items) ? items.slice() : [];
      __basicIndex = Math.min(
        Math.max(0, startIndex || 0),
        Math.max(0, __basicItems.length - 1),
      );
      __basicLastFocus = returnEl || document.activeElement;
      glb.root.style.display = "block";
      glb.root.setAttribute("aria-hidden", "false");
      document.documentElement.classList.add("glb-scroll-lock");
      __basicGlbOpen = true;
      renderBasicSlide();
      try {
        glb.closeBtn.focus({ preventScroll: true });
      } catch {}
      document.addEventListener("keydown", onBasicKey, true);
    }

    function closeBasicLightbox() {
      const glb = __basicGlb;
      if (!glb) return;
      __basicGlbOpen = false;
      glb.root.style.display = "none";
      glb.root.setAttribute("aria-hidden", "true");
      glb.viewport.innerHTML = "";
      document.documentElement.classList.remove("glb-scroll-lock");
      document.removeEventListener("keydown", onBasicKey, true);
      try {
        __basicLastFocus?.focus({ preventScroll: true });
      } catch {}
    }

    // Attach click handlers to open lightbox for each gallery card
    function setupGalleryClickHandlers(scope = document) {
      const cards = scope.querySelectorAll(".gallery-card");
      console.debug(
        "[GLB] setupGalleryClickHandlers: found cards =",
        cards.length,
      );
      cards.forEach((card) => {
        if (card.dataset.glbBound === "1") return;
        card.dataset.glbBound = "1";
        const dataEl = card.querySelector(".gallery-data");
        let fallbackItems = [];
        try {
          fallbackItems = JSON.parse(dataEl?.textContent || "[]");
        } catch (e) {
          console.warn("[GLB] JSON parse failed", e);
        }

        const clickables = card.querySelectorAll("[data-gallery-index]");
        console.debug(
          "[GLB] card bound. fallback items =",
          fallbackItems.length,
          "clickables =",
          clickables.length,
        );

        // Build full-resolution items from data attributes
        const fullResItems = Array.from(clickables)
          .sort((a, b) => {
            const aIdx = parseInt(
              a.getAttribute("data-gallery-index") || "0",
              10,
            );
            const bIdx = parseInt(
              b.getAttribute("data-gallery-index") || "0",
              10,
            );
            return aIdx - bIdx;
          })
          .map((el) => {
            const fullSrc = el.getAttribute("data-full-src");
            const fallbackIdx = parseInt(
              el.getAttribute("data-gallery-index") || "0",
              10,
            );
            const fallbackItem = fallbackItems[fallbackIdx] || {};

            return {
              src: fullSrc || fallbackItem.src,
              alt: fallbackItem.alt || "Gallery image",
              isVideo: fallbackItem.isVideo || false,
            };
          });

        const items = fullResItems.length > 0 ? fullResItems : fallbackItems;

        clickables.forEach((el) => {
          const idx =
            parseInt(el.getAttribute("data-gallery-index") || "0", 10) || 0;
          el.addEventListener(
            "click",
            async (e) => {
              e.preventDefault();
              e.stopPropagation();
              console.debug(
                "[GLB] click on index",
                idx,
                "items total",
                items.length,
              );
              if (items && items.length)
                openBasicLightboxWithItems(items, idx, el);
            },
            { passive: false },
          );
          el.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              el.click();
            }
          });
        });
      });
    }

    // ==========================
    // Gallery layout (dynamic rows)
    // - Thumbnails are a CSS grid (3 cols desktop, 2 cols mobile landscape)
    // - Show as many full rows as fit; hide the rest
    // ==========================
    function getGridColumnCount(el) {
      const style = getComputedStyle(el);
      const template = style.gridTemplateColumns;
      if (!template || template === "none") return 1;
      const m = template.match(/repeat\(\s*(\d+)\s*,/i);
      if (m) {
        const n = parseInt(m[1], 10);
        return Number.isFinite(n) && n > 0 ? n : 1;
      }
      return template.split(/\s+/).filter(Boolean).length;
    }

    // Config provider for gallery layout
    const DEFAULT_GALLERY_CFG = {
      extraRow1DeltaPx: 500,
      extraRow2DeltaPx: 800,
      heroMinHeightFallback: 120,
      maxRows: 3,
    };
    function getGalleryCfg(card) {
      try {
        if (window.atomConfig?.bentoGallery)
          return window.atomConfig.bentoGallery;
      } catch {}
      try {
        const root = card.closest(".project-bento") || document;
        const el = root.querySelector(".bento-gallery-config");
        if (el) {
          const parsed = JSON.parse(el.textContent || "{}");
          return { ...DEFAULT_GALLERY_CFG, ...parsed };
        }
      } catch {}
      return DEFAULT_GALLERY_CFG;
    }

    function layoutOneGallery(card) {
      try {
        const grid = card.querySelector(".gallery-grid");
        const thumbs = card.querySelector(".gallery-thumbnails");
        const hero = card.querySelector(".gallery-hero");
        if (!grid || !thumbs || !hero) return;

        const thumbsStyle = getComputedStyle(thumbs);
        if (thumbsStyle.display === "none") return; // hidden on mobile portrait

        const gridStyle = getComputedStyle(grid);
        const gapYGrid = parseFloat(gridStyle.gap) || 0;
        const gapX = parseFloat(thumbsStyle.columnGap || thumbsStyle.gap) || 0;

        const columns = Math.max(1, getGridColumnCount(thumbs));
        const width = thumbs.clientWidth;
        if (width <= 0) return;
        const tile = (width - (columns - 1) * gapX) / columns;
        if (!(tile > 0)) return;

        // Measure with thumbnails unconstrained to avoid self-limiting from prior runs
        const __prevH = thumbs.style.height;
        const __prevFlex = thumbs.style.flex;
        thumbs.style.height = "auto";
        thumbs.style.flex = "0 0 auto";
        void thumbs.offsetHeight; // force reflow

        // Available vertical space for thumbnails within the grid (unconstrained)
        const gridHeightAuto = grid.clientHeight;
        const available = gridHeightAuto - hero.clientHeight - gapYGrid;
        if (!(available > 0)) {
          // Restore and bail
          thumbs.style.height = __prevH;
          thumbs.style.flex = __prevFlex;
          return;
        }

        // Baseline rows using unconstrained measurement
        let rowsFit = Math.floor((available + gapX) / (tile + gapX));
        if (rowsFit < 1) rowsFit = 1; // always show at least one full row

        // Config-driven multi-row support (up to 3 rows by default)
        const cfg = getGalleryCfg(card);
        const heroStyle = getComputedStyle(hero);
        const heroMinH =
          parseFloat(heroStyle.minHeight || "0") ||
          (cfg.heroMinHeightFallback ?? 120);
        const maxAvailableWithHeroMin = Math.max(
          0,
          gridHeightAuto - heroMinH - gapYGrid,
        );
        const rowsWithMin = Math.floor(
          (maxAvailableWithHeroMin + gapX) / (tile + gapX),
        );

        // Per-card tallness relative to CSS min-height
        const cardStyle = getComputedStyle(card);
        const cardMinH = parseFloat(cardStyle.minHeight || "0") || 0;
        const cardHeight =
          card.clientHeight || parseFloat(cardStyle.height || "0") || 0;
        const delta = Math.max(0, cardHeight - cardMinH);
        let extraAllowed = 0;
        const d1 = cfg.extraRow1DeltaPx ?? 500;
        const d2 = cfg.extraRow2DeltaPx ?? 800;
        if (delta >= d2) extraAllowed = 2;
        else if (delta >= d1) extraAllowed = 1;

        const maxRows = cfg.maxRows ?? 3;
        const desired = Math.min(1 + extraAllowed, rowsWithMin, maxRows);
        rowsFit = Math.max(rowsFit, desired);

        const items = Array.from(thumbs.children);
        const visibleCount = Math.min(items.length, columns * rowsFit);
        for (let i = 0; i < items.length; i++) {
          const el = items[i];
          if (i < visibleCount) el.style.removeProperty("display");
          else el.style.display = "none";
        }

        // Fix the container height to exactly fit the number of full rows
        const rowsHeight = rowsFit * tile + (rowsFit - 1) * gapX;
        thumbs.style.height = rowsHeight + "px";
        thumbs.style.flex = `0 0 ${rowsHeight}px`;

        thumbs.setAttribute("data-rows", String(rowsFit));
      } catch (err) {
        console.warn("Gallery layout error:", err);
      }
    }

    function layoutAllGalleries() {
      const cards = document.querySelectorAll(".gallery-card");
      cards.forEach((card) => layoutOneGallery(card));
    }

    function setupGalleryObservers() {
      const cards = document.querySelectorAll(".gallery-card");
      let rafId = null;
      let debounceTimer;

      const schedule = () => {
        if (rafId) cancelAnimationFrame(rafId);
        if (debounceTimer) clearTimeout(debounceTimer);

        // Debounce ResizeObserver cascades during animations
        debounceTimer = setTimeout(() => {
          rafId = requestAnimationFrame(layoutAllGalleries);
        }, 100);
      };

      // Observe size changes of the gallery grid and the card itself to recalc rows
      cards.forEach((card) => {
        const grid = card.querySelector(".gallery-grid");
        const ro = new ResizeObserver(() => schedule());
        if (grid) ro.observe(grid);
        ro.observe(card);
      });

      window.addEventListener("resize", schedule);
    }

    // Wait for critical assets (hero images/videos) to load before animation
    async function waitForCriticalAssets() {
      const heroImages = document.querySelectorAll(
        ".hero-bg img, .hero-bg video",
      );
      const promises = Array.from(heroImages).map((el) => {
        if (el.tagName === "VIDEO") {
          return new Promise((resolve) => {
            if (el.readyState >= 3) resolve();
            else el.addEventListener("canplay", resolve, { once: true });
          });
        } else {
          return new Promise((resolve) => {
            if (el.complete) resolve();
            else el.addEventListener("load", resolve, { once: true });
          });
        }
      });

      // Wait max 2 seconds to avoid blocking animation indefinitely
      const timeout = new Promise((resolve) => setTimeout(resolve, 2000));
      return Promise.race([Promise.all(promises), timeout]);
    }

    // Main animation function with perfect audio sync
    async function animateBentoCards() {
      console.log("ðŸŽµ animateBentoCards() called", {
        hasSystem: !!window.bentoAnimationSystem,
        isPlaying: window.bentoAnimationSystem?.isPlaying,
        stack: new Error().stack,
      });

      // Ensure gallery rows and click handlers are ready before animating cards
      layoutAllGalleries();
      setupGalleryClickHandlers();

      if (!window.bentoAnimationSystem) {
        window.bentoAnimationSystem = new window.BentoAnimationSystem();
      }

      // Extra safety: prevent multiple calls
      if (window.bentoAnimationSystem.isPlaying) {
        console.log("ðŸŽµ Animation already playing, skipping...");
        return;
      }

      await window.bentoAnimationSystem.startAnimation();
    }

    // Reset function for overlay close
    function resetBentoCards() {
      console.log("ðŸŽµ resetBentoCards() called globally");
      if (bentoAnimationSystem) {
        window.bentoAnimationSystem.reset();
      }
    }

    // Export functions globally (only once)
    if (typeof window !== "undefined") {
      if (!window.__bentoInitialized) {
        window.animateBentoCards = animateBentoCards;
        window.resetBentoCards = resetBentoCards;

        // Auto-run for direct page loads - wait for assets to load
        document.addEventListener("DOMContentLoaded", () => {
          const bentoContent = document.getElementById("bento-content");
          if (bentoContent && bentoContent.style.display !== "none") {
            // Wait for critical assets to load before animation
            waitForCriticalAssets().then(() => {
              setTimeout(animateBentoCards, 100);
            });
          }
          // Initial gallery layout + observers
          layoutAllGalleries();
          setupGalleryObservers();
          setupGalleryClickHandlers();
        });

        // Mark as initialized
        window.__bentoInitialized = true;
      }
    }

    // Mark functions as initialized
    window.__bentoFunctionsInitialized = true;
  } // Close the functions wrapper

  // No shimmer animation â€" simplified glass for clarity
</script>

<script
  is:inline
  set:html={`window.__bentoAudioPlayerConfig = ${JSON.stringify(audioPlayerConfig)};`}
/>
<script>
  import { Howl, Howler } from "howler";

  const DEFAULT_CONFIG = {
    enabled: true,
    defaultVolume: 0.7,
    fade: {
      durationMs: 650,
      forceDurationMs: 220,
      applyLowPass: true,
      applyLowPassOnForce: true,
    },
    lowPass: {
      enabled: true,
      startFrequencyHz: 14000,
      targetFrequencyHz: 320,
      resonanceQ: 0.85,
      fadeDurationMs: 650,
    },
  };

  const pick = (...values) => values.find((value) => value !== undefined);

  function resolveConfig() {
    const inlineConfig = window.__bentoAudioPlayerConfig || {};
    const runtimeConfig = window.atomConfig?.audioPlayer || {};
    const source = (keyPath, fallback) => {
      const [section, prop] = keyPath.split(".");
      if (prop) {
        return pick(
          runtimeConfig[section]?.[prop],
          inlineConfig[section]?.[prop],
          DEFAULT_CONFIG[section]?.[prop],
          fallback,
        );
      }
      return pick(
        runtimeConfig[section],
        inlineConfig[section],
        DEFAULT_CONFIG[section],
        fallback,
      );
    };

    return {
      enabled: source("enabled", true),
      defaultVolume: source("defaultVolume", DEFAULT_CONFIG.defaultVolume),
      fade: {
        durationMs: source("fade.durationMs", DEFAULT_CONFIG.fade.durationMs),
        forceDurationMs: source(
          "fade.forceDurationMs",
          DEFAULT_CONFIG.fade.forceDurationMs,
        ),
        applyLowPass: source(
          "fade.applyLowPass",
          DEFAULT_CONFIG.fade.applyLowPass,
        ),
        applyLowPassOnForce: source(
          "fade.applyLowPassOnForce",
          DEFAULT_CONFIG.fade.applyLowPassOnForce,
        ),
      },
      lowPass: {
        enabled: source("lowPass.enabled", DEFAULT_CONFIG.lowPass.enabled),
        startFrequencyHz: source(
          "lowPass.startFrequencyHz",
          DEFAULT_CONFIG.lowPass.startFrequencyHz,
        ),
        targetFrequencyHz: source(
          "lowPass.targetFrequencyHz",
          DEFAULT_CONFIG.lowPass.targetFrequencyHz,
        ),
        resonanceQ: source(
          "lowPass.resonanceQ",
          DEFAULT_CONFIG.lowPass.resonanceQ,
        ),
        fadeDurationMs: source(
          "lowPass.fadeDurationMs",
          DEFAULT_CONFIG.lowPass.fadeDurationMs,
        ),
      },
    };
  }

  let globalLowPassFilter = null;

  function ensureLowPassFilter(config) {
    if (!config.lowPass.enabled) return null;
    if (globalLowPassFilter || !Howler?.usingWebAudio) {
      return globalLowPassFilter;
    }
    if (!Howler?.ctx || !Howler?.masterGain) return null;
    try {
      const filter = Howler.ctx.createBiquadFilter();
      filter.type = "lowpass";
      filter.Q.value = config.lowPass.resonanceQ;
      filter.frequency.value = config.lowPass.startFrequencyHz;
      const destination = Howler.ctx.destination;
      Howler.masterGain.disconnect();
      Howler.masterGain.connect(filter);
      filter.connect(destination);
      globalLowPassFilter = filter;
      return filter;
    } catch (err) {
      console.warn("Failed to initialize low-pass filter:", err);
      try {
        Howler.masterGain.connect(Howler.ctx.destination);
      } catch {}
      globalLowPassFilter = null;
      return null;
    }
  }

  function resetLowPassFilter(config) {
    if (!globalLowPassFilter || !Howler?.ctx) return;
    const ctx = Howler.ctx;
    const now = ctx.currentTime;
    try {
      globalLowPassFilter.frequency.cancelScheduledValues(now);
      globalLowPassFilter.frequency.setValueAtTime(
        config.lowPass.startFrequencyHz,
        now,
      );
    } catch {}
  }

  function animateLowPassFilter(volumeFadeMs, config) {
    if (!config.lowPass.enabled) return;
    const durationMs = config.lowPass.fadeDurationMs ?? volumeFadeMs;
    const filter = ensureLowPassFilter(config);
    if (!filter || !Howler?.ctx) return;
    const ctx = Howler.ctx;
    const now = ctx.currentTime;
    try {
      filter.frequency.cancelScheduledValues(now);
      filter.frequency.setValueAtTime(config.lowPass.startFrequencyHz, now);
      filter.frequency.linearRampToValueAtTime(
        config.lowPass.targetFrequencyHz,
        now + durationMs / 1000,
      );
    } catch (err) {
      console.warn("Low-pass animation failed:", err);
    }
    setTimeout(() => {
      resetLowPassFilter(config);
    }, durationMs + 200);
  }

  function fadeOutAllControllers(options = {}) {
    if (typeof document === "undefined") return;
    const cards = document.querySelectorAll(".audio-card");
    cards.forEach((card) => {
      const controller = card?.__audioController;
      if (controller && typeof controller.fadeOut === "function") {
        try {
          controller.fadeOut(options);
        } catch (err) {
          console.warn("Audio controller fade failed:", err);
        }
      }
    });

    const samplerCards = document.querySelectorAll(".sampler-card");
    samplerCards.forEach((card) => {
      const controller = card?.__samplerController;
      if (controller && typeof controller.stopAll === "function") {
        try {
          controller.stopAll(!!options.force);
        } catch (err) {
          console.warn("Sampler controller stop failed:", err);
        }
      }
    });
  }

  function initAudioPlayers() {
    const audioCards = document.querySelectorAll(".audio-card");

    audioCards.forEach((card) => {
      if (card.dataset.audioReady === "true") return;
      card.dataset.audioReady = "true";

      const config = resolveConfig();
      const playBtn = card.querySelector(".audio-play-btn");
      const playIcon = card.querySelector(".play-icon");
      const pauseIcon = card.querySelector(".pause-icon");
      const prevBtn = card.querySelector(".prev-btn");
      const nextBtn = card.querySelector(".next-btn");
      const trackName = card.querySelector(".track-name");
      const progressBar = card.querySelector(".audio-progress-bar");
      const progressFill = card.querySelector(".audio-progress-fill");
      const timeCurrent = card.querySelector(".time-current");
      const timeTotal = card.querySelector(".time-total");

      const projectSlug = card.getAttribute("data-project-slug") || "";
      const tracksData = card.getAttribute("data-tracks");

      if (!tracksData) return;

      const tracks = JSON.parse(tracksData);
      const currentLang = document.documentElement.lang || "fr";

      let currentTrackIndex = 0;
      let sound = null;
      let isPlaying = false;
      let isFadingOut = false;

      const folderMap = {
        chromestesia_showcase: "Chromestesia",
      };
      const audioFolder = folderMap[projectSlug] || projectSlug;

      function formatTime(seconds) {
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs.toString().padStart(2, "0")}`;
      }

      const controller = {
        fadeOut: ({ force } = {}) => fadeOutCurrentSound({ force }),
      };
      card.__audioController = controller;

      function fadeOutCurrentSound({ force } = {}) {
        if (!sound || isFadingOut) return;
        isFadingOut = true;
        const targetSound = sound;
        const fadeMs = force
          ? config.fade.forceDurationMs
          : config.fade.durationMs;
        sound = null;
        isPlaying = false;
        playIcon.style.display = "block";
        pauseIcon.style.display = "none";
        playBtn.classList.remove("playing");
        progressFill.style.width = "0%";
        timeCurrent.textContent = "0:00";
        const shouldLowPass =
          (force
            ? config.fade.applyLowPassOnForce
            : config.fade.applyLowPass) && config.lowPass.enabled;
        if (shouldLowPass) {
          animateLowPassFilter(fadeMs, config);
        }

        try {
          const fromVol =
            typeof targetSound.volume === "function" ? targetSound.volume() : 1;
          if (typeof targetSound.fade === "function") {
            targetSound.fade(fromVol, 0, fadeMs);
          } else {
            targetSound.stop();
          }
        } catch (err) {
          console.warn("Audio fade error:", err);
          try {
            targetSound.stop();
          } catch {}
        }

        setTimeout(() => {
          try {
            targetSound.stop();
          } catch {}
          try {
            targetSound.unload?.();
          } catch {}
          isFadingOut = false;
        }, fadeMs + 80);
      }

      function loadTrack(index) {
        if (sound) {
          sound.unload();
        }
        isFadingOut = false;

        currentTrackIndex = index;
        const track = tracks[index];

        trackName.textContent = track.title[currentLang] || track.title.en;
        timeCurrent.textContent = "0:00";
        timeTotal.textContent = track.duration || "0:00";
        progressFill.style.width = "0%";

        const audioSources = [
          `/audio/${audioFolder}/${track.filename}.ogg`,
          `/audio/${audioFolder}/${track.filename}.mp3`,
          `/audio/${audioFolder}/${track.filename}.wav`,
        ];

        sound = new Howl({
          src: audioSources,
          preload: "metadata",
          volume: config.defaultVolume,
          onplay: () => {
            isPlaying = true;
            playIcon.style.display = "none";
            pauseIcon.style.display = "block";
            playBtn.classList.add("playing");
            requestAnimationFrame(updateProgress);
          },
          onpause: () => {
            isPlaying = false;
            playIcon.style.display = "block";
            pauseIcon.style.display = "none";
            playBtn.classList.remove("playing");
          },
          onend: () => {
            isPlaying = false;
            playIcon.style.display = "block";
            pauseIcon.style.display = "none";
            playBtn.classList.remove("playing");

            if (currentTrackIndex < tracks.length - 1) {
              loadTrack(currentTrackIndex + 1);
              sound?.play();
            }
          },
          onload: () => {
            const duration = sound?.duration() || 0;
            timeTotal.textContent = formatTime(duration);
          },
        });
      }

      function updateProgress() {
        if (!sound || !isPlaying) return;

        const seek = sound.seek();
        const duration = sound.duration();
        const progress = (seek / duration) * 100;

        progressFill.style.width = `${progress}%`;
        timeCurrent.textContent = formatTime(seek);

        if (isPlaying) {
          requestAnimationFrame(updateProgress);
        }
      }

      playBtn?.addEventListener("click", () => {
        if (!sound) {
          loadTrack(0);
        }

        if (isPlaying) {
          sound?.pause();
        } else {
          sound?.play();
        }
      });

      prevBtn?.addEventListener("click", () => {
        const newIndex =
          currentTrackIndex > 0 ? currentTrackIndex - 1 : tracks.length - 1;
        loadTrack(newIndex);
        sound?.play();
      });

      nextBtn?.addEventListener("click", () => {
        const newIndex =
          currentTrackIndex < tracks.length - 1 ? currentTrackIndex + 1 : 0;
        loadTrack(newIndex);
        sound?.play();
      });

      progressBar?.addEventListener("click", (e) => {
        if (!sound) return;
        const rect = progressBar.getBoundingClientRect();
        const percent = (e.clientX - rect.left) / rect.width;
        const seek = percent * sound.duration();
        sound.seek(seek);
        progressFill.style.width = `${percent * 100}%`;
        timeCurrent.textContent = formatTime(seek);
      });

      if (tracks.length > 0) {
        loadTrack(0);
      }
    });
  }

  function initSamplerCards() {
    const samplerCards = document.querySelectorAll(".sampler-card");

    samplerCards.forEach((card) => {
      if (card.dataset.samplerReady === "true") return;
      card.dataset.samplerReady = "true";

      const folder = (card.dataset.folder || "").replace(/\/$/, "");

      let samplePool = [];
      try {
        samplePool = JSON.parse(card.dataset.samples || "[]");
      } catch {
        samplePool = [];
      }

      const pads = Array.from(card.querySelectorAll(".sampler-pad"));
      const regenerateBtn = card.querySelector(".sampler-regenerate-btn");
      const activeSounds = new Map();
      const baseConfig = resolveConfig();

      function setPadIcon(pad, isPlaying) {
        if (isPlaying) {
          pad.classList.add("is-playing");
        } else {
          pad.classList.remove("is-playing");
        }
      }

      function assignPads() {
        if (!samplePool.length) {
          pads.forEach((pad, idx) => {
            pad.dataset.sample = "";
            pad.disabled = true;
            pad.classList.remove("sampler-pad--active");
            setPadIcon(pad, false);
          });
          regenerateBtn?.setAttribute("disabled", "");
          return;
        }
        regenerateBtn?.removeAttribute("disabled");
        const available = [...samplePool];
        pads.forEach((pad, idx) => {
          if (!available.length) {
            available.push(...samplePool);
          }
          const choiceIndex = Math.floor(Math.random() * available.length);
          const sample = available.splice(choiceIndex, 1)[0];
          pad.dataset.sample = sample || "";
          pad.disabled = !sample;
          pad.classList.remove("sampler-pad--active");
          setPadIcon(pad, false);
        });
      }

      function stopPadSound(pad, force = false) {
        const sound = activeSounds.get(pad);
        if (sound) {
          try {
            sound.stop();
          } catch {}
          activeSounds.delete(pad);
        }
        if (!force) {
          pad.classList.remove("sampler-pad--active");
          setPadIcon(pad, false);
        }
      }

      function stopAll(force = false) {
        pads.forEach((pad) => stopPadSound(pad, force));
      }

      function playSample(pad) {
        const sample = pad.dataset.sample;
        if (!sample) return;
        stopPadSound(pad);
        const url = encodeURI(`/audio/${folder}/${sample}`);
        try {
          const sound = new Howl({
            src: [url],
            volume: baseConfig.defaultVolume,
            html5: false,
          });
          activeSounds.set(pad, sound);
          pad.classList.add("sampler-pad--active");
          setPadIcon(pad, true);
          sound.play();
          sound.on("end", () => {
            stopPadSound(pad);
            setPadIcon(pad, false);
          });
          sound.on("stop", () => {
            stopPadSound(pad);
            setPadIcon(pad, false);
          });
        } catch (err) {
          console.warn("Failed to play sample", sample, err);
        }
      }

      pads.forEach((pad) => {
        pad.addEventListener("click", () => playSample(pad));
      });

      function flashPads() {
        pads.forEach((pad) => {
          pad.classList.add("sampler-pad--loading");
          setTimeout(() => pad.classList.remove("sampler-pad--loading"), 520);
        });
      }

      regenerateBtn?.addEventListener("click", () => {
        stopAll();
        // Clear pads immediately to show "loading" state
        pads.forEach((pad) => {
          pad.dataset.sample = "";
          pad.disabled = true;
          setPadIcon(pad, false);
        });

        flashPads();

        try {
          regenerateBtn.classList.add("rotating");
          setTimeout(() => regenerateBtn.classList.remove("rotating"), 620);
        } catch {}

        // Delay assignment to match animation
        setTimeout(() => {
          assignPads();
        }, 500);
      });

      assignPads();

      card.__samplerController = {
        stopAll,
      };
    });
  }

  function bootstrapAudioPlayer() {
    const initialize = () => {
      initAudioPlayers();
      initSamplerCards();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initialize, { once: true });
    } else {
      initialize();
    }

    document.addEventListener("astro:page-load", () => {
      fadeOutAllControllers({ force: true });
      initAudioPlayers();
      initSamplerCards();
    });

    if (!window.__bentoAudioShutdownHooked) {
      const shutdown = (force = false) => fadeOutAllControllers({ force });
      window.addEventListener("bento:audio:shutdown", (event) =>
        shutdown(!!event.detail?.force),
      );
      window.addEventListener("beforeunload", () => shutdown(true));
      window.addEventListener("pagehide", () => shutdown(true));
      window.__bentoAudioShutdownHooked = true;
    }
  }

  if (typeof window !== "undefined") {
    if (!window.__bentoAudioPlayerBootstrapped) {
      window.__bentoAudioPlayerBootstrapped = true;
      bootstrapAudioPlayer();
    } else {
      // Refresh audio cards if new instances were added dynamically
      initAudioPlayers();
    }
  }
</script>
