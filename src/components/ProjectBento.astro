  .audio-progress-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Progress Section */
  .audio-progress-section {
    margin: 0;
    padding: 0 0.25rem;
  }

  /* Progress Bar Container */
  .audio-progress-bar {
    height: 8px;
    background: linear-gradient(
      to right,
      rgba(var(--accent-color-rgb), 0.12) 0%,
      rgba(var(--accent-color-rgb), 0.08) 100%
    );
    border-radius: 4px;
    position: relative;
    cursor: pointer;
    overflow: visible;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  html[data-theme="dark"] .audio-progress-bar {
    background: linear-gradient(
      to right,
      rgba(var(--accent-color-rgb), 0.18) 0%,
      rgba(var(--accent-color-rgb), 0.12) 100%
    );
  }

  /* Progress bar hover expansion */
  .audio-progress-bar:hover {
    height: 10px;
    border-radius: 5px;
  }

  /* Progress Fill */
  .audio-progress-fill {
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--accent-color) 0%,
      color-mix(in srgb, var(--accent-color) 85%, white) 100%
    );
    border-radius: 4px;
    width: 0%;
    transition: width 0.1s linear;
    position: relative;
    box-shadow: 0 0 12px rgba(var(--accent-color-rgb), 0.4);
  }

  /* Progress fill glow effect on hover */
  .audio-progress-bar:hover .audio-progress-fill {
    box-shadow:
      0 0 16px rgba(var(--accent-color-rgb), 0.6),
      0 2px 8px rgba(var(--accent-color-rgb), 0.3);
  }

  /* Progress indicator dot */
  .audio-progress-fill::after {
    content: "";
    position: absolute;
    right: -2px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    background: #ffffff;
    border: 2px solid var(--accent-color);
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.15),
      0 0 0 4px rgba(var(--accent-color-rgb), 0.2);
  }

  .audio-progress-bar:hover .audio-progress-fill::after {
    opacity: 1;
  }

  html[data-theme="dark"] .audio-progress-fill::after {
    background: var(--accent-color);
    border-color: #ffffff;
  }

  /* Time Display */
  .audio-times {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgba(15, 23, 42, 0.6);
    font-variant-numeric: tabular-nums;
    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      system-ui,
      sans-serif;
    letter-spacing: 0.08em;
    padding: 0 0.25rem;
  }

  html[data-theme="dark"] .audio-times {
    color: rgba(228, 228, 231, 0.85);
  }

  @media (max-width: 1023px) {
    .audio-card {
      padding: 2rem;
    }

    .audio-heading {
      text-align: left;
    }

    .audio-main {
      flex-direction: column;
      align-items: flex-start;
    }

    .audio-controls {
      justify-content: flex-start;
