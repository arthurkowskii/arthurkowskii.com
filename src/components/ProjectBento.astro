    --fmod-hud-border: rgba(255, 255, 255, 0.08);
    --fmod-health-track-boss:
      linear-gradient(180deg, rgba(18, 21, 29, 0.86), rgba(8, 10, 14, 0.94));
    --fmod-health-track-player: rgba(10, 13, 18, 0.7);
    --fmod-floor-shadow:
      radial-gradient(circle, rgba(var(--accent-color-rgb), 0.22) 0%, rgba(var(--accent-color-rgb), 0.08) 32%, transparent 72%),
      radial-gradient(circle, rgba(0, 0, 0, 0.46) 0%, transparent 76%);
    --fmod-dock-bg:
      linear-gradient(180deg, rgba(12, 14, 20, 0.96), rgba(8, 10, 14, 0.98));
    --fmod-dock-border: rgba(255, 255, 255, 0.08);
    --fmod-dock-text: #f8fafc;
    --fmod-dock-muted: rgba(226, 232, 240, 0.74);
    --fmod-dock-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 20px 48px rgba(0, 0, 0, 0.26);
    --fmod-action-bg:
      linear-gradient(180deg, rgba(25, 28, 36, 0.98), rgba(11, 14, 19, 0.98));
    --fmod-action-border: rgba(255, 255, 255, 0.08);
    --fmod-action-text: #f8fafc;
    --fmod-action-muted: rgba(226, 232, 240, 0.76);
    --fmod-action-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 16px 26px rgba(0, 0, 0, 0.24);
    --fmod-action-disabled-bg:
      linear-gradient(180deg, rgba(30, 34, 42, 0.92), rgba(15, 18, 24, 0.96));
    --fmod-action-disabled-border: rgba(148, 163, 184, 0.26);
    --fmod-action-disabled-text: rgba(203, 213, 225, 0.72);
    --fmod-action-icon-bg: rgba(255, 255, 255, 0.08);
    --fmod-action-icon-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 8px 16px rgba(0, 0, 0, 0.22);
    --fmod-action-lock-bg: rgba(15, 23, 42, 0.46);
    --fmod-action-lock-text: rgba(226, 232, 240, 0.9);
    --fmod-secondary-bg: rgba(255, 255, 255, 0.05);
    --fmod-secondary-border: rgba(255, 255, 255, 0.08);
    --fmod-secondary-text: #f8fafc;
    --fmod-secondary-hover-border: rgba(var(--accent-color-rgb), 0.34);
    --fmod-start-shadow:
      0 20px 40px rgba(var(--accent-color-rgb), 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    --fmod-gate-shadow:
      0 30px 60px rgba(var(--accent-color-rgb), 0.26),
