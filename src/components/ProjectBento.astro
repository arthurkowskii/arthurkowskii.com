<script is:inline>
  // PLACEHOLDER: Tone.js is temporary - will be replaced with custom OGG audio files
  // See docs/history/PHASE_LOGS.md Phase 3C for audio architecture plan
  // Note: Using is:inline to ensure single global scope for all ProjectBento instances

  // Guard against multiple initializations
  if (typeof window.__bentoInitialized === "undefined") {
    window.__bentoInitialized = false;
  }

  // Gallery lightbox: lazy-loaded on first click for reliability across contexts
  // Use window to ensure single instance across all script executions
  if (typeof window.__GLB === "undefined") {
    window.__GLB = null;
  }

  if (typeof window.ensureLightbox === "undefined") {
    window.ensureLightbox = async function () {
      if (!window.__GLB) {
        try {
          const mod = await import("../atom/ui/GalleryLightbox.js");
          window.__GLB = mod?.default || mod;
        } catch (err) {
          console.warn("Failed to load GalleryLightbox module:", err);
        }
      }
      return window.__GLB;
    };
  }

  // Avoid redeclaration errors when multiple bento components are rendered
  if (typeof ensureLightbox === "undefined") {
    var ensureLightbox = window.ensureLightbox;
  }

  // Simple Bento Animation System with Synced Audio
  // Audio is strictly gated behind a real user gesture to avoid
  // "AudioContext was not allowed to start" errors in browsers.
  if (typeof window.__audioUnlocked === "undefined") {
    window.__audioUnlocked = true;
  }

  // Define BentoAnimationSystem class only once
  if (typeof window.BentoAnimationSystem === "undefined") {
    window.BentoAnimationSystem = class BentoAnimationSystem {
      constructor() {
        this.isInitialized = false;
        this.synth = null;
        this.chorus = null;
        this.config = null;
        this.isPlaying = false;
      }

      async init() {
        if (this.isInitialized) return;

        try {
          // Always set config with fallback
          this.config = {
            enabled: true,
            staggerDelayMs: 80,
            animationDurationMs: 400,
            easing: "cubic-bezier(0.34, 1.56, 0.64, 1)",
            cardEnabled: {
              hero: true,
              stats: true,
              actions: true,
              tech: true,
              gallery: true,
              process: true,
              challenges: true,
              results: true,
            },
            audio: {
              enabled: false,
              volume: 0.4,
              syncWithAnimation: true,
              pitches: {
                hero: "C3",
                stats: "E3",
                actions: "G3",
                tech: "C4",
                gallery: "E4",
                process: "G4",
                challenges: "B3",
                results: "D4",
              },
              synthesis: {
                attack: 0.01,
                decay: 0.3,
                sustain: 0,
                release: 0.8,
                chorus: { frequency: 4, depth: 0.3 },
              },
            },
          };

          // Override with global config if available
          if (window.atomConfig?.bentoAnimations) {
            this.config = {
              ...this.config,
              ...window.atomConfig.bentoAnimations,
            };
          }

          // Hard-disable audio placeholder until Tone.js migration completes
          if (this.config.audio) {
            this.config.audio.enabled = false;
          } else {
            this.config.audio = { enabled: false };
          }

          if (!this.config.audio?.enabled) {
            this.isInitialized = true;
            return;
          }

          // PLACEHOLDER: Audio will be replaced with custom OGG files + Web Audio API
          // Only create audio objects when actually needed (defer until user interaction)
          console.log(
            "ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸Ãƒâ€¦Ã‚Â½Ãƒâ€šÃ‚Âµ Bento Animation System initialized (audio deferred until user interaction)",
          );
          this.isInitialized = true;
        } catch (error) {
          console.warn("Failed to initialize Bento system:", error);
        }
      }

      async initAudio() {
        return;
      }

      getCardType(card) {
        // Determine card type from classes
        if (card.classList.contains("hero-card")) return "hero";
        if (card.classList.contains("music-links-card")) return "stats";
        if (card.classList.contains("stats-card")) return "stats";
        if (card.classList.contains("actions-card")) return "actions";
        if (card.classList.contains("tech-card")) return "tech";
        if (card.classList.contains("gallery-card")) return "gallery";
        if (card.classList.contains("process-card")) return "process";
        if (card.classList.contains("challenges-card")) return "challenges";
        if (card.classList.contains("results-card")) return "results";
        return "hero"; // fallback
      }

      async ensureAudioReady() {
        return;
      }

      animateCard(card, cardType, index) {
        if (!this.config) return; // Safety check

        const isEnabled = this.config.cardEnabled?.[cardType] ?? true;
        if (!isEnabled) return;

        // Set CSS custom properties
        card.style.setProperty(
          "--duration",
          `${this.config.animationDurationMs}ms`,
        );
        card.style.setProperty("--easing", this.config.easing);

        // Reset any existing classes
        card.classList.remove("animate-in");

        const delay = index * this.config.staggerDelayMs;

        setTimeout(() => {
          card.classList.add("animate-in");
        }, delay);
      }

      async startAnimation() {
        console.log("ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸Ãƒâ€¦Ã‚Â½Ãƒâ€šÃ‚Âµ startAnimation() called", {
          isPlaying: this.isPlaying,
        });

        if (this.isPlaying) {
          console.log("ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸Ãƒâ€¦Ã‚Â½Ãƒâ€šÃ‚Âµ Already playing, returning early");
          return;
        }
        this.isPlaying = true;

        // Ensure config is loaded first
        if (!this.config) {
          await this.init();
        }

        // Ensure audio is ready only if unlocked; otherwise animations proceed silently
        if (this.config?.audio?.enabled) {
          await this.ensureAudioReady();
        }

        // Only select cards from the currently visible bento project
        const visibleBentoProject = document.querySelector(
          '#bento-content .bento-project[style*="display: block"]',
        );
        const cards = visibleBentoProject
          ? visibleBentoProject.querySelectorAll(".bento-card")
          : [];

        console.log(
          `ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸Ãƒâ€¦Ã‚Â½Ãƒâ€šÃ‚Âµ Starting bento animation for ${cards.length} cards (audio: ${this.config.audio?.enabled})`,
        );
        console.log(
          `ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸Ãƒâ€¦Ã‚Â½Ãƒâ€šÃ‚Âµ Visible project:`,
          visibleBentoProject?.dataset?.projectSlug || "none",
        );

        cards.forEach((card, index) => {
          const cardType = this.getCardType(card);
          this.animateCard(card, cardType, index);
        });

        // Reset playing flag after animation completes
        const totalTime =
          cards.length * this.config.staggerDelayMs +
          this.config.animationDurationMs +
          200;
        setTimeout(() => {
          this.isPlaying = false;
        }, totalTime);
      }

      reset() {
        console.log("ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸Ãƒâ€¦Ã‚Â½Ãƒâ€šÃ‚Âµ reset() called");
        // Reset ALL bento cards (since we're closing/switching projects)
        const cards = document.querySelectorAll("#bento-content .bento-card");
        cards.forEach((card) => {
          card.classList.remove("animate-in");
        });
        this.isPlaying = false;
      }
    };
  } // Close the BentoAnimationSystem class definition wrapper

  // Global instance - use window to ensure single instance across all components
  if (
    typeof window !== "undefined" &&
    typeof window.bentoAnimationSystem === "undefined"
  ) {
    window.bentoAnimationSystem = null;
  }

  // ==========================
  // Minimal Lightbox (Step 1): Single-media viewer
  // ==========================

  // Wrap all remaining functions to prevent redeclaration in Firefox
  if (!window.__bentoFunctionsInitialized) {
    let __basicGlb = null;
    let __basicGlbOpen = false;
    let __basicLastFocus = null;
    let __basicItems = [];
    let __basicIndex = 0;
    const onBasicKey = (e) => {
      if (!__basicGlbOpen) return;
      if (e.key === "Escape") {
        e.stopPropagation();
        e.preventDefault();
        closeBasicLightbox();
      }
      if (e.key === "ArrowLeft") {
        e.stopPropagation();
        e.preventDefault();
        basicPrev();
      }
      if (e.key === "ArrowRight") {
        e.stopPropagation();
        e.preventDefault();
        basicNext();
      }
    };

    function ensureBasicLightbox() {
      if (__basicGlb) return __basicGlb;
      console.log("[GLB] creating basic lightbox DOM");
      const root = document.createElement("div");
      root.className = "glb-root";
      root.style.display = "none";

      const scrim = document.createElement("div");
      scrim.className = "glb-scrim";
      scrim.addEventListener("click", () => closeBasicLightbox());

      const container = document.createElement("div");
      container.className = "glb-container";
      container.style.display = "grid";

      const closeBtn = document.createElement("button");
      closeBtn.className = "glb-close";
      closeBtn.setAttribute("aria-label", "Close");
      closeBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
      <path fill="currentColor" d="M195.2 195.2a64 64 0 0190.496 0L512 421.504 738.304 195.2a64 64 0 0190.496 90.496L602.496 512 828.8 738.304a64 64 0 01-90.496 90.496L512 602.496 285.696 828.8a64 64 0 01-90.496-90.496L421.504 512 195.2 285.696a64 64 0 010-90.496z"/>
    </svg>`;
      closeBtn.addEventListener("click", () => closeBasicLightbox());

      const viewport = document.createElement("div");
      viewport.className = "glb-viewport";

      const counter = document.createElement("div");
      counter.className = "glb-counter";
      counter.textContent = "";

      const btnPrev = document.createElement("button");
      btnPrev.className = "glb-nav glb-prev";
      btnPrev.setAttribute("aria-label", "Previous");
      btnPrev.innerHTML = `<svg width="24" height="24" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
      <path fill="currentColor" d="M685.248 104.704a64 64 0 010 90.496L368.448 512l316.8 316.8a64 64 0 01-90.496 90.496L232.704 557.248a64 64 0 010-90.496l362.048-362.048a64 64 0 0190.496 0z"/>
    </svg>`;
      btnPrev.addEventListener("click", () => basicPrev());

      const btnNext = document.createElement("button");
      btnNext.className = "glb-nav glb-next";
      btnNext.setAttribute("aria-label", "Next");
      btnNext.innerHTML = `<svg width="24" height="24" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg">
      <path fill="currentColor" d="M338.752 104.704a64 64 0 0190.496 0l362.048 362.048a64 64 0 010 90.496L429.248 919.296a64 64 0 01-90.496-90.496L655.552 512 338.752 195.2a64 64 0 010-90.496z"/>
    </svg>`;
      btnNext.addEventListener("click", () => basicNext());

      container.appendChild(closeBtn);
      container.appendChild(btnPrev);
      container.appendChild(viewport);
      container.appendChild(btnNext);
      container.appendChild(counter);

      root.appendChild(scrim);
      root.appendChild(container);
      document.body.appendChild(root);
      console.log("[GLB] basic lightbox DOM appended to body");
      __basicGlb = {
        root,
        scrim,
        container,
        viewport,
        counter,
        closeBtn,
        btnPrev,
        btnNext,
      };
      return __basicGlb;
    }

    function renderBasicSlide() {
      const glb = __basicGlb || ensureBasicLightbox();
      if (!__basicItems.length) return;
      const item = __basicItems[__basicIndex];
      if (!item) return;
      // Pause any existing video
      try {
        glb.viewport.querySelector("video")?.pause();
      } catch {}
      glb.viewport.innerHTML = "";
      let el;
      if (item.isVideo) {
        el = document.createElement("video");
        el.src = item.src;
        el.controls = true;
        el.playsInline = true;
        el.style.maxWidth = "100%";
        el.style.maxHeight = "100%";
      } else {
        el = document.createElement("img");
        el.src = item.src;
        el.alt = item.alt || "";
        el.style.maxWidth = "100%";
        el.style.maxHeight = "100%";
        el.decoding = "async";
        el.loading = "eager";
      }
      glb.viewport.appendChild(el);
      glb.counter.textContent = `${__basicIndex + 1} / ${__basicItems.length}`;
      // Preload neighbors (images only)
      const prev =
        __basicItems[
          (__basicIndex - 1 + __basicItems.length) % __basicItems.length
        ];
      const next = __basicItems[(__basicIndex + 1) % __basicItems.length];
      [prev, next].forEach((n) => {
        if (n && !n.isVideo) {
          const img = new Image();
          img.src = n.src;
        }
      });
    }

    function basicPrev() {
      if (!__basicItems.length) return;
      __basicIndex =
        (__basicIndex - 1 + __basicItems.length) % __basicItems.length;
      renderBasicSlide();
    }
    function basicNext() {
      if (!__basicItems.length) return;
      __basicIndex = (__basicIndex + 1) % __basicItems.length;
      renderBasicSlide();
    }

    function openBasicLightboxWithItems(items, startIndex, returnEl) {
      const glb = ensureBasicLightbox();
      __basicItems = Array.isArray(items) ? items.slice() : [];
      __basicIndex = Math.min(
        Math.max(0, startIndex || 0),
        Math.max(0, __basicItems.length - 1),
      );
      __basicLastFocus = returnEl || document.activeElement;
      glb.root.style.display = "block";
      glb.root.setAttribute("aria-hidden", "false");
      document.documentElement.classList.add("glb-scroll-lock");
      __basicGlbOpen = true;
      renderBasicSlide();
      try {
        glb.closeBtn.focus({ preventScroll: true });
      } catch {}
      document.addEventListener("keydown", onBasicKey, true);
    }

    function closeBasicLightbox() {
      const glb = __basicGlb;
      if (!glb) return;
      __basicGlbOpen = false;
      glb.root.style.display = "none";
      glb.root.setAttribute("aria-hidden", "true");
      glb.viewport.innerHTML = "";
      document.documentElement.classList.remove("glb-scroll-lock");
      document.removeEventListener("keydown", onBasicKey, true);
      try {
        __basicLastFocus?.focus({ preventScroll: true });
      } catch {}
    }

    // Attach click handlers to open lightbox for each gallery card
    function setupGalleryClickHandlers(scope = document) {
      const cards = scope.querySelectorAll(".gallery-card");
      console.debug(
        "[GLB] setupGalleryClickHandlers: found cards =",
        cards.length,
      );
      cards.forEach((card) => {
        if (card.dataset.glbBound === "1") return;
        card.dataset.glbBound = "1";
        const dataEl = card.querySelector(".gallery-data");
        let fallbackItems = [];
        try {
          fallbackItems = JSON.parse(dataEl?.textContent || "[]");
        } catch (e) {
          console.warn("[GLB] JSON parse failed", e);
        }

        const clickables = card.querySelectorAll("[data-gallery-index]");
        console.debug(
          "[GLB] card bound. fallback items =",
          fallbackItems.length,
          "clickables =",
          clickables.length,
        );

        // Build full-resolution items from data attributes
        const fullResItems = Array.from(clickables)
          .sort((a, b) => {
            const aIdx = parseInt(
              a.getAttribute("data-gallery-index") || "0",
              10,
            );
            const bIdx = parseInt(
              b.getAttribute("data-gallery-index") || "0",
              10,
            );
            return aIdx - bIdx;
          })
          .map((el) => {
            const fullSrc = el.getAttribute("data-full-src");
            const fallbackIdx = parseInt(
              el.getAttribute("data-gallery-index") || "0",
              10,
            );
            const fallbackItem = fallbackItems[fallbackIdx] || {};

            return {
              src: fullSrc || fallbackItem.src,
              alt: fallbackItem.alt || "Gallery image",
              isVideo: fallbackItem.isVideo || false,
            };
          });

        const items = fullResItems.length > 0 ? fullResItems : fallbackItems;

        clickables.forEach((el) => {
          const idx =
            parseInt(el.getAttribute("data-gallery-index") || "0", 10) || 0;
          el.addEventListener(
            "click",
            async (e) => {
              e.preventDefault();
              e.stopPropagation();
              console.debug(
                "[GLB] click on index",
                idx,
                "items total",
                items.length,
              );
              if (items && items.length)
                openBasicLightboxWithItems(items, idx, el);
            },
            { passive: false },
          );
          el.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              el.click();
            }
          });
        });
      });
    }

    // ==========================
    // Gallery layout (dynamic rows)
    // - Thumbnails are a CSS grid (3 cols desktop, 2 cols mobile landscape)
    // - Show as many full rows as fit; hide the rest
    // ==========================
    function getGridColumnCount(el) {
      const style = getComputedStyle(el);
      const template = style.gridTemplateColumns;
      if (!template || template === "none") return 1;
      const m = template.match(/repeat\(\s*(\d+)\s*,/i);
      if (m) {
        const n = parseInt(m[1], 10);
        return Number.isFinite(n) && n > 0 ? n : 1;
      }
      return template.split(/\s+/).filter(Boolean).length;
    }

    // Config provider for gallery layout
    const DEFAULT_GALLERY_CFG = {
      extraRow1DeltaPx: 500,
      extraRow2DeltaPx: 800,
      heroMinHeightFallback: 120,
      maxRows: 3,
    };
    function getGalleryCfg(card) {
      try {
        if (window.atomConfig?.bentoGallery)
          return window.atomConfig.bentoGallery;
      } catch {}
      try {
        const root = card.closest(".project-bento") || document;
        const el = root.querySelector(".bento-gallery-config");
        if (el) {
          const parsed = JSON.parse(el.textContent || "{}");
          return { ...DEFAULT_GALLERY_CFG, ...parsed };
        }
      } catch {}
      return DEFAULT_GALLERY_CFG;
    }

    function layoutOneGallery(card) {
      try {
        const grid = card.querySelector(".gallery-grid");
        const thumbs = card.querySelector(".gallery-thumbnails");
        const hero = card.querySelector(".gallery-hero");
        if (!grid || !thumbs || !hero) return;

        const thumbsStyle = getComputedStyle(thumbs);
        if (thumbsStyle.display === "none") return; // hidden on mobile portrait

        const gridStyle = getComputedStyle(grid);
        let globalVolume = parseFloat(card.dataset.samplerVolume || "1.0");
        const gapX = parseFloat(thumbsStyle.columnGap || thumbsStyle.gap) || 0;

        const columns = Math.max(1, getGridColumnCount(thumbs));
        const width = thumbs.clientWidth;
        if (width <= 0) return;
        const tile = (width - (columns - 1) * gapX) / columns;
        if (!(tile > 0)) return;

        // Measure with thumbnails unconstrained to avoid self-limiting from prior runs
        const __prevH = thumbs.style.height;
        const __prevFlex = thumbs.style.flex;
        thumbs.style.height = "auto";
        thumbs.style.flex = "0 0 auto";
        void thumbs.offsetHeight; // force reflow

        // Available vertical space for thumbnails within the grid (unconstrained)
        const gridHeightAuto = grid.clientHeight;
        const available = gridHeightAuto - hero.clientHeight - gapYGrid;
        if (!(available > 0)) {
          // Restore and bail
          thumbs.style.height = __prevH;
          thumbs.style.flex = __prevFlex;
          return;
        }

        // Baseline rows using unconstrained measurement
        let rowsFit = Math.floor((available + gapX) / (tile + gapX));
        if (rowsFit < 1) rowsFit = 1; // always show at least one full row

        // Config-driven multi-row support (up to 3 rows by default)
        const cfg = getGalleryCfg(card);
        const heroStyle = getComputedStyle(hero);
        const heroMinH =
          parseFloat(heroStyle.minHeight || "0") ||
          (cfg.heroMinHeightFallback ?? 120);
        const maxAvailableWithHeroMin = Math.max(
          0,
          gridHeightAuto - heroMinH - gapYGrid,
        );
        const rowsWithMin = Math.floor(
          (maxAvailableWithHeroMin + gapX) / (tile + gapX),
        );

        // Per-card tallness relative to CSS min-height
        const cardStyle = getComputedStyle(card);
        const cardMinH = parseFloat(cardStyle.minHeight || "0") || 0;
        const cardHeight =
          card.clientHeight || parseFloat(cardStyle.height || "0") || 0;
        const delta = Math.max(0, cardHeight - cardMinH);
        let extraAllowed = 0;
        const d1 = cfg.extraRow1DeltaPx ?? 500;
        const d2 = cfg.extraRow2DeltaPx ?? 800;
        if (delta >= d2) extraAllowed = 2;
        else if (delta >= d1) extraAllowed = 1;

        const maxRows = cfg.maxRows ?? 3;
        const desired = Math.min(1 + extraAllowed, rowsWithMin, maxRows);
        rowsFit = Math.max(rowsFit, desired);

        const items = Array.from(thumbs.children);
        const visibleCount = Math.min(items.length, columns * rowsFit);
        for (let i = 0; i < items.length; i++) {
          const el = items[i];
          if (i < visibleCount) el.style.removeProperty("display");
          else el.style.display = "none";
        }

        // Fix the container height to exactly fit the number of full rows
        const rowsHeight = rowsFit * tile + (rowsFit - 1) * gapX;
        thumbs.style.height = rowsHeight + "px";
        thumbs.style.flex = `0 0 ${rowsHeight}px`;

        thumbs.setAttribute("data-rows", String(rowsFit));
      } catch (err) {
        console.warn("Gallery layout error:", err);
      }
    }

    function layoutAllGalleries() {
      const cards = document.querySelectorAll(".gallery-card");
      cards.forEach((card) => layoutOneGallery(card));
    }

    function setupGalleryObservers() {
      const cards = document.querySelectorAll(".gallery-card");
      let rafId = null;
      let debounceTimer;

      const schedule = () => {
        if (rafId) cancelAnimationFrame(rafId);
        if (debounceTimer) clearTimeout(debounceTimer);

        // Debounce ResizeObserver cascades during animations
        debounceTimer = setTimeout(() => {
          rafId = requestAnimationFrame(layoutAllGalleries);
        }, 100);
      };

      // Observe size changes of the gallery grid and the card itself to recalc rows
      cards.forEach((card) => {
        const grid = card.querySelector(".gallery-grid");
        const ro = new ResizeObserver(() => schedule());
        if (grid) ro.observe(grid);
        ro.observe(card);
      });

      window.addEventListener("resize", schedule);
    }

    // Wait for critical assets (hero images/videos) to load before animation
    async function waitForCriticalAssets() {
      const heroImages = document.querySelectorAll(
        ".hero-bg img, .hero-bg video",
      );
      const promises = Array.from(heroImages).map((el) => {
        if (el.tagName === "VIDEO") {
          return new Promise((resolve) => {
            if (el.readyState >= 3) resolve();
            else el.addEventListener("canplay", resolve, { once: true });
          });
        } else {
          return new Promise((resolve) => {
            if (el.complete) resolve();
            else el.addEventListener("load", resolve, { once: true });
          });
        }
      });

      // Wait max 2 seconds to avoid blocking animation indefinitely
      const timeout = new Promise((resolve) => setTimeout(resolve, 2000));
      return Promise.race([Promise.all(promises), timeout]);
    }

    // Main animation function with perfect audio sync
    async function animateBentoCards() {
      console.log("ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸Ãƒâ€¦Ã‚Â½Ãƒâ€šÃ‚Âµ animateBentoCards() called", {
        hasSystem: !!window.bentoAnimationSystem,
        isPlaying: window.bentoAnimationSystem?.isPlaying,
        stack: new Error().stack,
      });

      // Ensure gallery rows and click handlers are ready before animating cards
      layoutAllGalleries();
      setupGalleryClickHandlers();

      if (!window.bentoAnimationSystem) {
        window.bentoAnimationSystem = new window.BentoAnimationSystem();
      }

      // Extra safety: prevent multiple calls
      if (window.bentoAnimationSystem.isPlaying) {
        console.log("ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸Ãƒâ€¦Ã‚Â½Ãƒâ€šÃ‚Âµ Animation already playing, skipping...");
        return;
      }

      await window.bentoAnimationSystem.startAnimation();
    }

    // Reset function for overlay close
    function resetBentoCards() {
      console.log("ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸Ãƒâ€¦Ã‚Â½Ãƒâ€šÃ‚Âµ resetBentoCards() called globally");
      if (bentoAnimationSystem) {
        window.bentoAnimationSystem.reset();
      }
    }

    // Export functions globally (only once)
    if (typeof window !== "undefined") {
      if (!window.__bentoInitialized) {
        window.animateBentoCards = animateBentoCards;
        window.resetBentoCards = resetBentoCards;

        // Auto-run for direct page loads - wait for assets to load
        document.addEventListener("DOMContentLoaded", () => {
          const bentoContent = document.getElementById("bento-content");
          if (bentoContent && bentoContent.style.display !== "none") {
            // Wait for critical assets to load before animation
            waitForCriticalAssets().then(() => {
              setTimeout(animateBentoCards, 100);
            });
          }
          // Initial gallery layout + observers
          layoutAllGalleries();
          setupGalleryObservers();
          setupGalleryClickHandlers();
        });

        // Mark as initialized
        window.__bentoInitialized = true;
      }
    }

    // Mark functions as initialized
    window.__bentoFunctionsInitialized = true;
  } // Close the functions wrapper

  // No shimmer animation ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬" simplified glass for clarity
</script>

<script
  is:inline
  set:html={`window.__bentoAudioPlayerConfig = ${JSON.stringify(audioPlayerConfig)};`}
/>
<script>
  import { Howl, Howler } from "howler";

  const DEFAULT_CONFIG = {
    enabled: true,
    defaultVolume: 0.7,
    fade: {
      durationMs: 650,
      forceDurationMs: 220,
      applyLowPass: true,
      applyLowPassOnForce: true,
    },
    lowPass: {
      enabled: true,
      startFrequencyHz: 14000,
      targetFrequencyHz: 320,
      resonanceQ: 0.85,
      fadeDurationMs: 650,
    },
  };

  const pick = (...values) => values.find((value) => value !== undefined);

  function resolveConfig() {
    const inlineConfig = window.__bentoAudioPlayerConfig || {};
    const runtimeConfig = window.atomConfig?.audioPlayer || {};
    const source = (keyPath, fallback) => {
      const [section, prop] = keyPath.split(".");
      if (prop) {
        return pick(
          runtimeConfig[section]?.[prop],
          inlineConfig[section]?.[prop],
          DEFAULT_CONFIG[section]?.[prop],
          fallback,
        );
      }
      return pick(
        runtimeConfig[section],
        inlineConfig[section],
        DEFAULT_CONFIG[section],
        fallback,
      );
    };

    return {
      enabled: source("enabled", true),
      defaultVolume: source("defaultVolume", DEFAULT_CONFIG.defaultVolume),
      fade: {
        durationMs: source("fade.durationMs", DEFAULT_CONFIG.fade.durationMs),
        forceDurationMs: source(
          "fade.forceDurationMs",
          DEFAULT_CONFIG.fade.forceDurationMs,
        ),
        applyLowPass: source(
          "fade.applyLowPass",
          DEFAULT_CONFIG.fade.applyLowPass,
        ),
        applyLowPassOnForce: source(
          "fade.applyLowPassOnForce",
          DEFAULT_CONFIG.fade.applyLowPassOnForce,
        ),
      },
      lowPass: {
        enabled: source("lowPass.enabled", DEFAULT_CONFIG.lowPass.enabled),
        startFrequencyHz: source(
          "lowPass.startFrequencyHz",
          DEFAULT_CONFIG.lowPass.startFrequencyHz,
        ),
        targetFrequencyHz: source(
          "lowPass.targetFrequencyHz",
          DEFAULT_CONFIG.lowPass.targetFrequencyHz,
        ),
        resonanceQ: source(
          "lowPass.resonanceQ",
          DEFAULT_CONFIG.lowPass.resonanceQ,
        ),
        fadeDurationMs: source(
          "lowPass.fadeDurationMs",
          DEFAULT_CONFIG.lowPass.fadeDurationMs,
        ),
      },
    };
  }

  let globalLowPassFilter = null;

  function ensureLowPassFilter(config) {
    if (!config.lowPass.enabled) return null;
    if (globalLowPassFilter || !Howler?.usingWebAudio) {
      return globalLowPassFilter;
    }
    if (!Howler?.ctx || !Howler?.masterGain) return null;
    try {
      const filter = Howler.ctx.createBiquadFilter();
      filter.type = "lowpass";
      filter.Q.value = config.lowPass.resonanceQ;
      filter.frequency.value = config.lowPass.startFrequencyHz;
      const destination = Howler.ctx.destination;
      Howler.masterGain.disconnect();
      Howler.masterGain.connect(filter);
      filter.connect(destination);
      globalLowPassFilter = filter;
      return filter;
    } catch (err) {
      console.warn("Failed to initialize low-pass filter:", err);
      try {
        Howler.masterGain.connect(Howler.ctx.destination);
      } catch {}
      globalLowPassFilter = null;
      return null;
    }
  }

  function resetLowPassFilter(config) {
    if (!globalLowPassFilter || !Howler?.ctx) return;
    const ctx = Howler.ctx;
    const now = ctx.currentTime;
    try {
      globalLowPassFilter.frequency.cancelScheduledValues(now);
      globalLowPassFilter.frequency.setValueAtTime(
        config.lowPass.startFrequencyHz,
        now,
      );
    } catch {}
  }

  function animateLowPassFilter(volumeFadeMs, config) {
    if (!config.lowPass.enabled) return;
    const durationMs = config.lowPass.fadeDurationMs ?? volumeFadeMs;
    const filter = ensureLowPassFilter(config);
    if (!filter || !Howler?.ctx) return;
    const ctx = Howler.ctx;
    const now = ctx.currentTime;
    try {
      filter.frequency.cancelScheduledValues(now);
      filter.frequency.setValueAtTime(config.lowPass.startFrequencyHz, now);
      filter.frequency.linearRampToValueAtTime(
        config.lowPass.targetFrequencyHz,
        now + durationMs / 1000,
      );
    } catch (err) {
      console.warn("Low-pass animation failed:", err);
    }
    setTimeout(() => {
      resetLowPassFilter(config);
    }, durationMs + 200);
  }

  function fadeOutAllControllers(options = {}) {
    if (typeof document === "undefined") return;
    const cards = document.querySelectorAll(".audio-card");
    cards.forEach((card) => {
      const controller = card?.__audioController;
      if (controller && typeof controller.fadeOut === "function") {
        try {
          controller.fadeOut(options);
        } catch (err) {
          console.warn("Audio controller fade failed:", err);
        }
      }
    });

    const samplerCards = document.querySelectorAll(".sampler-card");
    samplerCards.forEach((card) => {
      const controller = card?.__samplerController;
      if (controller && typeof controller.stopAll === "function") {
        try {
          controller.stopAll(!!options.force);
        } catch (err) {
          console.warn("Sampler controller stop failed:", err);
        }
      }
    });
  }

  function initAudioPlayers() {
    const audioCards = document.querySelectorAll(".audio-card");

    audioCards.forEach((card) => {
      if (card.dataset.audioReady === "true") return;
      card.dataset.audioReady = "true";

      const config = resolveConfig();
      const playBtn = card.querySelector(".audio-play-btn");
      const playIcon = card.querySelector(".play-icon");
      const pauseIcon = card.querySelector(".pause-icon");
      const prevBtn = card.querySelector(".prev-btn");
      const nextBtn = card.querySelector(".next-btn");
      const trackName = card.querySelector(".track-name");
      const progressBar = card.querySelector(".audio-progress-bar");
      const progressFill = card.querySelector(".audio-progress-fill");
      const timeCurrent = card.querySelector(".time-current");
      const timeTotal = card.querySelector(".time-total");
      const trackItems = card.querySelectorAll(".audio-track-item");

      const projectSlug = card.getAttribute("data-project-slug") || "";
      const tracksData = card.getAttribute("data-tracks");

      if (!tracksData) return;

      const tracks = JSON.parse(tracksData);
      const currentLang = document.documentElement.lang || "fr";

      let currentTrackIndex = 0;
      let sound = null;
      let isPlaying = false;
      let isFadingOut = false;

      const folderMap = {
        chromestesia_showcase: "Chromestesia",
        mouse_knight_showcase: "MouseKnight",
      };
      const audioFolder = folderMap[projectSlug] || projectSlug;

      function formatTime(seconds) {
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs.toString().padStart(2, "0")}`;
      }

      const controller = {
        fadeOut: ({ force } = {}) => fadeOutCurrentSound({ force }),
      };
      card.__audioController = controller;

      function fadeOutCurrentSound({ force } = {}) {
        if (!sound || isFadingOut) return;
        isFadingOut = true;
        const targetSound = sound;
        const fadeMs = force
          ? config.fade.forceDurationMs
          : config.fade.durationMs;
        sound = null;
        isPlaying = false;
        playIcon.style.display = "block";
        pauseIcon.style.display = "none";
        playBtn.classList.remove("playing");
        progressFill.style.width = "0%";
        timeCurrent.textContent = "0:00";
        const shouldLowPass =
          (force
            ? config.fade.applyLowPassOnForce
            : config.fade.applyLowPass) && config.lowPass.enabled;
        if (shouldLowPass) {
          animateLowPassFilter(fadeMs, config);
        }

        try {
          const fromVol =
            typeof targetSound.volume === "function" ? targetSound.volume() : 1;
          if (typeof targetSound.fade === "function") {
            targetSound.fade(fromVol, 0, fadeMs);
          } else {
            targetSound.stop();
          }
        } catch (err) {
          console.warn("Audio fade error:", err);
          try {
            targetSound.stop();
          } catch {}
        }

        setTimeout(() => {
          try {
            targetSound.stop();
          } catch {}
          try {
            targetSound.unload?.();
          } catch {}
          isFadingOut = false;
        }, fadeMs + 80);
      }

      function loadTrack(index) {
        if (sound) {
          sound.unload();
        }
        isFadingOut = false;

        trackItems.forEach((item) => {
          item.classList.toggle(
            "active",
            parseInt(item.dataset.trackIndex, 10) === index,
          );
        });

        currentTrackIndex = index;
        const track = tracks[index];

        trackName.textContent = track.title[currentLang] || track.title.en;
        timeCurrent.textContent = "0:00";
        timeTotal.textContent = track.duration || "0:00";
        progressFill.style.width = "0%";

        let audioSources = [];
        if (/\.(mp3|ogg|wav)$/i.test(track.filename)) {
          audioSources = [`/audio/${audioFolder}/${track.filename}`];
        } else {
          audioSources = [
            `/audio/${audioFolder}/${track.filename}.ogg`,
            `/audio/${audioFolder}/${track.filename}.mp3`,
            `/audio/${audioFolder}/${track.filename}.wav`,
          ];
        }

        sound = new Howl({
          src: audioSources,
          preload: "metadata",
          volume: config.defaultVolume,
          onplay: () => {
            isPlaying = true;
            playIcon.style.display = "none";
            pauseIcon.style.display = "block";
            playBtn.classList.add("playing");
            requestAnimationFrame(updateProgress);
          },
          onpause: () => {
            isPlaying = false;
            playIcon.style.display = "block";
            pauseIcon.style.display = "none";
            playBtn.classList.remove("playing");
          },
          onend: () => {
            isPlaying = false;
            playIcon.style.display = "block";
            pauseIcon.style.display = "none";
            playBtn.classList.remove("playing");

            if (currentTrackIndex < tracks.length - 1) {
              loadTrack(currentTrackIndex + 1);
              sound?.play();
            }
          },
          onload: () => {
            const duration = sound?.duration() || 0;
            timeTotal.textContent = formatTime(duration);
          },
        });
      }

      function updateProgress() {
        if (!sound || !isPlaying) return;

        const seek = sound.seek();
        const duration = sound.duration();
        const progress = (seek / duration) * 100;

        progressFill.style.width = `${progress}%`;
        timeCurrent.textContent = formatTime(seek);

        if (isPlaying) {
          requestAnimationFrame(updateProgress);
        }
      }

      playBtn?.addEventListener("click", () => {
        if (!sound) {
          loadTrack(0);
        }

        if (isPlaying) {
          sound?.pause();
        } else {
          sound?.play();
        }
      });

      prevBtn?.addEventListener("click", () => {
        const newIndex =
          currentTrackIndex > 0 ? currentTrackIndex - 1 : tracks.length - 1;
        loadTrack(newIndex);
        sound?.play();
      });

      nextBtn?.addEventListener("click", () => {
        const newIndex =
          currentTrackIndex < tracks.length - 1 ? currentTrackIndex + 1 : 0;
        loadTrack(newIndex);
        sound?.play();
      });

      progressBar?.addEventListener("click", (e) => {
        if (!sound) return;
        const rect = progressBar.getBoundingClientRect();
        const percent = (e.clientX - rect.left) / rect.width;
        const seek = percent * sound.duration();
        sound.seek(seek);
        progressFill.style.width = `${percent * 100}%`;
        timeCurrent.textContent = formatTime(seek);
      });

      // Tracklist Click Handlers
      trackItems.forEach((item) => {
        item.addEventListener("click", () => {
          const index = parseInt(item.dataset.trackIndex, 10);
          if (!isNaN(index)) {
            if (index === currentTrackIndex && sound) {
              if (isPlaying) {
                sound.pause();
              } else {
                sound.play();
              }
              return;
            }
            loadTrack(index);
            sound?.play();
          }
        });
      });

      if (tracks.length > 0) {
        loadTrack(0);
      }
    });
  }

  function initSamplerCards() {
    const samplerCards = document.querySelectorAll(".sampler-card");

    samplerCards.forEach((card) => {
      if (card.dataset.samplerReady === "true") return;
      card.dataset.samplerReady = "true";

      const folder = (card.dataset.samplerFolder || "").replace(/\/$/, "");

      let samplePool = [];
      try {
        samplePool = JSON.parse(card.dataset.samplerPool || "[]");
      } catch {
        samplePool = [];
      }

      const pads = Array.from(card.querySelectorAll(".sampler-pad"));
      const regenerateBtn = card.querySelector(".sampler-regenerate-btn");
      const activeSounds = new Map();
      const baseConfig = resolveConfig();

      function setPadIcon(pad, isPlaying) {
        if (isPlaying) {
          pad.classList.add("is-playing");
        } else {
          pad.classList.remove("is-playing");
        }
      }

      function assignPads() {
        if (!samplePool.length) {
          pads.forEach((pad, idx) => {
            pad.dataset.sample = "";
            pad.disabled = true;
            pad.classList.remove("sampler-pad--active");
            setPadIcon(pad, false);
          });
          regenerateBtn?.setAttribute("disabled", "");
          return;
        }
        regenerateBtn?.removeAttribute("disabled");
        const available = [...samplePool];
        pads.forEach((pad, idx) => {
          if (!available.length) {
            available.push(...samplePool);
          }
          const choiceIndex = Math.floor(Math.random() * available.length);
          const sample = available.splice(choiceIndex, 1)[0];
          pad.dataset.sample = sample || "";
          pad.disabled = !sample;
          pad.classList.remove("sampler-pad--active");
          setPadIcon(pad, false);
        });
      }

      function stopPadSound(pad, force = false) {
        const sound = activeSounds.get(pad);
        if (sound) {
          try {
            sound.stop();
          } catch {}
          activeSounds.delete(pad);
        }
        if (!force) {
          pad.classList.remove("sampler-pad--active");
          setPadIcon(pad, false);
        }
      }

      function stopAll(force = false) {
        pads.forEach((pad) => stopPadSound(pad, force));
      }

      function playSample(pad) {
        const sample = pad.dataset.sample;
        if (!sample) return;
        stopPadSound(pad);

        // Check for volume override
        const storedVol = card.getAttribute("data-volume");
        const volOverride =
          storedVol !== null && storedVol !== "" ? parseFloat(storedVol) : NaN;
        const finalVol = !isNaN(volOverride)
          ? volOverride
          : baseConfig.defaultVolume;

        const url = encodeURI(`/audio/${folder}/${sample}`);
        try {
          const sound = new Howl({
            src: [url],
            volume: finalVol,
            html5: false,
          });
          activeSounds.set(pad, sound);
          pad.classList.add("sampler-pad--active");
          setPadIcon(pad, true);
          sound.play();
          sound.on("end", () => {
            stopPadSound(pad);
            setPadIcon(pad, false);
          });
          sound.on("stop", () => {
            stopPadSound(pad);
            setPadIcon(pad, false);
          });
        } catch (err) {
          console.warn("Failed to play sample", sample, err);
        }
      }

      pads.forEach((pad) => {
        pad.addEventListener("click", () => playSample(pad));
      });

      function flashPads() {
        pads.forEach((pad) => {
          pad.classList.add("sampler-pad--loading");
          setTimeout(() => pad.classList.remove("sampler-pad--loading"), 520);
        });
      }

      regenerateBtn?.addEventListener("click", () => {
        stopAll();
        // Clear pads immediately to show "loading" state
        pads.forEach((pad) => {
          pad.dataset.sample = "";
          pad.disabled = true;
          setPadIcon(pad, false);
        });

        flashPads();

        try {
          regenerateBtn.classList.add("rotating");
          setTimeout(() => regenerateBtn.classList.remove("rotating"), 620);
        } catch {}

        // Delay assignment to match animation
        setTimeout(() => {
          assignPads();
        }, 500);
      });

      assignPads();

      card.__samplerController = {
        stopAll,
      };
    });
  }

  function bootstrapAudioPlayer() {
    const initialize = () => {
      initAudioPlayers();
      initSamplerCards();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initialize, { once: true });
    } else {
      initialize();
    }

    document.addEventListener("astro:page-load", () => {
      fadeOutAllControllers({ force: true });
      initAudioPlayers();
      initSamplerCards();
    });

    if (!window.__bentoAudioShutdownHooked) {
      const shutdown = (force = false) => fadeOutAllControllers({ force });
      window.addEventListener("bento:audio:shutdown", (event) =>
        shutdown(!!event.detail?.force),
      );
      window.addEventListener("beforeunload", () => shutdown(true));
      window.addEventListener("pagehide", () => shutdown(true));
      window.__bentoAudioShutdownHooked = true;
    }
  }

  if (typeof window !== "undefined") {
    if (!window.__bentoAudioPlayerBootstrapped) {
      window.__bentoAudioPlayerBootstrapped = true;
      bootstrapAudioPlayer();
    } else {
      // Refresh audio cards if new instances were added dynamically
      initAudioPlayers();
    }
  }
</script>

<script is:inline define:vars={{ FMOD_GAME_UI: fmodGameUi }}>
  // FMOD Web API Integration

  function formatFmodText(template, vars = {}) {
    return String(template || "").replace(/\{(\w+)\}/g, (_, key) =>
      vars[key] !== undefined ? vars[key] : "",
    );
  }

  function initFmodCards() {
    const fmodCards = document.querySelectorAll(".fmod-card");
    if (fmodCards.length === 0) return;

    if (!window.FMOD) {
      window.FMOD = {};
    }

    // Lazy load FMOD only when an FMOD card becomes visible.
    // This prevents the FMOD engine from allocating 64+MB and stealing
    // the AudioContext on pages that don't need it (like Chromestesia).
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const card = entry.target;
          observer.unobserve(card); // Only init once per card

          if (card.dataset.fmodReady === "true") return;
          card.dataset.fmodReady = "true";

          const statusBadge = card.querySelector(".fmod-status");
          const controlsSummary = card.querySelector(".fmod-controls-summary");
          const paramSliders = card.querySelectorAll(".fmod-slider");
          const paramValues = card.querySelectorAll(".fmod-param-value");
          const eventRows = card.querySelectorAll(".fmod-event-row");

          const folder = card.dataset.fmodFolder || "";
          const banks = JSON.parse(card.dataset.fmodBanks || "[]");
          const paramDefs = JSON.parse(card.dataset.fmodParameters || "[]");
          const bankVersion = card.dataset.fmodBankVersion || "";

          let studioSystem = null;
          let coreSystem = null;
          let eventInstances = new Map();
          let isInitialized = false;
          let gameModeCleanup = null;

          function updateStatus(state, msg) {
            if (statusBadge) {
              statusBadge.className = `fmod-status badge-${state}`;
              statusBadge.textContent = msg;
            }
            if (controlsSummary) {
              controlsSummary.textContent = msg;
            }
          }

          updateStatus("initializing", FMOD_GAME_UI.status.loading);

          // 1. Initialize FMOD Module and File System
          function prerun() {
            console.log("FMOD PreRun");
            let baseUrl = `/fmod/${folder}/`;
            if (folder === "") baseUrl = `/fmod/`;

            banks.forEach((bankFile) => {
              const url = `${baseUrl}${bankFile}`;
              const versionedUrl = bankVersion
                ? `${url}?v=${encodeURIComponent(bankVersion)}`
                : url;
              const path = `/${bankFile}`;
              console.log(`Preloading bank: ${versionedUrl} to ${path}`);
              window.FMOD.FS_createPreloadedFile(
                "/",
                bankFile,
                versionedUrl,
                true,
                false,
              );
            });
          }

          function main() {
            console.log("FMOD Main: Engine Ready");

            // Create Studio System
            let outval = {};
            let result = window.FMOD.Studio_System_Create(outval);
            if (result !== window.FMOD.OK) {
              console.error("FMOD Studio System Create error", result);
              updateStatus("error", FMOD_GAME_UI.status.errorAudio);
              return;
            }
            studioSystem = outval.val;

            // Get Core System payload
            result = studioSystem.getCoreSystem(outval);
            if (result !== window.FMOD.OK) {
              console.error("FMOD Core System Get error", result);
              return;
            }
            coreSystem = outval.val;

            // Ensure web audio starts up successfully via resume
            try {
              // Need to interact/resume the audiocontext on modern browsers
              const audioContext = coreSystem.getDriverInfo(
                0,
                null,
                null,
                outval,
                null,
                null,
              );
            } catch (e) {}

            // Initialize Studio System
            result = studioSystem.initialize(
              1024,
              window.FMOD.STUDIO_INIT_NORMAL,
              window.FMOD.INIT_NORMAL,
              null,
            );
            if (result !== window.FMOD.OK) {
              console.error("FMOD Studio Init error", result);
              updateStatus("error", FMOD_GAME_UI.status.errorInit);
              return;
            }

            // Load Banks
            banks.forEach((bankFile) => {
              result = studioSystem.loadBankFile(
                `/${bankFile}`,
                window.FMOD.STUDIO_LOAD_BANK_NORMAL,
                outval,
              );
              if (result !== window.FMOD.OK) {
                console.error(`Error loading bank ${bankFile}:`, result);
              } else {
                console.log(`Successfully loaded ${bankFile}`);
              }
            });

            isInitialized = true;
            updateStatus("ready", FMOD_GAME_UI.status.ready);
            enableControls();

            // Start engine update loop
            window.requestAnimationFrame(updateFmod);
          }

          function updateFmod() {
            if (studioSystem && isInitialized) {
              studioSystem.update();
            }
            window.requestAnimationFrame(updateFmod);
          }

          function shutdownFmod() {
            if (typeof gameModeCleanup === "function") {
              try {
                gameModeCleanup();
              } catch {}
              gameModeCleanup = null;
            }

            if (!isInitialized || !studioSystem) return;

            // Stop all instances
            eventInstances.forEach((instance) => {
              instance.stop(FMOD.STUDIO_STOP_IMMEDIATE);
              instance.release();
            });
            eventInstances.clear();

            // Release system
            studioSystem.release();
            studioSystem = null;
            coreSystem = null;
            isInitialized = false;
            console.log("FMOD Shutdown Complete");
          }

          // Bind to unmount/navigate events
          window.addEventListener("bento:audio:shutdown", () => shutdownFmod());
          window.addEventListener("beforeunload", () => shutdownFmod());
          window.addEventListener("pagehide", () => shutdownFmod());

          function enableControls() {
            // Check if this is game mode
            const isGameMode = card.classList.contains("fmod-game-mode");
            
            if (isGameMode) {
              enableGameModeControls();
            } else {
              enableStandardControls();
            }
          }
          
          function enableStandardControls() {
            // Param Sliders
            paramSliders.forEach((slider) => {
              slider.removeAttribute("disabled");
              slider.addEventListener("input", (e) => {
                const val = parseFloat(e.target.value);
                const paramName = e.target.dataset.paramName;

                // Update UI
                const valDisplay = document.getElementById(
                  `fmod-val-${paramName}`,
                );
                if (valDisplay) valDisplay.textContent = val;

                // Apply to both global system AND active event instances (local params)
                // ignoreSeekSpeed=true ensures discrete params respond immediately
                if (studioSystem && isInitialized) {
                  studioSystem.setParameterByName(paramName, val, true);
                  eventInstances.forEach((instance) => {
                    try {
                      instance.setParameterByName(paramName, val, true);
                    } catch {}
                  });
                }
              });
            });

            // Event Play/Stop buttons
            eventRows.forEach((row) => {
              const playBtn = row.querySelector(".play-btn");
              const stopBtn = row.querySelector(".stop-btn");
              const eventPath = row.dataset.eventPath;

              playBtn.removeAttribute("disabled");

              playBtn.addEventListener("click", () => {
                if (!studioSystem || !isInitialized) return;

                // Check if already created/playing
                let instance = eventInstances.get(eventPath);

                if (!instance) {
                  let outval = {};
                  let result = studioSystem.getEvent(eventPath, outval);
                  if (result !== FMOD.OK) {
                    console.error("GetEvent Error:", result);
                    return;
                  }
                  let eventDesc = outval.val;

                  result = eventDesc.createInstance(outval);
                  if (result !== FMOD.OK) {
                    console.error("CreateInstance Error:", result);
                    return;
                  }
                  instance = outval.val;
                  eventInstances.set(eventPath, instance);
                }

                // Apply current slider values before starting
                paramSliders.forEach((slider) => {
                  const pName = slider.dataset.paramName;
                  const pVal = parseFloat(slider.value);
                  studioSystem.setParameterByName(pName, pVal, false); // Assuming global for now. For local: instance.setParameterByName
                });

                instance.start();
                stopBtn.removeAttribute("disabled");
                playBtn.setAttribute("disabled", "true");
              });

              stopBtn.addEventListener("click", () => {
                const instance = eventInstances.get(eventPath);
                if (instance) {
                  instance.stop(FMOD.STUDIO_STOP_ALLOWFADEOUT);
                }
                stopBtn.setAttribute("disabled", "true");
                playBtn.removeAttribute("disabled");
              });
            });
          }
          
          function enableGameModeControls() {
            const phaseIndicator = card.querySelector(".fmod-phase-copy");
            const phaseLabel = phaseIndicator?.querySelector(".phase-label");
            const phaseDescription = phaseIndicator?.querySelector(".phase-description");
            const sceneWrapper = card.querySelector(".fmod-scene");
            const stageBoss = card.querySelector(".fmod-stage .fmod-boss-container");
            const bossHud = card.querySelector(".fmod-stage-boss-hud");
            const playerHud = card.querySelector(".fmod-stage-player-hud");
            const controlsPanel = card.querySelector(".fmod-controls-panel");
            const controlsSummary = controlsPanel?.querySelector(".fmod-controls-summary");
            const bossHealthFill = bossHud?.querySelector(".health-fill");
            const bossHealthValue = bossHud?.querySelector(".health-value-display");
            const playerHealthFill = playerHud?.querySelector(".health-fill");
            const playerHealthValue = playerHud?.querySelector(".health-value-display");
            const playerKillBtn = playerHud?.querySelector(".fmod-player-kill-btn");
            const actionBtns = controlsPanel?.querySelectorAll(".fmod-action-btn") || [];
            const attackBtn = controlsPanel?.querySelector(".attack-btn");
            const specialBtn = controlsPanel?.querySelector(".special-btn");
            const playBtn = card.querySelector(".fmod-header-actions .play-btn");
            const playBtnLabel = playBtn?.querySelector(".ctrl-label");
            const hiddenSliders = card.querySelectorAll(".fmod-hidden-params input");
            const introDuration =
              Number.parseFloat(card.dataset.fmodIntroDuration || "0") || 0;
            const prefersReducedMotion =
              window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches ?? false;
            const mobParamName = "is_mobKilled";
            const regionParamName = "region";
            const bossRevealDelayMs = 14000;
            const bossRevealDurationMs = 4000;
            const phaseDescriptions = {
              waiting: FMOD_GAME_UI.phaseDescriptions.waiting,
              stopped: FMOD_GAME_UI.phaseDescriptions.stopped,
              intro: (seconds) =>
                formatFmodText(FMOD_GAME_UI.status.intro, { seconds }),
            };
            const flashMobActionStates = {
              INACTIVE: "inactive",
              PURGE_READY: "purge_ready",
              PURGED_LOCKED: "purged_locked",
            };
            const regionStates = {
              0: {
                phase: "bossphase",
                label: FMOD_GAME_UI.phaseLabels.bossphase,
                description: FMOD_GAME_UI.phaseDescriptions.bossphase,
              },
              1: {
                phase: "flashmob",
                label: FMOD_GAME_UI.phaseLabels.flashmob,
                description: FMOD_GAME_UI.phaseDescriptions.flashmob,
              },
              2: {
                phase: "special",
                label: FMOD_GAME_UI.phaseLabels.special,
                description: FMOD_GAME_UI.phaseDescriptions.special,
              },
            };
            let introTimer = null;
            let introCountdown = 0;
            let fmodPoller = null;
            let bossIntroDelayTimer = null;
            let bossIntroFinalizeTimer = null;
            let bossValueAnimationFrame = null;
            let bossHudState = "pending";
            let launchState = card.dataset.launchState || "loading";
            const eventParameterIds = new WeakMap();
            const primaryControlBtns = Array.from(actionBtns);

            function updateControlsSummary(message = FMOD_GAME_UI.status.idle) {
              if (controlsSummary) controlsSummary.textContent = message;
            }

            function updateActionLockOverlays() {
              actionBtns.forEach((btn) => {
                const overlay = btn.querySelector(".btn-lock-overlay");
                const label = overlay?.querySelector(".btn-lock-label");
                const value = overlay?.querySelector(".btn-lock-value");

                if (!overlay || !label || !value) return;

                if (gameState.isPlaying && introCountdown > 0) {
                  overlay.dataset.lockState = "countdown";
                  label.textContent = FMOD_GAME_UI.phaseLabels.intro;
                  value.textContent = `${introCountdown}s`;
                  return;
                }

                overlay.dataset.lockState = "locked";
                label.textContent = FMOD_GAME_UI.controls.locked;
                value.textContent = "";
              });
            }

            function setLaunchState(nextState) {
              launchState = nextState;
              card.dataset.launchState = nextState;

              if (playBtn) {
                if (nextState === "loading") {
                  playBtn.setAttribute("disabled", "true");
                  playBtn.setAttribute("aria-busy", "true");
                } else {
                  playBtn.removeAttribute("disabled");
                  playBtn.setAttribute("aria-busy", "false");
                }
              }
            }

            function setPlayButtonState(state) {
              if (!playBtn) return;

              playBtn.classList.toggle("is-running", state === "running");

              if (playBtnLabel) {
                playBtnLabel.textContent =
                  state === "running"
                    ? FMOD_GAME_UI.controls.stop
                    : FMOD_GAME_UI.controls.start;
              }

              playBtn.setAttribute(
                "aria-pressed",
                state === "running" ? "true" : "false",
              );
            }

            function createInitialGameState() {
              return {
                bossHealth: 100,
                playerHealth: 100,
                region: 0,
                isMobKilled: 1,
                flashMobActionState: flashMobActionStates.INACTIVE,
                isSpecial: 0,
                isPlaying: false,
              };
            }

            let gameState = createInitialGameState();

            function setStatus(message) {
              updateControlsSummary(message);
            }

            function setPhaseState(phase, label, description = "") {
              if (phaseIndicator) phaseIndicator.dataset.phase = phase;
              if (phaseLabel) phaseLabel.textContent = label;
              if (phaseDescription) phaseDescription.textContent = description;
            }

            function syncSceneState() {
              if (!sceneWrapper) return;
              sceneWrapper.classList.toggle("is-playing", gameState.isPlaying);
              sceneWrapper.classList.toggle(
                "swarm-active",
                gameState.isPlaying &&
                  gameState.flashMobActionState === flashMobActionStates.PURGE_READY,
              );
              sceneWrapper.classList.toggle(
                "special-active",
                gameState.isPlaying && gameState.isSpecial === 1,
              );
            }

            function setBossHudState(nextState) {
              bossHudState = nextState;
              if (bossHud) {
                bossHud.dataset.reveal = nextState;
              }
            }

            function clearBossIntroAnimation(options = {}) {
              const { reset = false } = options;

              if (bossIntroDelayTimer) {
                window.clearTimeout(bossIntroDelayTimer);
                bossIntroDelayTimer = null;
              }
              if (bossIntroFinalizeTimer) {
                window.clearTimeout(bossIntroFinalizeTimer);
                bossIntroFinalizeTimer = null;
              }
              if (bossValueAnimationFrame) {
                window.cancelAnimationFrame(bossValueAnimationFrame);
                bossValueAnimationFrame = null;
              }

              if (!bossHealthFill) return;

              bossHealthFill.classList.remove("is-intro-filling");

              if (reset) {
                setBossHudState("pending");
                bossHealthFill.style.removeProperty("--boss-intro-duration");
                bossHealthFill.style.width = "0%";
                if (bossHealthValue) bossHealthValue.textContent = "0%";
              }
            }

            function animateBossValue(targetValue, duration) {
              if (!bossHealthValue || prefersReducedMotion) {
                if (bossHealthValue) bossHealthValue.textContent = `${targetValue}%`;
                return;
              }

              const startTime = window.performance.now();
              bossHealthValue.textContent = "0%";

              const frame = (now) => {
                const progress = Math.min((now - startTime) / duration, 1);
                const easedProgress = 1 - Math.pow(1 - progress, 3);
                bossHealthValue.textContent = `${Math.round(targetValue * easedProgress)}%`;

                if (progress < 1) {
                  bossValueAnimationFrame = window.requestAnimationFrame(frame);
                  return;
                }

                bossValueAnimationFrame = null;
                bossHealthValue.textContent = `${targetValue}%`;
              };

              bossValueAnimationFrame = window.requestAnimationFrame(frame);
            }

            function animateBossIntroFill(targetValue) {
              if (!bossHealthFill) return;

              clearBossIntroAnimation();
              setBossHudState("filling");

              const introDurationMs = prefersReducedMotion ? 80 : bossRevealDurationMs;
              bossHealthFill.classList.remove("is-intro-filling");
              bossHealthFill.style.width = "0%";
              bossHealthFill.style.setProperty(
                "--boss-intro-duration",
                `${introDurationMs}ms`,
              );
              bossHealthFill.getBoundingClientRect();

              animateBossValue(targetValue, introDurationMs);

              window.requestAnimationFrame(() => {
                bossHealthFill.classList.add("is-intro-filling");
                bossHealthFill.style.width = `${targetValue}%`;
              });

              bossIntroFinalizeTimer = window.setTimeout(() => {
                bossHealthFill.classList.remove("is-intro-filling");
                setBossHudState("live");
                bossHealthFill.style.width = `${gameState.bossHealth}%`;
                if (bossHealthValue) {
                  bossHealthValue.textContent = `${gameState.bossHealth}%`;
                }
                bossIntroFinalizeTimer = null;
              }, introDurationMs + 80);
            }

            function scheduleBossIntroFill() {
              clearBossIntroAnimation({ reset: true });
              if (!gameState.isPlaying) return;

              bossIntroDelayTimer = window.setTimeout(() => {
                bossIntroDelayTimer = null;
                if (!gameState.isPlaying) return;
                animateBossIntroFill(gameState.bossHealth);
              }, bossRevealDelayMs);
            }

            function setFlashMobActionState(nextState, options = {}) {
              const { statusMessage = "", syncMobParam = false } = options;
              const nextMobKilled =
                nextState === flashMobActionStates.PURGE_READY ? 0 : 1;
              const stateChanged =
                gameState.flashMobActionState !== nextState ||
                gameState.isMobKilled !== nextMobKilled;

              gameState.flashMobActionState = nextState;
              gameState.isMobKilled = nextMobKilled;

              if (syncMobParam) {
                applyParameterToSystemAndInstances(mobParamName, nextMobKilled);
              }

              syncSceneState();
              updateToggleButtons();
              syncLivePhaseState();

              if (statusMessage && stateChanged) {
                setStatus(statusMessage);
              }
            }

            function enterFlashMobRegion(
              statusMessage = FMOD_GAME_UI.status.flashmobReady,
            ) {
              if (!gameState.isPlaying) return;
              setFlashMobActionState(flashMobActionStates.PURGE_READY, {
                statusMessage,
                syncMobParam: true,
              });
            }

            function lockFlashMobAfterPurge(
              statusMessage = FMOD_GAME_UI.status.flashmobLocked,
            ) {
              if (!gameState.isPlaying) return;
              setFlashMobActionState(flashMobActionStates.PURGED_LOCKED, {
                statusMessage,
                syncMobParam: true,
              });
            }

            function exitFlashMobRegion(
              statusMessage = FMOD_GAME_UI.status.flashmobEnded,
            ) {
              setFlashMobActionState(flashMobActionStates.INACTIVE, {
                statusMessage,
                syncMobParam: true,
              });
            }

            function getRegionState(regionValue) {
              const normalizedRegion = Math.round(regionValue);
              return regionStates[normalizedRegion] || regionStates[0];
            }

            function cacheTrackedParameterIds(instance, eventPath) {
              if (!instance || !eventPath || !studioSystem || !isInitialized) {
                return;
              }

              const outval = {};
              const result = studioSystem.getEvent(eventPath, outval);
              if (result !== FMOD.OK) return;

              const eventDescription = outval.val;
              if (
                !eventDescription ||
                typeof eventDescription.getParameterDescriptionByName !== "function"
              ) {
                return;
              }

              const parameterIds = {};
              [
                ["region", regionParamName],
                ["mob", mobParamName],
                ["special", "isSpecial"],
              ].forEach(([key, paramName]) => {
                try {
                  const parameterDescription = {};
                  const descriptionResult =
                    eventDescription.getParameterDescriptionByName(
                      paramName,
                      parameterDescription,
                    );

                  if (descriptionResult === FMOD.OK && parameterDescription.id) {
                    parameterIds[key] = parameterDescription.id;
                  }
                } catch {}
              });

              eventParameterIds.set(instance, parameterIds);
            }

            function readTrackedParameterValue(
              instance,
              key,
              paramName,
              options = {},
            ) {
              const { preferFinal = false } = options;
              const parameterIds = eventParameterIds.get(instance) || {};
              const current = {};
              const final = {};
              let result = null;

              if (
                parameterIds[key] &&
                typeof instance?.getParameterByID === "function"
              ) {
                try {
                  result = instance.getParameterByID(
                    parameterIds[key],
                    current,
                    final,
                  );
                } catch {}
              }

              if (
                result !== FMOD.OK &&
                typeof instance?.getParameterByName === "function"
              ) {
                try {
                  result = instance.getParameterByName(
                    paramName,
                    current,
                    final,
                  );
                } catch {}
              }

              if (
                result !== FMOD.OK &&
                studioSystem &&
                typeof studioSystem.getParameterByName === "function"
              ) {
                try {
                  result = studioSystem.getParameterByName(
                    paramName,
                    current,
                    final,
                  );
                } catch {}
              }

              if (result !== FMOD.OK) return null;

              const liveValue = preferFinal
                ? final.val !== undefined
                  ? final.val
                  : current.val
                : current.val !== undefined
                  ? current.val
                  : final.val;
              if (liveValue === undefined) return null;

              return Math.round(liveValue);
            }

            function syncLivePhaseState() {
              if (!gameState.isPlaying) return;

              if (introCountdown > 0) {
                setPhaseState(
                  "intro",
                  FMOD_GAME_UI.phaseLabels.intro,
                  phaseDescriptions.intro(introCountdown),
                );
                return;
              }

              const regionState = getRegionState(gameState.region);
              setPhaseState(
                regionState.phase,
                regionState.label,
                regionState.description,
              );
            }

            function applyParameterToSystemAndInstances(paramName, value) {
              if (!studioSystem || !isInitialized) return;

              studioSystem.setParameterByName(paramName, value, true);
              eventInstances.forEach((instance) => {
                try {
                  instance.setParameterByName(paramName, value, true);
                } catch {}
              });
            }

            function stopIntroCountdown() {
              if (introTimer) {
                window.clearInterval(introTimer);
                introTimer = null;
              }
              introCountdown = 0;
              updateActionLockOverlays();
            }

            function stopFmodPolling() {
              if (fmodPoller) {
                window.clearInterval(fmodPoller);
                fmodPoller = null;
              }
            }

            function startFmodPolling(instance) {
              stopFmodPolling();

              fmodPoller = window.setInterval(() => {
                if (!gameState.isPlaying || !instance || !studioSystem || !isInitialized) {
                  return;
                }

                const nextRegion = readTrackedParameterValue(
                  instance,
                  "region",
                  regionParamName,
                  { preferFinal: true },
                );
                if (nextRegion !== null && nextRegion !== gameState.region) {
                  const wasFlashMobRegion = gameState.region === 1;
                  const isFlashMobRegion = nextRegion === 1;
                  gameState.region = nextRegion;

                  if (!wasFlashMobRegion && isFlashMobRegion) {
                    enterFlashMobRegion();
                  } else if (wasFlashMobRegion && !isFlashMobRegion) {
                    exitFlashMobRegion();
                  } else {
                    syncLivePhaseState();
                  }
                }

                const nextSpecial = readTrackedParameterValue(
                  instance,
                  "special",
                  "isSpecial",
                );
                if (nextSpecial !== null && nextSpecial !== gameState.isSpecial) {
                  gameState.isSpecial = nextSpecial;
                  updateToggleButtons();
                  syncSceneState();
                  syncLivePhaseState();
                  setStatus(
                    nextSpecial === 1
                      ? FMOD_GAME_UI.status.specialOn
                      : gameState.flashMobActionState ===
                            flashMobActionStates.PURGE_READY
                        ? FMOD_GAME_UI.status.flashmobReady
                        : gameState.flashMobActionState ===
                              flashMobActionStates.PURGED_LOCKED
                          ? FMOD_GAME_UI.status.flashmobLocked
                          : FMOD_GAME_UI.status.specialOff,
                  );
                }
              }, 200);
            }

            function startIntroCountdown() {
              stopIntroCountdown();

              if (introDuration <= 0) {
                setButtonStates(true);
                updateToggleButtons();
                syncLivePhaseState();
                setStatus(FMOD_GAME_UI.status.live);
                updateControlsSummary(FMOD_GAME_UI.status.live);
                return;
              }

              introCountdown = Math.max(1, Math.ceil(introDuration));
              setButtonStates(false);
              syncLivePhaseState();
              setStatus(
                formatFmodText(FMOD_GAME_UI.status.intro, {
                  seconds: introCountdown,
                }),
              );

              introTimer = window.setInterval(() => {
                if (!gameState.isPlaying) {
                  stopIntroCountdown();
                  return;
                }

                introCountdown = Math.max(0, introCountdown - 1);

                if (introCountdown > 0) {
                  syncLivePhaseState();
                  setStatus(
                    formatFmodText(FMOD_GAME_UI.status.intro, {
                      seconds: introCountdown,
                    }),
                  );
                  updateActionLockOverlays();
                  return;
                }

                stopIntroCountdown();
                setButtonStates(true);
                updateToggleButtons();
                syncLivePhaseState();
                setStatus(FMOD_GAME_UI.status.live);
                updateControlsSummary(FMOD_GAME_UI.status.live);
              }, 1000);
            }

            gameModeCleanup = () => {
              stopIntroCountdown();
              stopFmodPolling();
              clearBossIntroAnimation({ reset: true });
              gameState = createInitialGameState();
              setBossHudState("live");
              updateHealthBars();
              updateToggleButtons();
              syncSceneState();
              setButtonStates(false);
              setPlayButtonState("ready");
              setLaunchState("gated");
              setStatus(FMOD_GAME_UI.status.idle);
              setPhaseState(
                "waiting",
                FMOD_GAME_UI.phaseLabels.waiting,
                phaseDescriptions.waiting,
              );
            };

            function updateHealthBars() {
              const bossPercent = `${gameState.bossHealth}%`;
              const playerPercent = `${gameState.playerHealth}%`;

              if (bossHudState === "live") {
                if (bossHealthFill) bossHealthFill.style.width = bossPercent;
                if (bossHealthValue) bossHealthValue.textContent = bossPercent;
              } else if (bossHudState === "pending") {
                if (bossHealthFill) bossHealthFill.style.width = "0%";
                if (bossHealthValue) bossHealthValue.textContent = "0%";
              }
              if (playerHealthFill) playerHealthFill.style.width = playerPercent;
              if (playerHealthValue) playerHealthValue.textContent = playerPercent;

              applyParameterToSystemAndInstances("BOSS_HEALTH", gameState.bossHealth);
              applyParameterToSystemAndInstances("PLAYER_HEALTH", gameState.playerHealth);

              hiddenSliders.forEach((slider) => {
                const name = slider.dataset.paramName;
                if (name === "BOSS_HEALTH") slider.value = gameState.bossHealth;
                if (name === "PLAYER_HEALTH") slider.value = gameState.playerHealth;
              });
            }

            function updateToggleButtons() {
              if (specialBtn) {
                const specialHint = specialBtn.querySelector(".btn-hint");
                specialBtn.classList.toggle("active", gameState.isSpecial === 1);
                if (specialHint) {
                  specialHint.textContent =
                    gameState.isSpecial === 1
                      ? FMOD_GAME_UI.controls.specialHintActive
                      : FMOD_GAME_UI.controls.specialHint;
                }
              }

              if (attackBtn) {
                const isFlashMobActionActive =
                  gameState.flashMobActionState !== flashMobActionStates.INACTIVE;
                const isPurgedLocked =
                  gameState.flashMobActionState === flashMobActionStates.PURGED_LOCKED;
                const attackHint = attackBtn.querySelector(".attack-visuals .btn-hint");
                const purgeHint = attackBtn.querySelector(".purge-visuals .btn-hint");

                attackBtn.classList.toggle("purge-ready", isFlashMobActionActive);
                if (attackHint) attackHint.textContent = FMOD_GAME_UI.controls.attackHint;
                if (purgeHint) purgeHint.textContent = FMOD_GAME_UI.controls.purgeHint;

                if (!gameState.isPlaying || introCountdown > 0) {
                  updateActionLockOverlays();
                  return;
                }

                if (isPurgedLocked) {
                  attackBtn.setAttribute("disabled", "true");
                } else {
                  attackBtn.removeAttribute("disabled");
                }
              }

              updateActionLockOverlays();
            }

            function setButtonStates(enabled) {
              primaryControlBtns.forEach((btn) => {
                if (enabled) {
                  btn.removeAttribute("disabled");
                } else {
                  btn.setAttribute("disabled", "true");
                }
              });
              updateActionLockOverlays();
            }

            function resetGame(options = {}) {
              const {
                stopMode = FMOD.STUDIO_STOP_ALLOWFADEOUT,
                statusMessage = FMOD_GAME_UI.status.idle,
                phase = "waiting",
                phaseLabelText = FMOD_GAME_UI.phaseLabels.waiting,
                phaseDescText = phaseDescriptions.waiting,
              } = options;

              stopIntroCountdown();
              stopFmodPolling();
              clearBossIntroAnimation({ reset: true });
              gameState = createInitialGameState();
              setBossHudState("live");

              applyParameterToSystemAndInstances("BOSS_HEALTH", 100);
              applyParameterToSystemAndInstances("PLAYER_HEALTH", 100);
              applyParameterToSystemAndInstances(mobParamName, 1);
              applyParameterToSystemAndInstances("isSpecial", 0);

              updateHealthBars();
              updateToggleButtons();
              syncSceneState();

              eventInstances.forEach((instance) => {
                try {
                  instance.stop(stopMode);
                } catch {}
              });

              setButtonStates(false);
              setPlayButtonState("ready");
              setLaunchState("gated");

              setStatus(statusMessage);
              updateControlsSummary(statusMessage);
              setPhaseState(phase, phaseLabelText, phaseDescText);
            }

            function getPrimaryEventPath() {
              return card.dataset.fmodEvents
                ? JSON.parse(card.dataset.fmodEvents)[0]?.path
                : null;
            }

            function getOrCreatePrimaryInstance(eventPath) {
              if (!eventPath || !studioSystem || !isInitialized) return null;

              let instance = eventInstances.get(eventPath);
              if (instance) return instance;

              const outval = {};
              let result = studioSystem.getEvent(eventPath, outval);
              if (result !== FMOD.OK) return null;

              const eventDesc = outval.val;
              result = eventDesc.createInstance(outval);
              if (result !== FMOD.OK) return null;

              instance = outval.val;
              eventInstances.set(eventPath, instance);
              return instance;
            }

            function startGameRun() {
              if (!studioSystem || !isInitialized) return;

              const eventPath = getPrimaryEventPath();
              if (!eventPath) return;

              const instance = getOrCreatePrimaryInstance(eventPath);
              if (!instance) return;

              stopIntroCountdown();
              stopFmodPolling();
              clearBossIntroAnimation({ reset: true });
              gameState = createInitialGameState();
              gameState.isPlaying = true;
              cacheTrackedParameterIds(instance, eventPath);

              applyParameterToSystemAndInstances("BOSS_HEALTH", 100);
              applyParameterToSystemAndInstances("PLAYER_HEALTH", 100);
              applyParameterToSystemAndInstances(mobParamName, 1);
              applyParameterToSystemAndInstances("isSpecial", 0);

              instance.start();
              startFmodPolling(instance);
              updateHealthBars();
              scheduleBossIntroFill();
              updateToggleButtons();
              syncSceneState();
              setPlayButtonState("running");
              setLaunchState("live");
              startIntroCountdown();
            }

            function stopGameRun() {
              resetGame({
                stopMode: FMOD.STUDIO_STOP_ALLOWFADEOUT,
                statusMessage: FMOD_GAME_UI.status.stopped,
                phase: "waiting",
                phaseLabelText: FMOD_GAME_UI.phaseLabels.stopped,
                phaseDescText: phaseDescriptions.stopped,
              });
            }

            function handleTransportToggle() {
              if (gameState.isPlaying) {
                stopGameRun();
                return;
              }

              if (launchState === "loading") return;
              startGameRun();
            }

            actionBtns.forEach((btn) => {
              btn.addEventListener("click", () => {
                const action = btn.dataset.action;

                switch (action) {
                  case "attack":
                    if (
                      gameState.flashMobActionState ===
                      flashMobActionStates.PURGED_LOCKED
                    ) {
                      setStatus(FMOD_GAME_UI.status.alreadyPurged);
                      break;
                    }

                    if (
                      gameState.flashMobActionState ===
                      flashMobActionStates.PURGE_READY
                    ) {
                      lockFlashMobAfterPurge();
                      break;
                    }

                    gameState.bossHealth = Math.max(0, gameState.bossHealth - 40);
                    updateHealthBars();
                    updateToggleButtons();
                    syncLivePhaseState();

                    if (stageBoss) {
                      stageBoss.classList.add("damage-flash");
                      window.setTimeout(
                        () => stageBoss.classList.remove("damage-flash"),
                        260,
                      );
                    }

                    setStatus(
                      formatFmodText(FMOD_GAME_UI.status.attack, {
                        value: gameState.bossHealth,
                      }),
                    );
                    if (attackBtn) {
                      attackBtn.classList.add("pulse-damage");
                      window.setTimeout(
                        () => attackBtn.classList.remove("pulse-damage"),
                        150,
                      );
                    }
                    break;

                  case "special":
                    gameState.isSpecial = gameState.isSpecial === 0 ? 1 : 0;
                    applyParameterToSystemAndInstances("isSpecial", gameState.isSpecial);
                    updateToggleButtons();
                    syncSceneState();
                    syncLivePhaseState();
                    setStatus(
                      gameState.isSpecial === 1
                        ? FMOD_GAME_UI.status.specialOn
                        : FMOD_GAME_UI.status.specialOff,
                    );
                    break;
                }
              });
            });

            if (playerKillBtn) {
              playerKillBtn.addEventListener("click", () => {
                gameState.playerHealth = 0;
                updateHealthBars();
                updateToggleButtons();
                syncLivePhaseState();
                setStatus(FMOD_GAME_UI.status.playerDown);
              });
            }

            setPlayButtonState("ready");
            playBtn?.addEventListener("click", handleTransportToggle);

            setButtonStates(false);
            clearBossIntroAnimation({ reset: true });
            setBossHudState("live");
            updateHealthBars();
            updateToggleButtons();
            syncSceneState();
            setLaunchState("gated");
            setStatus(FMOD_GAME_UI.status.idle);
            updateControlsSummary(FMOD_GAME_UI.status.idle);
            setPhaseState(
              "waiting",
              FMOD_GAME_UI.phaseLabels.waiting,
              phaseDescriptions.waiting,
            );
          }
          // Load WASM Engine
          // Load WASM Engine
          if (!window.document.getElementById("fmod-engine-script")) {
            // We must define locateFile because dynamic injection loses document.currentScript,
            // causing the AudioWorklet to fetch .wasm from the root resulting in a 404/AbortError.
            window.FMOD.locateFile = function (path, prefix) {
              if (
                path.endsWith(".wasm") ||
                (path.endsWith(".js") && !path.endsWith(".aw.js"))
              ) {
                return "/fmod/api/" + path;
              }
              return prefix + path;
            };

            window.FMOD.preRun = prerun;
            window.FMOD.onRuntimeInitialized = main;
            window.FMOD.INITIAL_MEMORY = 64 * 1024 * 1024; // 64MB

            const script = document.createElement("script");
            script.id = "fmod-engine-script";
            script.src = "/fmod/api/fmodstudio.js";
            script.onload = () => {
              if (typeof FMODModule === "function") {
                FMODModule(window.FMOD);
              }
            };
            script.onerror = () =>
              updateStatus("error", FMOD_GAME_UI.status.apiMissing);
            document.body.appendChild(script);
          } else {
            // Already loaded globally, just run local init logic if it hasn't fired yet
            if (!isInitialized) {
              prerun();
              setTimeout(main, 500); // Give it a slight delay to ensure C++ memory is ready if it was *just* loaded
            }
          }
        } // Close if (entry.isIntersecting)
      }); // Close entries.forEach
    }); // Close new IntersectionObserver

    // Start observing FMOD cards
    fmodCards.forEach((card) => observer.observe(card));
  }

  // Auto-init on page load
  document.addEventListener("DOMContentLoaded", initFmodCards);
  document.addEventListener("astro:page-load", initFmodCards);
</script>
