  .fmod-card.fmod-game-mode::before,
  .fmod-card.fmod-game-mode::after {
    content: "";
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
  }

  .fmod-card.fmod-game-mode::before {
    width: 360px;
    height: 360px;
    inset: -180px auto auto -110px;
    background: radial-gradient(circle, rgba(var(--accent-color-rgb), 0.22), transparent 68%);
    filter: blur(18px);
    opacity: 0.9;
  }

  .fmod-card.fmod-game-mode::after {
    width: 220px;
    height: 220px;
    inset: auto -60px -90px auto;
    background: radial-gradient(circle, rgba(var(--accent-color-rgb), 0.15), transparent 70%);
    filter: blur(28px);
    opacity: 0.7;
  }

  .fmod-card.fmod-game-mode > * {
    position: relative;
    z-index: 1;
  }

  .fmod-card.fmod-game-mode .fmod-game-surface {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .fmod-card.fmod-game-mode .fmod-scene {
    transform-origin: 50% 40%;
    transition:
      filter 360ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 240ms ease;
  }

  .fmod-card.fmod-game-mode[data-launch-state="loading"] .fmod-scene {
    filter: blur(10px) saturate(0.88);
    transform: scale(0.992);
    opacity: 0.72;
  }

  .fmod-card.fmod-game-mode[data-launch-state="loading"] .fmod-controls-panel {
    opacity: 0.88;
  }

  .fmod-card.fmod-game-mode .fmod-game-header {
    margin-bottom: 0;
  }

  .fmod-card.fmod-game-mode .fmod-header-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.9rem 1rem;
    align-items: end;
  }

  .fmod-card.fmod-game-mode .fmod-header-copy,
  .fmod-card.fmod-game-mode .fmod-controls-copy {
    display: flex;
    flex-direction: column;
  }

  .fmod-card.fmod-game-mode .fmod-header-copy {
    gap: 0.45rem;
    min-width: 0;
    max-width: 60ch;
  }

  .fmod-card.fmod-game-mode .fmod-card-kicker {
    align-self: flex-start;
    display: inline-flex;
    padding: 0.42rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--accent-color-rgb), 0.28);
    background: rgba(var(--accent-color-rgb), 0.12);
    color: var(--accent-color);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  html[data-theme="dark"] .fmod-card.fmod-game-mode .fmod-card-kicker {
    background: rgba(var(--accent-color-rgb), 0.18);
    border-color: rgba(var(--accent-color-rgb), 0.36);
    color: #ffffff;
  }

  .fmod-card.fmod-game-mode .fmod-card-title {
    margin: 0;
    max-width: none;
    font-size: clamp(1.75rem, 2.6vw, 2.35rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--fmod-shell-text);
    white-space: normal;
  }

  .fmod-card.fmod-game-mode .fmod-card-subtitle {
    margin: 0;
    max-width: 60ch;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--fmod-shell-muted);
