    --fmod-stage-border: rgba(15, 23, 42, 0.08);
    --fmod-stage-overlay: #0f172a;
    --fmod-stage-muted: rgba(51, 65, 85, 0.78);
    --fmod-stage-grid: rgba(15, 23, 42, 0.05);
    --fmod-stage-vignette: rgba(15, 23, 42, 0.16);
    --fmod-hud-bg:
      linear-gradient(180deg, rgba(255, 255, 255, 0.78), rgba(244, 247, 251, 0.7));
    --fmod-hud-border: rgba(15, 23, 42, 0.08);
    --fmod-health-track-boss:
      linear-gradient(180deg, rgba(73, 48, 53, 0.18), rgba(15, 23, 42, 0.1));
    --fmod-health-track-player: rgba(15, 23, 42, 0.12);
    --fmod-floor-shadow:
