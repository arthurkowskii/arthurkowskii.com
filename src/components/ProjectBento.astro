  }

  .fmod-card.fmod-game-mode .fmod-phase-copy[data-phase="flashmob"] {
    border-color: rgba(168, 85, 247, 0.34);
    background: rgba(168, 85, 247, 0.14);
    box-shadow: none;
  }

  .fmod-card.fmod-game-mode .fmod-phase-copy[data-phase="special"] {
    border-color: rgba(251, 191, 36, 0.34);
    background: rgba(251, 191, 36, 0.16);
