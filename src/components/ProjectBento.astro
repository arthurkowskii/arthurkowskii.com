    --fmod-action-bg:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(235, 241, 247, 0.94));
    --fmod-action-border: rgba(15, 23, 42, 0.12);
    --fmod-action-text: #0f172a;
    --fmod-action-muted: rgba(51, 65, 85, 0.8);
    --fmod-action-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 12px 24px rgba(15, 23, 42, 0.06);
    --fmod-action-disabled-bg:
